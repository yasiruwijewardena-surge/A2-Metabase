{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Events",
    "description": "A live session or its recording, at /events. The start date decides whether it shows as upcoming or on demand, so nothing needs flagging by hand."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "startsAt": {
      "type": "datetime",
      "required": true
    },
    "durationMinutes": {
      "type": "integer",
      "min": 1
    },
    "location": {
      "type": "string"
    },
    "registrationUrl": {
      "type": "string"
    },
    "recordingUrl": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event-category.event-category",
      "inversedBy": "events"
    },
    "guests": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::person.person"
    }
  }
}
