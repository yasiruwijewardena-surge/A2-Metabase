{
  "kind": "collectionType",
  "collectionName": "industries",
  "info": {
    "singularName": "industry",
    "pluralName": "industries",
    "displayName": "Industry",
    "description": "Controlled vocabulary for company sector; drives the case-study filter."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
