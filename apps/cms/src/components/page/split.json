{
  "collectionName": "components_page_splits",
  "info": {
    "displayName": "Split",
    "icon": "layout",
    "description": "Artwork one side, copy the other. `reverse` puts the artwork on the right; `frameTheme` is the tint behind it."
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string",
      "required": true
    },
    "lede": {
