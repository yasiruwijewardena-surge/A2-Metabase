    },
    "bullets": {
      "type": "component",
      "repeatable": true,
      "component": "page.bullet"
    },
    "media": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "mediaPoster": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "mediaLabel": {
      "type": "string"
    },
    "frameTheme": {
      "type": "enumeration",
      "enum": [
        "blue",
        "grey",
        "none"
      ],
      "default": "blue"
    },
    "caption": {
      "type": "string"
    },
    "reverse": {
      "type": "boolean",
      "default": false
    }
  }
}
