      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "mediaLabel": {
      "type": "string"
    },
    "linkLabel": {
      "type": "string"
    },
    "linkUrl": {
      "type": "string"
    },
    "centred": {
      "type": "boolean",
      "default": true
    }
  }
}
