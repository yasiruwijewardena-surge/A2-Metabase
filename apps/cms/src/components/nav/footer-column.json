{
  "collectionName": "components_nav_footer_columns",
  "info": {
    "displayName": "Footer column",
    "icon": "layout",
    "description": "A titled block of footer links. Blocks sharing a column number stack in the same column."
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "column": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 6,
      "default": 1
    },
    "links": {
      "type": "component",
      "repeatable": true,
      "component": "nav.link"
    }
  }
}
