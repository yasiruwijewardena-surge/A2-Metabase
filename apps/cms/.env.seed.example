# ---------------------------------------------------------------------------
# Credentials for seeding the Railway database from your machine.
# Copy to .env.seed and fill in. .env.seed is gitignored.
#
#   cp .env.seed.example .env.seed
#   # fill in the values below, then, with the tunnel open in another shell:
#   set -a && . ./.env.seed && set +a && npm run seed
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Preferred: an encrypted tunnel, so the database is never publicly exposed.
#
#   railway login
#   railway link --project <project id> --environment production
#   railway connect Postgres --tunnel-only      # leave running; prints a port
#
# The tunnel listens on localhost, so point DATABASE_URL at it. Credentials are
# the PGUSER / PGPASSWORD / PGDATABASE values from the Postgres service.
# TLS is off because the hop to localhost is already inside the tunnel.
DATABASE_URL=postgresql://<PGUSER>:<PGPASSWORD>@localhost:<TUNNEL PORT>/<PGDATABASE>
DATABASE_CLIENT=postgres
DATABASE_SSL=false

# Alternative, if the CLI is unavailable: Postgres -> Settings -> Networking ->
# Public Access, then use DATABASE_PUBLIC_URL with
#   DATABASE_SSL=true
#   DATABASE_SSL_REJECT_UNAUTHORIZED=false
# and remove the public access afterwards. The tunnel is preferable: no public
# host, no egress billing, nothing to remember to switch off.

# --- Cloudinary -------------------------------------------------------------
# The same three values already set on the Railway CMS service.
# Required: without them the seed writes images to your local disk and the
# production database ends up pointing at files that do not exist there.
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER=metabase-replica
