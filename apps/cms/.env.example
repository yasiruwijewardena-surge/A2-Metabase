# ---------------------------------------------------------------------------
# Strapi CMS environment
# Copy to .env and fill in. Never commit .env.
# Generate each secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------

# Server
HOST=0.0.0.0
PORT=1337

# Secrets (APP_KEYS is a comma-separated list of at least two)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ---------------------------------------------------------------------------
# Database
# Local development uses SQLite; Railway provides Postgres via DATABASE_URL.
# ---------------------------------------------------------------------------
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Postgres (Railway sets DATABASE_URL automatically when you attach the
# Postgres service; set DATABASE_CLIENT=postgres and DATABASE_SSL=true there)
# DATABASE_CLIENT=postgres
# DATABASE_URL=
# DATABASE_SSL=true

# ---------------------------------------------------------------------------
# Media uploads
# Railway's container filesystem is ephemeral, so production media MUST go to
# Cloudinary. Leave these blank locally to use the local-disk provider.
# ---------------------------------------------------------------------------
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER=metabase-replica

# ---------------------------------------------------------------------------
# CORS — comma-separated origins allowed to call this API from a browser.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:4321
# CORS_ORIGINS=https://your-astro-site.up.railway.app,http://localhost:4321
