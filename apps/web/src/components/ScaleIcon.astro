---
/*
 * The brand-blue stroke icons on the "Metabase scales as you grow" cards.
 *
 * Artwork comes from the CMS as the `scale` icon set. It is a set of its own
 * because the names overlap with the menus and mean different drawings:
 * `terminal` here is a window with a chevron, not the rounded square the menus
 * use.
 */
import { resolveIcon } from '../lib/icons';

interface Props { name: string }
const { name } = Astro.props;

const icon = (name ? await resolveIcon(name, 'scale') : undefined)
  ?? await resolveIcon('grid', 'scale');
---
{/* The original declares 42x42 but forces the box to 24 high in CSS, with no
    viewBox, so the artwork draws at its natural 24 and sits left in a 42-wide
    slot. Same result, stated directly. */}
{icon && (
  <svg width="24" height="24" viewBox={icon.box} fill="none" aria-hidden="true"
       set:html={icon.body} />
)}
