---
/** The brand-blue stroke icons on the "Metabase scales as you grow" cards. */
interface Props { name: string }
const { name } = Astro.props;

const paths: Record<string, string[]> = {
  grid: [
    'M4.75 5.75a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1v3.5a1 1 0 0 1-1 1h-3.5a1 1 0 0 1-1-1v-3.5Z',
    'M4.75 14.75a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1v3.5a1 1 0 0 1-1 1h-3.5a1 1 0 0 1-1-1v-3.5Z',
    'M13.75 5.75a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1v3.5a1 1 0 0 1-1 1h-3.5a1 1 0 0 1-1-1v-3.5Z',
    'M13.75 14.75a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1v3.5a1 1 0 0 1-1 1h-3.5a1 1 0 0 1-1-1v-3.5Z',
  ],
  eye: [
    'M19.25 12C19.25 13 17.5 18.25 12 18.25C6.5 18.25 4.75 13 4.75 12C4.75 11 6.5 5.75 12 5.75C17.5 5.75 19.25 11 19.25 12Z',
    'M12 14.25A2.25 2.25 0 1 0 12 9.75a2.25 2.25 0 0 0 0 4.5Z',
  ],
  terminal: ['M5.75 19.25h12.5a1 1 0 0 0 1-1V5.75a1 1 0 0 0-1-1H5.75a1 1 0 0 0-1 1v12.5a1 1 0 0 0 1 1Z',
             'M8.75 10.25 11 12.5l-2.25 2.25', 'M13 15.25h2.5'],
  chart: ['M5 19.25h14', 'M7.75 16V10.5', 'M12 16V6.75', 'M16.25 16v-3.5'],
  bolt: ['M13.25 4.75 6.75 13.25h4.5l-.5 6 6.5-8.5h-4.5l.5-6Z'],
  layers: ['M12 4.75 4.75 8.5 12 12.25 19.25 8.5 12 4.75Z', 'M4.75 12.5 12 16.25l7.25-3.75',
           'M4.75 16.25 12 20l7.25-3.75'],
};
const d = paths[name] ?? paths.grid;
---
<svg width="36" height="36" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {d.map((p) => (
    <path d={p} stroke="var(--color-brand)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  ))}
</svg>
