---
/**
 * The ProficiencyLabs dashboard behind the Embedded Analytics section, and the
 * SDK snippet that overlaps it.
 *
 * Measurements are the original's own: the stage is 540px tall, the dashboard
 * 92% wide at 558px with a 14px radius, and the code window sits absolutely at
 * bottom:-106px left:0 across 46% of the stage. Its syntax colours are the
 * Base16 Atelier Sulphurpool palette the original highlights with, and it is
 * draggable, as the original's `cursor: grab` and `is-dragging` class imply.
 */
const NAV = [
  ['Courses', true],
  ['New courses', false], ['Leadership Training', false], ['Technical Skills', false],
  ['Soft Skills', false], ['Compliance', false], ['Health & Wellness', false], ['Marketing', false],
] as const;

const SERIES = [
  { name: 'Soft Skills', colour: '#2f9e8f' },
  { name: 'Leadership Training', colour: '#e8905c' },
  { name: 'Health & Wellness', colour: '#84c877' },
  { name: 'Marketing', colour: '#f0d04e' },
];

// The legend carries four series, but every bar the original shows is green —
// so the bars are coloured by one series, not cycled through the legend.
const BAR_COLOUR = '#84c877';
const BARS = [
  ['Cloud Computing Basics', 43], ['Advanced Data Visualization', 42],
  ['Data Privacy and GDPR', 42], ['Design Thinking', 38], ['Team Leadership', 37],
] as const;
const barMax = 50;

// Three months of daily orders: noisy, with one clear spike, as on the original.
const ORDERS = Array.from({ length: 60 }, (_, i) => {
  const base = 4 + Math.sin(i / 1.6) * 2.2 + Math.cos(i / 3.1) * 1.4;
  return i === 14 ? 12 : Math.max(1, Math.round(base + (i % 5 === 0 ? 1.6 : 0)));
});
const oW = 420, oH = 90, oPadL = 22, oPadB = 16;
const ox = (i: number) => oPadL + (i * (oW - oPadL - 4)) / (ORDERS.length - 1);
const oy = (v: number) => (oH - oPadB) - (v / 12) * (oH - oPadB - 6);
const orderLine = ORDERS.map((v, i) => `${ox(i)},${oy(v)}`).join(' ');
const orderArea = `${oPadL},${oH - oPadB} ${orderLine} ${ox(ORDERS.length - 1)},${oH - oPadB}`;
---
<div class="ea-stage">
  <div class="ea-dashboard">
    <div class="eadash">
      <aside class="eadash__nav">
        <p class="eadash__brand">
          <span class="eadash__brand-mark" aria-hidden="true">P</span>ProficiencyLabs
        </p>
        <ul>
          {NAV.map(([label, head]) => (
            <li class={head ? 'eadash__nav-head' : ''}>{label}</li>
          ))}
        </ul>
        <p class="eadash__nav-head eadash__nav-head--spaced">Analytics</p>
        <ul>
          <li>Dashboards</li>
          <li class="eadash__nav-on">Inventory performance</li>
          <li>Saved explorations</li>
        </ul>
      </aside>

      <div class="eadash__main">
        <p class="eadash__title">Inventory performance</p>

        <div class="eadash__row">
          <section class="eadash__card">
            <p>New products launched this year</p>
            <p class="eadash__big">10</p>
            <p class="eadash__delta">
              <b>↑ 400%</b> <span>vs. previous year: 2</span>
            </p>
          </section>

          <section class="eadash__card">
            <p>Orders in the last 3 months</p>
            <svg viewBox={`0 0 ${oW} ${oH}`} role="img" aria-label="Daily orders over the last three months">
              {[0, 2, 4, 6, 8, 10, 12].map((t) => (
                <>
                  <line x1={oPadL} x2={oW - 4} y1={oy(t)} y2={oy(t)} stroke="#eef0f3" />
                  <text x={oPadL - 4} y={oy(t) + 3} text-anchor="end" font-size="7" fill="#8d93a5">{t}</text>
                </>
              ))}
              <polygon points={orderArea} fill="#2f9e8f" opacity="0.12" />
              <polyline points={orderLine} fill="none" stroke="#2f9e8f" stroke-width="1.4" />
              {['Mar 1', 'Mar 15', 'Mar 29', 'Apr 12', 'Apr 26'].map((l, i) => (
                <text x={oPadL + (i * (oW - oPadL - 4)) / 4} y={oH - 4} text-anchor="middle" font-size="7" fill="#8d93a5">{l}, 2026</text>
              ))}
            </svg>
          </section>
        </div>

        <section class="eadash__card eadash__card--wide">
          <p>Best selling products</p>
          <ul class="eadash__legend">
            {SERIES.map((s) => (
              <li><i style={`background:${s.colour}`}></i>{s.name}</li>
            ))}
          </ul>
          <ul class="eadash__bars">
            {BARS.map(([label, value]) => (
              <li>
                <span class="eadash__bar-label">{label}</span>
                <span class="eadash__bar-track">
                  <span class="eadash__bar-fill" style={`width:${(value / barMax) * 100}%;background:${BAR_COLOUR}`}></span>
                </span>
                <span class="eadash__bar-value">{value}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </div>

  <!-- Decorative, as on the original: the snippet illustrates the SDK rather
       than carrying information, and its syntax palette is below AA. -->
  <div class="ea-code" data-ea-code aria-hidden="true">
    <div class="ea-code-head">
      <span class="ea-code-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
    <pre class="ea-code-body"><code><span class="hl-kw">import</span> &#123;
  <span class="hl-cls">MetabaseProvider</span>,
  <span class="hl-cls">InteractiveQuestion</span>,
  defineEmbeddingSdkConfig
&#125; <span class="hl-kw">from</span> <span class="hl-str">"@metabase/embedding-sdk-react"</span>;

<span class="hl-kw">const</span> config = <span class="hl-fn">defineEmbeddingSdkConfig</span>(&#123;
  <span class="hl-attr">metabaseInstanceUrl</span>: <span class="hl-str">"https://metabase.example.com"</span>, <span class="hl-com">// Required</span>
  <span class="hl-attr">authProviderUri</span>: <span class="hl-str">"https://app.example.com/sso/metabase"</span>, <span class="hl-com">// SSO</span>
&#125;);

<span class="hl-tag">&lt;<span class="hl-name">MetabaseProvider</span> <span class="hl-attr">config</span>=<span class="hl-str">&#123;config&#125;</span>&gt;</span>
  <span class="hl-tag">&lt;<span class="hl-name">InteractiveQuestion</span> <span class="hl-attr">questionId</span>=<span class="hl-str">&#123;42&#125;</span> /&gt;</span>
<span class="hl-tag">&lt;/<span class="hl-name">MetabaseProvider</span>&gt;</span></code></pre>
  </div>
</div>

<style is:global>
  .ea-stage { position: relative; margin-inline: auto; min-height: 540px; margin-bottom: 8.75rem; }
  .ea-dashboard {
    position: relative; z-index: 0; margin-inline: auto; width: 92%; height: 558px;
    overflow: hidden; border: 1px solid #10182814; border-radius: 14px; background: #fff;
    box-shadow: 0 24px 48px -28px #10182859;
  }

  /* Exactly where the original parks it. */
  .ea-code {
    position: absolute; bottom: -106px; left: 0; z-index: 20; width: 46%;
    overflow: hidden; border: 1px solid #10182814; border-radius: 0.75rem; background: #fff;
    box-shadow: 0 24px 50px -18px #10182833, 0 6px 18px -10px #1018281a;
    cursor: grab; touch-action: none; user-select: none;
  }
  .ea-code.is-dragging { cursor: grabbing; }
  .ea-code-head {
    display: flex; align-items: center;
    padding: 0.75rem 1rem; background: #fcfdff; border-bottom: 1px solid #1018280f;
  }
  .ea-code-dots { display: inline-flex; gap: 0.375rem; }
  .ea-code-dots i { width: 10px; height: 10px; border-radius: 9999px; background: #e2e4e9; }
  .ea-code-body {
    margin: 0; padding: 1rem 18px 18px 0; background: #fff;
    font-family: 'Roboto Mono', 'SF Mono', Menlo, monospace;
    font-size: 12.5px; line-height: 22px; overflow-x: auto;
  }
  .ea-code-body code { display: block; padding: 1em; white-space: pre; color: #4c5773; }

  /* Base16 Atelier Sulphurpool Light, as the original highlights with. */
  .hl-kw   { color: #6679cc; }
  .hl-cls  { color: #c08b30; }
  .hl-str  { color: #ac9739; }
  .hl-fn   { color: #3d8fd1; }
  .hl-attr { color: #c76b29; }
  .hl-com  { color: #898ea4; }
  .hl-tag  { color: #6b7394; }
  .hl-name { color: #c94922; }

  @media (max-width: 1023px) {
    .ea-stage { min-height: 0; margin-bottom: 3rem; }
    .ea-dashboard { width: 100%; height: 460px; }
    .ea-code {
      position: static; width: 100%; margin-top: 1.5rem;
      cursor: default; touch-action: auto; user-select: auto;
    }
  }

  /* --- the dashboard itself --- */
  .eadash { display: grid; grid-template-columns: 200px 1fr; height: 100%; font-size: 11px; }
  .eadash__nav { border-inline-end: 1px solid var(--color-line); padding: 1rem; overflow: hidden; }
  .eadash__brand { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 1.25rem; font-weight: 900; font-size: 13px; }
  .eadash__brand-mark {
    display: grid; place-items: center; width: 20px; height: 20px; border-radius: 9999px;
    border: 1.5px solid #2f9e8f; color: #2f9e8f; font-size: 11px;
  }
  .eadash__nav ul, .eadash__nav li { list-style: none; margin: 0; padding: 0; }
  .eadash__nav li { padding: 0.3rem 0; color: var(--color-ink-2); }
  .eadash__nav-head { margin: 0 0 0.3rem; font-weight: 700; color: var(--color-ink); }
  .eadash__nav-head--spaced { margin-top: 1.1rem; }
  .eadash__nav-on { color: var(--color-brand); font-weight: 700; }

  .eadash__main { padding: 1rem; overflow: hidden; }
  .eadash__title { margin: 0 0 0.85rem; font-size: 19px; }
  .eadash__row { display: grid; grid-template-columns: 1fr 1.5fr; gap: 0.7rem; margin-bottom: 0.7rem; }
  .eadash__card { border: 1px solid var(--color-line); border-radius: 0.5rem; padding: 0.7rem; }
  .eadash__card > p:first-child { margin: 0 0 0.5rem; font-size: 11px; font-weight: 700; }
  .eadash__big { margin: 0.5rem 0 0; font-size: 34px; font-weight: 900; line-height: 1; text-align: center; }
  .eadash__delta { margin: 0.4rem 0 0; text-align: center; font-size: 10px; }
  .eadash__delta b { color: var(--color-ok-strong); }
  .eadash__delta span { color: var(--color-ink-3); }

  .eadash__legend { display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; list-style: none; margin: 0 0 0.6rem; padding: 0; }
  .eadash__legend li { display: flex; align-items: center; gap: 0.3rem; font-size: 10px; color: var(--color-ink-2); }
  .eadash__legend i { width: 8px; height: 8px; border-radius: 9999px; }
  .eadash__bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .eadash__bars li { display: grid; grid-template-columns: 140px 1fr 24px; align-items: center; gap: 0.5rem; }
  .eadash__bar-label { text-align: end; color: var(--color-ink-2); font-size: 10px; }
  .eadash__bar-track { height: 14px; background: #f4f6f8; border-radius: 2px; }
  .eadash__bar-fill { display: block; height: 100%; border-radius: 2px; }
  .eadash__bar-value { font-size: 10px; color: var(--color-ink-2); }

  @media (max-width: 719px) {
    .eadash { grid-template-columns: 1fr; }
    .eadash__nav { display: none; }
    .eadash__row { grid-template-columns: 1fr; }
    .eadash__bars li { grid-template-columns: 96px 1fr 22px; }
  }
</style>

<script>
  // The original's code window is grabbable; keep that, but only where it is
  // actually floating over the dashboard.
  document.querySelectorAll<HTMLElement>('[data-ea-code]').forEach((el) => {
    let id: number | null = null;
    let sx = 0, sy = 0, ox = 0, oy = 0;

    const floating = () => getComputedStyle(el).position === 'absolute';

    el.addEventListener('pointerdown', (e) => {
      if (!floating()) return;
      id = e.pointerId;
      sx = e.clientX; sy = e.clientY;
      const t = new DOMMatrixReadOnly(getComputedStyle(el).transform);
      ox = t.m41; oy = t.m42;
      el.classList.add('is-dragging');
      el.setPointerCapture(id);
    });

    el.addEventListener('pointermove', (e) => {
      if (id === null || e.pointerId !== id) return;
      el.style.transform = `translate(${ox + e.clientX - sx}px, ${oy + e.clientY - sy}px)`;
    });

    const release = (e: PointerEvent) => {
      if (id === null || e.pointerId !== id) return;
      el.releasePointerCapture(id);
      id = null;
      el.classList.remove('is-dragging');
    };
    el.addEventListener('pointerup', release);
    el.addEventListener('pointercancel', release);
  });
</script>
