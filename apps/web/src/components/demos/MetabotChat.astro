---
/**
 * The Metabot conversation from "Query data in plain English with AI".
 *
 * The original plays a scripted exchange: the question types itself in, typing
 * dots appear, a chart draws, then the source card and the answer. Replayed
 * here on scroll into view, and rendered in full immediately for anyone who
 * asks for reduced motion.
 */
const POINTS = [18, 28, 76, 142, 170, 198, 236, 254, 294, 325, 329, 345, 390, 400, 401, 420];
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec','Jan','Feb','Mar','Apr'];

const W = 560, H = 210, PAD_L = 42, PAD_B = 26, PAD_T = 8;
const max = 600;
const plotH = H - PAD_B - PAD_T;
const x = (i: number) => PAD_L + (i * (W - PAD_L - 10)) / (POINTS.length - 1);
const y = (v: number) => PAD_T + plotH - (v / max) * plotH;
const path = POINTS.map((v, i) => `${x(i)},${y(v)}`).join(' ');
---
<div class="mbot" data-mbot>
  <p class="mbot__q" data-mbot-q><span data-mbot-typed></span><i class="mbot__caret" aria-hidden="true"></i></p>

  <div class="mbot__dots" data-mbot-dots hidden aria-hidden="true"><span></span><span></span><span></span></div>

  <figure class="mbot__chart" data-mbot-chart hidden>
    <figcaption>Orders over time (monthly)</figcaption>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Line chart of orders over time, climbing from under 50 to about 420">
      {[0, 100, 200, 300, 400, 500, 600].map((t) => (
        <>
          <line x1={PAD_L} x2={W - 10} y1={y(t)} y2={y(t)} stroke="#e2e4e9" />
          <text x={PAD_L - 7} y={y(t) + 3} text-anchor="end" font-size="9" fill="#8d93a5">{t}</text>
        </>
      ))}
      <polyline class="mbot__line" points={path} fill="none" stroke="#509ee3" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" />
      {POINTS.map((v, i) => (
        <circle cx={x(i)} cy={y(v)} r="2.6" fill="#fff" stroke="#509ee3" stroke-width="1.6" />
      ))}
      {MONTHS.map((m, i) => (
        i % 1 === 0 && <text x={x(i)} y={H - 10} text-anchor="middle" font-size="8" fill="#8d93a5">{m}</text>
      ))}
      <text x={W / 2} y={H - 1} text-anchor="middle" font-size="8" fill="#5a6072" font-weight="700">Created At: Month</text>
    </svg>
  </figure>

  <div class="mbot__source" data-mbot-source hidden>
    <p class="mbot__source-head">Data source used</p>
    <div class="mbot__source-row">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M9 9v11" />
      </svg>
      <span><b>Orders + People</b><small>Model · Data library</small></span>
      <span class="mbot__votes">
        <button type="button" aria-label="Good answer" data-vote="up">👍</button>
        <button type="button" aria-label="Bad answer" data-vote="down">👎</button>
      </span>
    </div>
  </div>

  <div class="mbot__answer" data-mbot-answer hidden>
    <p>Here's <a href="#">Orders over time (monthly)</a>, from the <a href="#">Orders + People</a> model.</p>
    <p>Orders climbed steadily through <a href="#">July 2026</a>, with recent months tracking in the high 400s.</p>
  </div>

  <p class="mbot__ask"><span>Ask about your data</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7" />
    </svg>
  </p>
</div>

<style is:global>
  .mbot {
    border: 1px solid var(--color-line); border-radius: 1rem; background: #fff;
    padding: 1rem; font-size: 0.8125rem;
  }
  .mbot__q {
    margin: 0 0 0.9rem; margin-inline-start: auto; width: fit-content; min-height: 2.2rem;
    border: 1px solid var(--color-line); border-radius: 0.75rem; padding: 0.55rem 0.85rem;
  }
  .mbot__caret { display: inline-block; width: 1px; height: 1em; background: var(--color-ink); vertical-align: -2px; animation: mbot-caret 1s step-end infinite; }
  .mbot__q[data-done='true'] .mbot__caret { display: none; }
  @keyframes mbot-caret { 50% { opacity: 0; } }

  .mbot__dots { display: flex; gap: 4px; padding: 0.4rem 0; }
  .mbot__dots span { width: 6px; height: 6px; border-radius: 9999px; background: var(--color-ink-4); animation: mbot-dot 1.2s infinite; }
  .mbot__dots span:nth-child(2) { animation-delay: 0.15s; }
  .mbot__dots span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes mbot-dot { 0%,60%,100% { opacity: 0.35; } 30% { opacity: 1; } }

  .mbot__chart { margin: 0 0 0.75rem; border: 1px solid var(--color-line); border-radius: 0.625rem; padding: 0.7rem; }
  .mbot__chart figcaption { margin-bottom: 0.4rem; font-weight: 700; }
  .mbot__chart svg { width: 100%; height: auto; }
  /* The line draws itself in; length is set from script once measured. */
  .mbot__line { transition: stroke-dashoffset 1.3s ease-out; }

  .mbot__source { margin-bottom: 0.75rem; border: 1px solid var(--color-line); border-radius: 0.625rem; }
  .mbot__source-head { margin: 0; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--color-line); color: var(--color-ink-2); font-weight: 700; }
  .mbot__source-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.6rem 0.7rem; }
  .mbot__source-row svg { width: 16px; height: 16px; color: var(--color-brand); flex-shrink: 0; }
  .mbot__source-row b { display: block; font-weight: 700; }
  .mbot__source-row small { color: var(--color-ink-3); }
  .mbot__votes { margin-inline-start: auto; display: flex; gap: 0.3rem; }
  .mbot__votes button { border: 0; background: none; cursor: pointer; opacity: 0.5; font-size: 0.875rem; }
  .mbot__votes button:hover, .mbot__votes button[data-on='true'] { opacity: 1; }

  .mbot__answer p { margin: 0 0 0.5rem; color: var(--color-ink-2); line-height: 1.55; }
  .mbot__answer a { color: var(--color-brand); }

  .mbot__ask {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    margin: 0.9rem 0 0; border: 1px solid var(--color-line); border-radius: 9999px;
    padding: 0.6rem 0.9rem; color: var(--color-ink-3);
  }
  .mbot__ask svg { width: 15px; height: 15px; color: var(--color-brand); }
</style>

<script>
  const QUESTION = 'show me orders over time';

  document.querySelectorAll<HTMLElement>('[data-mbot]').forEach((root) => {
    const q = root.querySelector<HTMLElement>('[data-mbot-q]')!;
    const typed = root.querySelector<HTMLElement>('[data-mbot-typed]')!;
    const dots = root.querySelector<HTMLElement>('[data-mbot-dots]')!;
    const chart = root.querySelector<HTMLElement>('[data-mbot-chart]')!;
    const source = root.querySelector<HTMLElement>('[data-mbot-source]')!;
    const answer = root.querySelector<HTMLElement>('[data-mbot-answer]')!;
    const line = root.querySelector<SVGPolylineElement>('.mbot__line')!;

    root.querySelectorAll<HTMLButtonElement>('[data-vote]').forEach((b) =>
      b.addEventListener('click', () => {
        root.querySelectorAll<HTMLElement>('[data-vote]').forEach((o) => (o.dataset.on = 'false'));
        b.dataset.on = 'true';
      })
    );

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    function showAll() {
      typed.textContent = QUESTION;
      q.dataset.done = 'true';
      dots.hidden = true;
      [chart, source, answer].forEach((el) => (el.hidden = false));
      line.style.strokeDasharray = '';
      line.style.strokeDashoffset = '';
    }

    async function play() {
      typed.textContent = '';
      q.dataset.done = 'false';
      dots.hidden = true;
      [chart, source, answer].forEach((el) => (el.hidden = true));

      for (let i = 1; i <= QUESTION.length; i++) {
        typed.textContent = QUESTION.slice(0, i);
        await sleep(42);
      }
      q.dataset.done = 'true';
      await sleep(350);

      dots.hidden = false;
      await sleep(1100);
      dots.hidden = true;

      chart.hidden = false;
      // Measure after the element is visible, or getTotalLength is 0.
      const len = line.getTotalLength();
      line.style.strokeDasharray = String(len);
      line.style.strokeDashoffset = String(len);
      requestAnimationFrame(() => { line.style.strokeDashoffset = '0'; });
      await sleep(900);

      source.hidden = false;
      await sleep(450);
      answer.hidden = false;
    }

    if (reduced) { showAll(); return; }

    let played = false;
    new IntersectionObserver((entries, obs) => {
      for (const e of entries) {
        if (e.isIntersecting && !played) { played = true; play(); obs.disconnect(); }
      }
    }, { threshold: 0.45 }).observe(root);
  });
</script>
