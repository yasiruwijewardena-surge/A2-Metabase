---
/**
 * The Metabot conversation from "Query data in plain English with AI".
 *
 * The original plays a scripted exchange: the question types itself in, typing
 * dots appear, a chart draws, then the source card and the answer. Replayed
 * here on scroll into view, and rendered in full immediately for anyone who
 * asks for reduced motion.
 */
/* The same figures and palette the hero dashboard plots, because the answer
   below cites the same question. The chart drew a line of monthly orders
   under a caption reading New Accounts by Source, which agreed with neither. */
const SOURCES = [
  { name: 'Organic',  color: '#7172AD' },
  { name: 'Facebook', color: '#509EE3' },
  { name: 'Google',   color: '#EF8C8C' },
  { name: 'Invite',   color: '#F2A86F' },
  { name: 'LinkedIn', color: '#F9D45C' },
];
const YEARS = [
  { year: 2021, v: [118, 42, 58, 34, 52] },
  { year: 2022, v: [ 88, 30, 42, 26, 44] },
  { year: 2023, v: [ 96, 34, 48, 28, 50] },
  { year: 2024, v: [ 78, 28, 38, 24, 42] },
  { year: 2025, v: [104, 32, 50, 30, 56] },
  { year: 2026, v: [ 62, 18, 30, 20, 32] },
];

const W = 560, H = 210, PAD_L = 42, PAD_B = 26, PAD_T = 8;
const max = 400;
const plotH = H - PAD_B - PAD_T;
const band = (W - PAD_L - 10) / YEARS.length;
const barW = band * 0.56;
const h = (v: number) => (v / max) * plotH;
const y = (v: number) => PAD_T + plotH - h(v);
---
<div class="mbot" data-mbot>
  <p class="mbot__q" data-mbot-q><span data-mbot-typed></span><i class="mbot__caret" aria-hidden="true"></i></p>

  <div class="mbot__dots" data-mbot-dots hidden aria-hidden="true"><span></span><span></span><span></span></div>

  <figure class="mbot__chart" data-mbot-chart hidden>
    <figcaption>New Accounts by Source</figcaption>
    <svg viewBox={`0 0 ${W} ${H}`} role="img"
         aria-label="Stacked bar chart of accounts added per year by source">
      {[0, 100, 200, 300, 400].map((t) => (
        <>
          <line x1={PAD_L} x2={W - 10} y1={y(t)} y2={y(t)} stroke={t === 0 ? '#e3e7eb' : '#eef0f2'} />
          <text x={PAD_L - 7} y={y(t) + 3} text-anchor="end" font-size="9" fill="#5a6072">{t}</text>
        </>
      ))}
      {YEARS.map((row, i) => {
        let acc = 0;
        const bx = PAD_L + i * band + (band - barW) / 2;
        return (
          <>
            {row.v.map((v, si) => {
              const bh = h(v);
              const by = y(acc) - bh;
              acc += v;
              return <rect class="mbot__bar" x={bx} y={by} width={barW} height={bh}
                           fill={SOURCES[si].color} style={`--d:${i * 70}ms`} />;
            })}
            <text x={bx + barW / 2} y={H - 10} text-anchor="middle" font-size="9" fill="#5a6072">{row.year}</text>
          </>
        );
      })}
      <text x={W / 2} y={H - 1} text-anchor="middle" font-size="8" fill="#5a6072" font-weight="700">Created At: Year</text>
    </svg>
  </figure>

  <div class="mbot__lead" data-mbot-lead hidden>
    <p><strong>Organic added the most in 2026: 62 accounts,</strong> ahead of Google at 30.
      LinkedIn, Invite, and Facebook make up the rest.</p>
  </div>

  <div class="mbot__source" data-mbot-source hidden>
    <p class="mbot__source-head">Data Sources</p>
    <div class="mbot__source-row">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M9 9v11" />
      </svg>
      <span><b>Accounts</b><small>Data library</small></span>
      <span class="mbot__votes">
        <button type="button" aria-label="Good answer" data-vote="up">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M7 11v9H4v-9zM7 11l4-7a2 2 0 0 1 3 2l-1 5h5a2 2 0 0 1 2 2.3l-1 6A2 2 0 0 1 17 20H7" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" aria-label="Bad answer" data-vote="down">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M17 13V4h3v9zM17 13l-4 7a2 2 0 0 1-3-2l1-5H6a2 2 0 0 1-2-2.3l1-6A2 2 0 0 1 7 4h10" stroke-linejoin="round" />
          </svg>
        </button>
      </span>
    </div>
  </div>

  <div class="mbot__answer" data-mbot-answer hidden>
    <p>The bigger signal is that 2026 is tracking below recent years across every source,
      so even the top channel is down on its usual pace. The slowdown is broad, not one
      channel falling off.</p>
    <p>Want me to compare <span class="mbot__mention">@New Accounts by Source</span>, 2026 vs 2025?</p>
  </div>

  <p class="mbot__ask"><span>Ask about your data</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7" />
    </svg>
  </p>
</div>

<style is:global>
  .mbot {
    border: 1px solid var(--color-line); border-radius: 1rem; background: #fff;
    padding: 1rem; font-size: 0.8125rem;
  }
  .mbot__q {
    margin: 0 0 0.9rem; margin-inline-start: auto; width: fit-content; min-height: 2.2rem;
    border: 1px solid var(--color-line); border-radius: 0.75rem; padding: 0.55rem 0.85rem;
    font-size: 14px; line-height: 24px; color: var(--color-ink);
  }
  .mbot__caret { display: inline-block; width: 1px; height: 1em; background: var(--color-ink); vertical-align: -2px; animation: mbot-caret 1s step-end infinite; }
  .mbot__q[data-done='true'] .mbot__caret { display: none; }
  @keyframes mbot-caret { 50% { opacity: 0; } }

  .mbot__dots { display: flex; gap: 4px; padding: 0.4rem 0; }
  .mbot__dots span { width: 6px; height: 6px; border-radius: 9999px; background: var(--color-ink-4); animation: mbot-dot 1.2s infinite; }
  .mbot__dots span:nth-child(2) { animation-delay: 0.15s; }
  .mbot__dots span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes mbot-dot { 0%,60%,100% { opacity: 0.35; } 30% { opacity: 1; } }

  .mbot__chart { margin: 0 0 0.75rem; border: 1px solid var(--color-line); border-radius: 0.625rem; padding: 0.7rem; }
  .mbot__chart figcaption { margin-bottom: 0.4rem; font-weight: 700; }
  .mbot__chart svg { width: 100%; height: auto; }
  /* The bars grow from the axis, each a little after the one before it. */
  .mbot__bar { transform-origin: center bottom; transform: scaleY(0); }
  .mbot__bar.is-in { transform: scaleY(1); transition: transform 700ms cubic-bezier(.2,.7,.3,1) var(--d, 0ms); }
  @media (prefers-reduced-motion: reduce) {
    .mbot__bar { transform: none; }
    .mbot__bar.is-in { transition: none; }
  }

  .mbot__source { margin-bottom: 0.75rem; border: 1px solid var(--color-line); border-radius: 0.625rem; }
  /* Measured on the original: the card header is 12px, the model name 14/16
     and its library 12/16 -- three sizes, not the one the base was giving. */
  .mbot__source-head {
    margin: 0; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--color-line);
    font-size: 12px; font-weight: 700; color: var(--color-ink);
  }
  .mbot__source-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.6rem 0.7rem; }
  .mbot__source-row svg { width: 16px; height: 16px; color: var(--color-brand); flex-shrink: 0; }
  .mbot__source-row b { display: block; font-size: 14px; line-height: 16px; font-weight: 700; color: var(--color-ink); }
  .mbot__source-row small { font-size: 12px; line-height: 16px; color: var(--color-ink-2); }
  .mbot__votes { margin-inline-start: auto; display: flex; gap: 0.3rem; }
  .mbot__votes button { border: 0; background: none; cursor: pointer; opacity: 0.5; font-size: 0.875rem; }
  .mbot__votes button:hover, .mbot__votes button[data-on='true'] { opacity: 1; }

  /* 14/24 in primary ink, which is what the original sets for the whole
     exchange -- question, finding and reasoning alike. */
  .mbot__lead p, .mbot__answer p {
    margin: 0 0 0.75rem; font-size: 14px; line-height: 24px; color: var(--color-ink);
  }
  .mbot__lead p:last-child, .mbot__answer p:last-child { margin-bottom: 0; }
  .mbot__lead strong { font-weight: 700; }
  .mbot__answer a { color: var(--color-brand); }
  /* The @-reference to a saved question reads as a chip rather than a link. */
  .mbot__mention {
    border-radius: 4px; background: var(--color-surface); padding: 1px 5px;
    color: var(--color-ink); white-space: nowrap;
  }

  .mbot__ask {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    margin: 0.9rem 0 0; border: 1px solid var(--color-line); border-radius: 9999px;
    padding: 0.6rem 0.9rem; color: var(--color-ink-3);
  }
  .mbot__ask svg { width: 15px; height: 15px; color: var(--color-brand); }
</style>

<script>
  const QUESTION = 'Which source added the most accounts in 2026?';

  document.querySelectorAll<HTMLElement>('[data-mbot]').forEach((root) => {
    const q = root.querySelector<HTMLElement>('[data-mbot-q]')!;
    const typed = root.querySelector<HTMLElement>('[data-mbot-typed]')!;
    const dots = root.querySelector<HTMLElement>('[data-mbot-dots]')!;
    const chart = root.querySelector<HTMLElement>('[data-mbot-chart]')!;
    const lead = root.querySelector<HTMLElement>('[data-mbot-lead]')!;
    const source = root.querySelector<HTMLElement>('[data-mbot-source]')!;
    const answer = root.querySelector<HTMLElement>('[data-mbot-answer]')!;
    const bars = [...root.querySelectorAll<SVGRectElement>('.mbot__bar')];

    root.querySelectorAll<HTMLButtonElement>('[data-vote]').forEach((b) =>
      b.addEventListener('click', () => {
        root.querySelectorAll<HTMLElement>('[data-vote]').forEach((o) => (o.dataset.on = 'false'));
        b.dataset.on = 'true';
      })
    );

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    function showAll() {
      typed.textContent = QUESTION;
      q.dataset.done = 'true';
      dots.hidden = true;
      [chart, lead, source, answer].forEach((el) => (el.hidden = false));
      bars.forEach((b) => b.classList.add('is-in'));
    }

    async function play() {
      typed.textContent = '';
      q.dataset.done = 'false';
      dots.hidden = true;
      [chart, lead, source, answer].forEach((el) => (el.hidden = true));

      for (let i = 1; i <= QUESTION.length; i++) {
        typed.textContent = QUESTION.slice(0, i);
        await sleep(42);
      }
      q.dataset.done = 'true';
      await sleep(350);

      dots.hidden = false;
      await sleep(1100);
      dots.hidden = true;

      chart.hidden = false;
      /* The bars grow once the chart is on screen; scaleY from a zero start
         needs a frame between the two states or it lands instantly. */
      requestAnimationFrame(() => bars.forEach((b) => b.classList.add('is-in')));
      await sleep(900);

      /* The finding lands first, then what it was drawn from, then the
         reasoning -- the order the original reveals them in. */
      lead.hidden = false;
      await sleep(400);
      source.hidden = false;
      await sleep(450);
      answer.hidden = false;
    }

    if (reduced) { bars.forEach((b) => b.classList.add('is-in')); showAll(); return; }

    let played = false;
    new IntersectionObserver((entries, obs) => {
      for (const e of entries) {
        if (e.isIntersecting && !played) { played = true; play(); obs.disconnect(); }
      }
    }, { threshold: 0.45 }).observe(root);
  });
</script>
