---
/**
 * The Metabot conversation from "Query data in plain English with AI".
 *
 * The original plays a scripted exchange: the question types itself in, typing
 * dots appear, a chart draws, then the source card and the answer. Replayed
 * here on scroll into view, and rendered in full immediately for anyone who
 * asks for reduced motion.
 */
/*
 * The original's demo asks two things in turn -- "show me orders over time",
 * then "break this down by product type" -- and the thread scrolls once the
 * second answer lands. An earlier pass replaced all of this with the accounts
 * conversation from the hero column, which belongs to that panel, not here.
 */
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec','Jan','Feb','Mar','Apr'];
const TOTAL  = [18, 28, 76, 142, 170, 198, 236, 254, 294, 325, 329, 345, 390, 400, 401, 420];

/* The same series split three ways, for the follow-up. */
const CATEGORIES = [
  { name: 'Widget',  color: '#509EE3', share: 0.46 },
  { name: 'Gizmo',   color: '#88BF4D', share: 0.33 },
  { name: 'Gadget',  color: '#F9CF48', share: 0.21 },
];

const W = 560, H = 210, PAD_L = 42, PAD_B = 26, PAD_T = 8;
const max = 600;
const plotH = H - PAD_B - PAD_T;
const x = (i: number) => PAD_L + (i * (W - PAD_L - 10)) / (TOTAL.length - 1);
const y = (v: number) => PAD_T + plotH - (v / max) * plotH;
const line = (vals: number[]) => vals.map((v, i) => `${x(i)},${y(v)}`).join(' ');
---
<div class="mbot" data-mbot>
  <div class="mbot__thread" data-mbot-thread>
    <p class="mbot__q" data-mbot-q><span data-mbot-typed></span><i class="mbot__caret" aria-hidden="true"></i></p>

    <div class="mbot__dots" data-mbot-dots hidden aria-hidden="true"><span></span><span></span><span></span></div>

    <figure class="mbot__chart" data-mbot-chart hidden>
      <figcaption>Orders over time (monthly)</figcaption>
      <svg viewBox={`0 0 ${W} ${H}`} role="img"
           aria-label="Line chart of orders over time, climbing from under 50 to about 420">
        {[0, 200, 400, 600].map((t) => (
          <>
            <line x1={PAD_L} x2={W - 10} y1={y(t)} y2={y(t)} stroke={t === 0 ? '#e3e7eb' : '#eef0f2'} />
            <text x={PAD_L - 7} y={y(t) + 3} text-anchor="end" font-size="9" fill="#5a6072">{t}</text>
          </>
        ))}
        <polyline class="mbot__line" points={line(TOTAL)} fill="none" stroke="#509ee3" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" />
        {MONTHS.map((m, i) => (
          <text x={x(i)} y={H - 10} text-anchor="middle" font-size="8" fill="#5a6072">{m}</text>
        ))}
        <text x={W / 2} y={H - 1} text-anchor="middle" font-size="8" fill="#5a6072" font-weight="700">Created At: Month</text>
      </svg>
    </figure>

    <div class="mbot__source" data-mbot-source hidden>
      <p class="mbot__source-head">Data Sources</p>
      <div class="mbot__source-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M9 9v11" />
        </svg>
        <span><b>Orders + People</b><small>Model · Data library</small></span>
        <span class="mbot__votes">
          <button type="button" aria-label="Mark source correct" data-vote="up">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M7 11v9H4v-9zM7 11l4-7a2 2 0 0 1 3 2l-1 5h5a2 2 0 0 1 2 2.3l-1 6A2 2 0 0 1 17 20H7" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" aria-label="Mark source incorrect" data-vote="down">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M17 13V4h3v9zM17 13l-4 7a2 2 0 0 1-3-2l1-5H6a2 2 0 0 1-2-2.3l1-6A2 2 0 0 1 7 4h10" stroke-linejoin="round" />
            </svg>
          </button>
        </span>
      </div>
    </div>

    <div class="mbot__answer" data-mbot-answer hidden>
      <p>Orders climb steadily across the period, from under 50 a month to about 420.</p>
    </div>

    {/* The follow-up. Its arrival is what pushes the thread past its own height
        and makes it scroll, which is the whole point of the demo. */}
    <p class="mbot__q" data-mbot-q2 hidden><span data-mbot-typed2></span><i class="mbot__caret" aria-hidden="true"></i></p>

    <div class="mbot__dots" data-mbot-dots2 hidden aria-hidden="true"><span></span><span></span><span></span></div>

    <figure class="mbot__chart" data-mbot-chart2 hidden>
      <figcaption>Orders over time by product category</figcaption>
      <svg viewBox={`0 0 ${W} ${H}`} role="img"
           aria-label="Three lines of orders over time, split by product category">
        {[0, 200, 400, 600].map((t) => (
          <>
            <line x1={PAD_L} x2={W - 10} y1={y(t)} y2={y(t)} stroke={t === 0 ? '#e3e7eb' : '#eef0f2'} />
            <text x={PAD_L - 7} y={y(t) + 3} text-anchor="end" font-size="9" fill="#5a6072">{t}</text>
          </>
        ))}
        {CATEGORIES.map((c) => (
          <polyline class="mbot__line" points={line(TOTAL.map((v) => v * c.share))} fill="none"
                    stroke={c.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        ))}
        {MONTHS.map((m, i) => (
          <text x={x(i)} y={H - 10} text-anchor="middle" font-size="8" fill="#5a6072">{m}</text>
        ))}
      </svg>
      <p class="mbot__legend">
        {CATEGORIES.map((c) => (
          <span><i style={`background:${c.color}`} aria-hidden="true"></i>{c.name}</span>
        ))}
      </p>
    </figure>

    <div class="mbot__source" data-mbot-source2 hidden>
      <p class="mbot__source-head">Data Sources</p>
      <div class="mbot__source-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M9 9v11" />
        </svg>
        <span><b>Products</b><small>Table · Sample Database</small></span>
        <span class="mbot__votes">
          <button type="button" aria-label="Mark source correct" data-vote="up2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M7 11v9H4v-9zM7 11l4-7a2 2 0 0 1 3 2l-1 5h5a2 2 0 0 1 2 2.3l-1 6A2 2 0 0 1 17 20H7" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" aria-label="Mark source incorrect" data-vote="down2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M17 13V4h3v9zM17 13l-4 7a2 2 0 0 1-3-2l1-5H6a2 2 0 0 1-2-2.3l1-6A2 2 0 0 1 7 4h10" stroke-linejoin="round" />
            </svg>
          </button>
        </span>
      </div>
    </div>

    <div class="mbot__answer" data-mbot-answer2 hidden>
      <p>Widget leads throughout at roughly 46% of orders, with Gizmo at 33% and Gadget at 21%.
        All three grow at a similar rate, so the mix barely shifts over the period.</p>
    </div>
  </div>

  <p class="mbot__ask"><span>Ask about your data</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7" />
    </svg>
  </p>
</div>

<style is:global>
  .mbot {
    border: 1px solid var(--color-line); border-radius: 1rem; background: #fff;
    padding: 1rem; font-size: 0.8125rem;
  }
  .mbot__q {
    margin: 0 0 0.9rem; margin-inline-start: auto; width: fit-content; min-height: 2.2rem;
    border: 1px solid var(--color-line); border-radius: 0.75rem; padding: 0.55rem 0.85rem;
    font-size: 14px; line-height: 24px; color: var(--color-ink);
  }
  .mbot__caret { display: inline-block; width: 1px; height: 1em; background: var(--color-ink); vertical-align: -2px; animation: mbot-caret 1s step-end infinite; }
  .mbot__q[data-done='true'] .mbot__caret { display: none; }
  @keyframes mbot-caret { 50% { opacity: 0; } }

  .mbot__dots { display: flex; gap: 4px; padding: 0.4rem 0; }
  .mbot__dots span { width: 6px; height: 6px; border-radius: 9999px; background: var(--color-ink-4); animation: mbot-dot 1.2s infinite; }
  .mbot__dots span:nth-child(2) { animation-delay: 0.15s; }
  .mbot__dots span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes mbot-dot { 0%,60%,100% { opacity: 0.35; } 30% { opacity: 1; } }

  /* The original's thread scrolls once the follow-up lands, and contains its
     own overscroll so the page does not move with it. */
  .mbot__thread {
    display: flex; flex-direction: column;
    max-height: 582px; overflow-y: auto; overscroll-behavior: contain;
    scroll-behavior: smooth;
  }
  .mbot__legend {
    display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0.5rem 0 0;
    font-size: 12px; color: var(--color-ink-2);
  }
  .mbot__legend span { display: inline-flex; align-items: center; gap: 5px; }
  .mbot__legend i { width: 9px; height: 9px; border-radius: 9999px; }

  .mbot__chart { margin: 0 0 0.75rem; border: 1px solid var(--color-line); border-radius: 0.625rem; padding: 0.7rem; }
  .mbot__chart figcaption { margin-bottom: 0.4rem; font-weight: 700; }
  .mbot__chart svg { width: 100%; height: auto; }

  .mbot__source { margin-bottom: 0.75rem; border: 1px solid var(--color-line); border-radius: 0.625rem; }
  /* Measured on the original: the card header is 12px, the model name 14/16
     and its library 12/16 -- three sizes, not the one the base was giving. */
  .mbot__source-head {
    margin: 0; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--color-line);
    font-size: 12px; font-weight: 700; color: var(--color-ink);
  }
  .mbot__source-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.6rem 0.7rem; }
  .mbot__source-row svg { width: 16px; height: 16px; color: var(--color-brand); flex-shrink: 0; }
  .mbot__source-row b { display: block; font-size: 14px; line-height: 16px; font-weight: 700; color: var(--color-ink); }
  .mbot__source-row small { font-size: 12px; line-height: 16px; color: var(--color-ink-2); }
  .mbot__votes { margin-inline-start: auto; display: flex; gap: 0.3rem; }
  .mbot__votes button { border: 0; background: none; cursor: pointer; opacity: 0.5; font-size: 0.875rem; }
  .mbot__votes button:hover, .mbot__votes button[data-on='true'] { opacity: 1; }

  /* 14/24 in primary ink, which is what the original sets for the whole
     exchange -- question, finding and reasoning alike. */
  .mbot__lead p, .mbot__answer p {
    margin: 0 0 0.75rem; font-size: 14px; line-height: 24px; color: var(--color-ink);
  }
  .mbot__lead p:last-child, .mbot__answer p:last-child { margin-bottom: 0; }
  .mbot__lead strong { font-weight: 700; }
  .mbot__answer a { color: var(--color-brand); }
  /* The @-reference to a saved question reads as a chip rather than a link. */
  .mbot__mention {
    border-radius: 4px; background: var(--color-surface); padding: 1px 5px;
    color: var(--color-ink); white-space: nowrap;
  }

  .mbot__ask {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    margin: 0.9rem 0 0; border: 1px solid var(--color-line); border-radius: 9999px;
    padding: 0.6rem 0.9rem; color: var(--color-ink-3);
  }
  .mbot__ask svg { width: 15px; height: 15px; color: var(--color-brand); }
</style>

<script>
  const QUESTION = 'Which source added the most accounts in 2026?';

  document.querySelectorAll<HTMLElement>('[data-mbot]').forEach((root) => {
    /* Declared here rather than taken from the frontmatter: this script is a
       separate scope and never sees the module's constants. */
    const TURN1 = 'show me orders over time';
    const TURN2 = 'break this down by product type';

    const thread = root.querySelector<HTMLElement>('[data-mbot-thread]')!;
    const pick = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;

    /* Two turns, each the same five beats: type, think, chart, source, answer. */
    const turns = [
      { text: TURN1,
        q: pick<HTMLElement>('[data-mbot-q]'),
        typed: pick<HTMLElement>('[data-mbot-typed]'),
        dots: pick<HTMLElement>('[data-mbot-dots]'),
        parts: ['[data-mbot-chart]', '[data-mbot-source]', '[data-mbot-answer]'].map((x) => pick<HTMLElement>(x)),
        lines: [...root.querySelectorAll<SVGPolylineElement>('[data-mbot-chart] .mbot__line')] },
      { text: TURN2,
        q: pick<HTMLElement>('[data-mbot-q2]'),
        typed: pick<HTMLElement>('[data-mbot-typed2]'),
        dots: pick<HTMLElement>('[data-mbot-dots2]'),
        parts: ['[data-mbot-chart2]', '[data-mbot-source2]', '[data-mbot-answer2]'].map((x) => pick<HTMLElement>(x)),
        lines: [...root.querySelectorAll<SVGPolylineElement>('[data-mbot-chart2] .mbot__line')] },
    ];

    root.querySelectorAll<HTMLButtonElement>('[data-vote]').forEach((b) =>
      b.addEventListener('click', () => {
        const scope = b.closest('.mbot__source')!;
        scope.querySelectorAll<HTMLElement>('[data-vote]').forEach((o) => (o.dataset.on = 'false'));
        b.dataset.on = 'true';
      })
    );

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const toBottom = () => { thread.scrollTop = thread.scrollHeight; };

    function draw(lines: SVGPolylineElement[]) {
      for (const l of lines) {
        const len = l.getTotalLength();
        l.style.strokeDasharray = String(len);
        l.style.strokeDashoffset = String(len);
        requestAnimationFrame(() => { l.style.strokeDashoffset = '0'; });
      }
    }

    function showAll() {
      for (const t of turns) {
        t.typed.textContent = t.text;
        t.q.dataset.done = 'true';
        t.q.hidden = false;
        t.dots.hidden = true;
        t.parts.forEach((el) => (el.hidden = false));
        t.lines.forEach((l) => { l.style.strokeDasharray = ''; l.style.strokeDashoffset = ''; });
      }
    }

    async function playTurn(t: typeof turns[number], first: boolean) {
      t.q.hidden = false;
      t.typed.textContent = '';
      t.q.dataset.done = 'false';
      for (let i = 1; i <= t.text.length; i++) {
        t.typed.textContent = t.text.slice(0, i);
        if (!first) toBottom();
        await sleep(42);
      }
      t.q.dataset.done = 'true';
      await sleep(350);

      t.dots.hidden = false; toBottom();
      await sleep(1100);
      t.dots.hidden = true;

      const [chart, source, answer] = t.parts;
      chart.hidden = false; toBottom();
      draw(t.lines);
      await sleep(900);
      source.hidden = false; toBottom();
      await sleep(450);
      answer.hidden = false; toBottom();
    }

    async function play() {
      for (const t of turns) {
        t.q.hidden = t !== turns[0];
        t.dots.hidden = true;
        t.parts.forEach((el) => (el.hidden = true));
      }
      await playTurn(turns[0], true);
      await sleep(1400);
      await playTurn(turns[1], false);
    }

    if (reduced) { showAll(); return; }

    let played = false;
    new IntersectionObserver((entries, obs) => {
      for (const e of entries) {
        if (e.isIntersecting && !played) { played = true; play(); obs.disconnect(); }
      }
    }, { threshold: 0.45 }).observe(root);
  });
</script>
