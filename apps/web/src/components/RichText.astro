---
/** Renders Strapi's `blocks` rich text. Covers what the seeded content uses. */
import type { Block, Inline } from '../lib/types';

interface Props { blocks: Block[] }
const { blocks = [] } = Astro.props;

const inlines = (children: unknown[] = []) => (children as Inline[]).filter((c) => c?.type === 'text');
---
<div class="prose-mb">
  {blocks.map((block) => {
    if (block.type === 'heading') {
      const level = Math.min(Math.max((block as any).level ?? 2, 2), 4);
      const Tag = `h${level}` as 'h2' | 'h3' | 'h4';
      return <Tag>{inlines(block.children).map((c) => (c.bold ? <strong>{c.text}</strong> : c.text))}</Tag>;
    }
    if (block.type === 'list') {
      const items = ((block as any).children ?? []) as { children: Inline[] }[];
      const ordered = (block as any).format === 'ordered';
      const Tag = ordered ? 'ol' : 'ul';
      return (
        <Tag class={ordered ? 'list-decimal' : 'list-disc'}>
          {items.map((li) => (
            <li>{inlines(li.children).map((c) => (c.bold ? <strong>{c.text}</strong> : c.text))}</li>
          ))}
        </Tag>
      );
    }
    return <p>{inlines((block as any).children).map((c) => (c.bold ? <strong>{c.text}</strong> : c.text))}</p>;
  })}
</div>
