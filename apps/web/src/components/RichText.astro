---
/** Renders Strapi's `blocks` rich text. Covers what the seeded content uses. */
import Inlines from './Inlines.astro';
import type { Block, Inline } from '../lib/types';

// The original sets article body copy in Merriweather at 18px/32px
// (.prose p, .prose li in its global.css). Imported here rather than in the
// layout so Astro only ships it on pages that actually render prose — the
// listing pages do not pay for it.
import '@fontsource/merriweather/latin-400.css';
import '@fontsource/merriweather/latin-700.css';

/*
 * `variant` picks the measure: the blog sets body copy in Merriweather 18/32,
 * but the case-study pages are Lato 18/26 in secondary ink. Same markup, two
 * different type settings on the original.
 */
interface Props { blocks: Block[]; variant?: 'serif' | 'sans' }
const { blocks = [], variant = 'serif' } = Astro.props;

---
<div class:list={[variant === 'serif' ? 'prose-mb' : 'prose-cs']}>
  {blocks.map((block) => {
    if (block.type === 'heading') {
      const level = Math.min(Math.max((block as any).level ?? 2, 2), 4);
      const Tag = `h${level}` as 'h2' | 'h3' | 'h4';
      return <Tag><Inlines nodes={block.children} /></Tag>;
    }
    if (block.type === 'list') {
      const items = ((block as any).children ?? []) as { children: Inline[] }[];
      const ordered = (block as any).format === 'ordered';
      const Tag = ordered ? 'ol' : 'ul';
      return (
        <Tag class={ordered ? 'list-decimal' : 'list-disc'}>
          {items.map((li) => (
            <li><Inlines nodes={li.children} /></li>
          ))}
        </Tag>
      );
    }
    return <p><Inlines nodes={(block as any).children} /></p>;
  })}
</div>
