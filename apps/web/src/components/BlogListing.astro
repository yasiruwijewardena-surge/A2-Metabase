---
import PostCard from './PostCard.astro';
import type { Category, Post } from '../lib/types';

interface Props { posts: Post[]; categories: Category[]; active?: string | null }
const { posts, categories, active = null } = Astro.props;

const featured = posts.slice(0, 3);
const rest = posts.slice(3);

// "Previous posts", grouped by year, as the original does.
const byYear = new Map<number, Post[]>();
for (const p of rest) {
  const y = new Date(p.publishedDate).getFullYear();
  (byYear.get(y) ?? byYear.set(y, []).get(y)!).push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---
<div class="container-mb pt-10">
  <section class="flex flex-col pb-2 lg:flex-row lg:items-center">
    <h1 class="mb-4 text-4xl lg:mb-0">Blog</h1>
    <div class="mx-8 hidden h-10 w-px bg-(--color-ink-4) lg:block"></div>

    <div class="flex flex-wrap items-center">
      <p class="me-2 mb-2 text-(--color-ink-3) md:me-6">Explore by category:</p>
      <div class="flex flex-row flex-wrap items-center gap-2">
        {/* Plain links, not a JS filter: each category is a real page, so the
            view is shareable, indexable, and works without JavaScript. The
            original toggles DOM visibility with no URL change. */}
        <a
          href="/blog"
          aria-current={active === null ? 'page' : undefined}
          class:list={['pill', active === null && 'pill-on']}
        >All</a>
        {categories.map((c) => (
          <a
            href={`/blog/category/${c.slug}`}
            aria-current={active === c.slug ? 'page' : undefined}
            class:list={['pill', active === c.slug && 'pill-on']}
          >{c.name}</a>
        ))}
      </div>
    </div>
  </section>

  <div class="flex flex-row flex-wrap -mx-3">
    <div class="w-full px-3 lg:w-2/3">
      <section class="pt-8">
        {featured.map((post, i) => <PostCard post={post} featured eager={i === 0} />)}
        {featured.length === 0 && (
          <p class="rounded-lg border border-(--color-line) bg-(--color-brand-faint) p-8 text-center text-(--color-ink-2)">
            No posts in this category yet.
          </p>
        )}
      </section>
    </div>

    <aside class="w-full px-3 lg:w-1/3">
      <div class="sticky top-24 rounded-xl border border-(--color-brand-border) bg-(--color-brand-faint) p-6">
        <h2 class="mb-2 text-lg">Subscribe to newsletter</h2>
        <p class="mb-4 text-sm text-(--color-ink-2)">Updates and news from Metabase.</p>
        <form class="flex gap-2" onsubmit="event.preventDefault()">
          <label for="nl" class="sr-only">Email address</label>
          <input id="nl" type="email" required placeholder="you@company.com"
                 class="min-w-0 flex-1 rounded-md border border-(--color-line) px-3 py-2 text-sm" />
          <button type="submit" class="rounded-md bg-(--color-brand) px-3 py-2 text-sm font-bold text-white hover:bg-(--color-brand-hover)">
            Sign up
          </button>
        </form>
      </div>
    </aside>
  </div>

  {years.length > 0 && (
    <section class="py-12">
      <h2 class="mb-6 text-2xl">Previous posts</h2>
      {years.map((year) => (
        <div class="mb-10">
          <h3 class="mb-4 text-lg text-(--color-ink-3)">{year}</h3>
          <ul class="grid gap-x-10 gap-y-5 md:grid-cols-2">
            {byYear.get(year)!.map((p) => (
              <li class="border-b border-(--color-line) pb-4">
                <a href={`/blog/${p.slug}`} class="font-bold leading-snug hover:text-(--color-brand-hover)">{p.title}</a>
                <p class="mt-1 text-sm text-(--color-ink-3)">
                  {new Date(p.publishedDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                  {p.category && <> in {p.category.name}</>}
                  {p.readTimeMinutes && <> ‧ {p.readTimeMinutes} min read</>}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}
</div>

<style>
  .pill {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--color-surface);
    color: var(--color-brand-strong);
    font-size: 0.9375rem;
    transition: background-color 120ms, color 120ms;
  }
  .pill:hover { background: var(--color-brand); color: #fff; }
  .pill-on { background: var(--color-brand-strong); color: #fff; }
</style>
