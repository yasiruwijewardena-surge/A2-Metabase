---
import PostCard from './PostCard.astro';
import type { Category, Post, Tag } from '../lib/types';

interface Props {
  posts: Post[];
  categories: Category[];
  tags?: Tag[];
  activeCategory?: string | null;
  activeTag?: string | null;
}
const {
  posts, categories, tags = [], activeCategory = null, activeTag = null,
} = Astro.props;

/**
 * The original orders its category chips editorially, not alphabetically:
 * Analytics and BI, News, Engineering, Product, Data explorations,
 * Using Metabase. Strapi has no field for that, so the order lives here and
 * anything unlisted falls to the end rather than disappearing.
 */
const CATEGORY_ORDER = [
  'analytics-and-bi', 'news', 'engineering', 'product',
  'data-explorations', 'using-metabase',
];
const ordered = [...categories].sort(
  (a, b) =>
    (CATEGORY_ORDER.indexOf(a.slug) + 1 || 99) - (CATEGORY_ORDER.indexOf(b.slug) + 1 || 99),
);

/* The original's sidebar lists recent releases. Not modelled in Strapi — a
   release-notes type would be the proper home for this if the scope grew. */
const releases = [
  { date: 'Jul 2026', title: 'Metabase 63', body: 'A whole lot of wishlist items: treemap charts, 2FA, PDFs in dashboard subscriptions, one-step dashboard viewer invites, and more.' },
  { date: 'Jun 2026', title: 'Metabase 62', body: 'A plugin SDK for building any chart type, interactive charts from the MCP server, the Metabase CLI for terminal-native workflows, and an interactive Schema Viewer.' },
  { date: 'May 2026', title: 'Metabase 61', body: 'Granular AI controls, token and message limits, Metabot customization with system prompts, AI usage analytics, and dashboards-as-code.' },
];

const featured = posts.slice(0, 3);
const rest = posts.slice(3);

// "Previous posts", grouped by year, as the original does.
const byYear = new Map<number, Post[]>();
for (const p of rest) {
  const y = new Date(p.publishedDate).getFullYear();
  (byYear.get(y) ?? byYear.set(y, []).get(y)!).push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---
<div class="page-tint">
<div class="container-mb pt-4">
  <section class="flex flex-col pt-8 pb-0 lg:flex-row lg:items-center">
    <h1 class="mb-4 text-[2.25rem] leading-[1.11] font-black lg:mb-0">Blog</h1>
    <div class="mx-8 hidden h-10 w-px bg-(--color-ink-4) lg:block"></div>

    <div class="flex flex-wrap items-center">
      <p class="me-2 mb-2 text-(--color-ink-3) md:me-6">Explore by category:</p>
      <div class="flex flex-row flex-wrap items-center gap-2">
        {/* Plain links, not a JS filter: each category is a real page, so the
            view is shareable, indexable, and works without JavaScript. The
            original toggles DOM visibility with no URL change. */}
        <a
          href="/blog"
          aria-current={activeCategory === null && activeTag === null ? 'page' : undefined}
          class:list={['pill', activeCategory === null && activeTag === null && 'pill-on']}
        >All</a>
        {ordered.map((c) => (
          <a
            href={`/blog/category/${c.slug}`}
            aria-current={activeCategory === c.slug ? 'page' : undefined}
            class:list={['pill', activeCategory === c.slug && 'pill-on']}
          >{c.name}</a>
        ))}
      </div>
    </div>
  </section>

  <div class="flex flex-row flex-wrap -mx-3">
    <div class="w-full px-3 lg:w-2/3">
      <section class="pt-8 lg:pe-30">
        {featured.map((post, i) => <PostCard post={post} featured eager={i === 0} />)}
        {featured.length === 0 && (
          <p class="rounded-lg border border-(--color-line) bg-(--color-brand-faint) p-8 text-center text-(--color-ink-2)">
            {activeTag ? 'No posts carry this tag yet.' : 'No posts in this category yet.'}
          </p>
        )}
      </section>
    </div>

    <aside class="w-full px-3 pt-8 lg:w-1/3">
      {/* Tags are this build's own second filter dimension -- the original has
          no tags at all -- so they go in the sidebar rather than the header,
          which was matched against the original and stays as it was. */}
      {tags.length > 0 && (
        <nav class="mb-10" aria-label="Filter posts by topic">
          <h2 class="mb-4 text-[1.5rem] leading-[1.33]">Browse by topic</h2>
          <div class="flex flex-row flex-wrap items-center gap-2">
            {tags.map((t) => (
              <a
                href={activeTag === t.slug ? '/blog' : `/blog/tag/${t.slug}`}
                aria-current={activeTag === t.slug ? 'page' : undefined}
                class:list={['pill', activeTag === t.slug && 'pill-on']}
              >{t.name}</a>
            ))}
          </div>
        </nav>
      )}

      <h2 class="mb-6 text-[1.5rem] leading-[1.33]">Releases</h2>
      <ul class="mb-10 space-y-7">
        {releases.map((r) => (
          <li>
            <p class="mb-1 text-base text-(--color-ink-3)">{r.date}</p>
            <h3 class="mb-2 text-[1.5rem] leading-[1.33] font-bold">{r.title}</h3>
            <p class="text-base text-(--color-ink-2)">{r.body}</p>
          </li>
        ))}
      </ul>

      <div class="rounded-lg bg-(--color-brand-faint) p-6">
        <h2 class="mb-2 text-[1.5rem] leading-[1.33]">Subscribe to our newsletter</h2>
        <p class="mb-4 text-base text-(--color-ink-2)">
          Stay in touch with updates and news from Metabase. No spam, ever.
        </p>
        <form class="space-y-3" onsubmit="event.preventDefault()">
          <label for="nl" class="sr-only">Email address</label>
          <input id="nl" type="email" required placeholder="Email Address"
                 class="w-full rounded-md border border-(--color-line) bg-white px-4 py-3 text-base" />
          <button type="submit" class="w-full rounded-md bg-(--color-brand-hover) px-4 py-3 text-base font-bold text-white transition-colors hover:bg-(--color-brand-strong)">
            Sign Up
          </button>
        </form>
      </div>
    </aside>
  </div>

  {years.length > 0 && (
    <section class="py-12">
      <h2 class="mb-6 text-2xl">Previous posts</h2>
      {years.map((year) => (
        <div class="mb-10">
          <h3 class="mb-4 text-lg text-(--color-ink-3)">{year}</h3>
          <ul class="grid gap-x-10 gap-y-5 md:grid-cols-2">
            {byYear.get(year)!.map((p) => (
              <li class="border-b border-(--color-line) pb-4">
                <a href={`/blog/${p.slug}`} class="font-bold leading-snug hover:text-(--color-brand-hover)">{p.title}</a>
                <p class="mt-1 text-sm text-(--color-ink-3)">
                  {new Date(p.publishedDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                  {p.category && <> in {p.category.name}</>}
                  {p.readTimeMinutes && <> ‧ {p.readTimeMinutes} min read</>}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}
</div>
</div>
