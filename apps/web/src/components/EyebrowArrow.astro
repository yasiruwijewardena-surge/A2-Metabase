---
/*
 * The circled arrow that follows each section eyebrow link. Traced off the
 * original: a 24-unit viewBox scaled to 28px, with the disc painted in the
 * faint blue and the chevron stroked at 1.5 in brand blue.
 */
---

<svg class="eyebrow-arrow" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <rect width="24" height="24" rx="12" fill="#eef6fc" />
  <path d="M13.6667 8.5L17.3334 12L13.6667 15.5" stroke="#509EE3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M17.1667 12H7.66669" stroke="#509EE3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
</svg>
