---
/*
 * The 22px line icons above the Embedded Analytics supporting points.
 *
 * Artwork comes from the CMS as the `feature` icon set, so a new point can
 * bring its own icon without a code change.
 */
import { resolveIcon } from '../lib/icons';

interface Props { name: string }
const { name } = Astro.props;

const icon = name ? await resolveIcon(name, 'feature') : undefined;
---
{icon && (
  <svg width="22" height="22" viewBox={icon.box} fill="none" aria-hidden="true"
       set:html={icon.body} />
)}
