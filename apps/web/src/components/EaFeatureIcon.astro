---
/*
 * The three 22px line icons above the Embedded Analytics supporting points,
 * traced off the original: a code-window, a package and a shield-check, all
 * stroked at 1.6 in the inherited colour.
 */
interface Props { name: 'window' | 'package' | 'shield'; }
const { name } = Astro.props;
---

<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {name === 'window' && (
    <>
      <rect x="3" y="4.5" width="18" height="15" rx="2.5" stroke="currentColor" stroke-width="1.6" />
      <path d="M7 10l2.5 2L7 14M12.5 14.5h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === 'package' && (
    <>
      <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M4 7.5l8 4.5 8-4.5M12 12v9" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    </>
  )}
  {name === 'shield' && (
    <>
      <path d="M12 3l7 2.5v5.5c0 4.2-2.9 7.4-7 8.5-4.1-1.1-7-4.3-7-8.5V5.5L12 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
</svg>
