---
import CldImage from './CldImage.astro';
import type { CaseStudy, Industry, UseCase } from '../lib/types';

interface Props {
  cases: CaseStudy[];
  industries: Industry[];
  useCases: UseCase[];
  activeIndustry?: string | null;
  activeUseCase?: string | null;
}
const { cases, industries, useCases, activeIndustry = null, activeUseCase = null } = Astro.props;

/**
 * Both filter dimensions are real URLs, generated at build time, so a filtered
 * view is shareable and indexable and needs no JavaScript. The original filters
 * by toggling DOM visibility, which leaves 17 industries with no page of their
 * own (SITE-ANALYSIS.md §6.4).
 */
const href = (useCase: string | null, industry: string | null) => {
  if (useCase && industry) return `/case-studies/use-case/${useCase}/industry/${industry}`;
  if (useCase) return `/case-studies/use-case/${useCase}`;
  if (industry) return `/case-studies/industry/${industry}`;
  return '/case-studies';
};

// Counts come from the data, so an industry with nothing to show is never
// offered as a filter — another thing the original gets wrong, where 11 of its
// 17 industry buttons return a single result.
/*
 * The card is a 167px media panel, the claim sentence and the link — no
 * border, no eyebrow, no metrics, matching the original. Metrics stay on the
 * case-study page, which is where the original puts them too.
 */
const countFor = (industrySlug: string) =>
  cases.filter((c) => c.company?.industry?.slug === industrySlug).length;
---
<div class="container-mb pt-12">
  <header class="mx-auto mb-2 flex max-w-[760px] flex-col items-center text-center">
    <h1 class="mb-3 text-4xl leading-[1.11] font-black">Real companies, real data, real stories</h1>
    <p class="m-0 max-w-[540px] text-base leading-6">
      Over 100,000 organizations use Metabase to make working with data easy for everyone on
      their team. Explore what real businesses have built with Metabase.
    </p>
  </header>

  <section id="browser" aria-label="Customer stories" class="mt-9 mb-[72px] rounded-xl border border-(--color-brand-border) p-6">
    <div
      class="mx-auto mt-[-44px] mb-10 grid w-full max-w-[600px] grid-cols-3 gap-1 rounded-lg border border-(--color-brand-soft) bg-white p-1"
      role="group" aria-label="Filter by use case"
    >
      <a href={href(null, activeIndustry)} aria-current={!activeUseCase ? 'page' : undefined}
         class:list={['seg', !activeUseCase && 'seg-on']}>All</a>
      {useCases.map((u) => (
        <a href={href(u.slug, activeIndustry)} aria-current={activeUseCase === u.slug ? 'page' : undefined}
           class:list={['seg', activeUseCase === u.slug && 'seg-on']}>{u.name}</a>
      ))}
    </div>

    <div class="mb-8 flex flex-wrap justify-center gap-3" role="group" aria-label="Filter by industry">
      <a href={href(activeUseCase, null)} aria-current={!activeIndustry ? 'page' : undefined}
         class:list={['pill', !activeIndustry && 'pill-on']}>All Stories</a>
      {industries.map((i) => (
        <a href={href(activeUseCase, i.slug)} aria-current={activeIndustry === i.slug ? 'page' : undefined}
           class:list={['pill', activeIndustry === i.slug && 'pill-on']}>
          {i.name}
        </a>
      ))}
    </div>

    <p class="mb-6 text-center text-sm text-(--color-ink-3)" aria-live="polite">
      {cases.length} {cases.length === 1 ? 'story' : 'stories'}
    </p>

    {cases.length === 0 ? (
      <p class="rounded-lg bg-(--color-brand-faint) p-10 text-center text-(--color-ink-2)">
        No stories match that combination yet.
      </p>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {cases.map((c, i) => (
          <article class="cs-card">
            <div class="cs-card-media">
              <CldImage
                image={c.heroImage}
                widths={[300, 480, 760]}
                sizes="(max-width: 768px) 100vw, 390px"
                ratio={16 / 9}
                priority={i === 0}
                class="cs-card-img"
              />
            </div>
            <p class="cs-card-claim">{c.title}</p>
            <a href={`/case-studies/${c.slug}`} class="cs-card-link">
              Read the case study
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M5.5 3.5L9 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</div>

<style>
  /* Measured off the original: a 167px media panel at a 12px radius, the claim
     sentence at 16/24 twelve clear of it, then the link. */
  .cs-card { border-radius: 12px; background: #fff; padding-bottom: 12px; }
  .cs-card-media {
    display: flex; align-items: center; justify-content: center; overflow: hidden;
    width: 100%; height: 167px; border-radius: 12px; background: var(--color-brand-faint);
  }
  .cs-card-img { width: 100%; height: 100%; object-fit: cover; }
  .cs-card-claim { margin: 12px 0; font-size: 16px; line-height: 24px; color: var(--color-ink); }
  /* The original's #509ee3 is 3.1:1 at 16px bold on white. */
  .cs-card-link {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 16px; line-height: 24px; font-weight: 700; color: var(--color-brand-hover);
  }
  .cs-card-link:hover { text-decoration: underline; }

  .seg {
    display: grid; place-items: center; height: 34px;
    border-radius: 0.375rem; font-size: 0.9375rem; font-weight: 700;
    color: var(--color-brand-strong); transition: background-color 120ms, color 120ms;
  }
  .seg:hover { background: var(--color-brand-muted); }
  .seg-on { background: var(--color-brand-muted); }
  .pill {
    border-radius: 0.5rem; background: var(--color-surface);
    padding: 0.5rem 0.75rem; font-size: 0.9375rem; color: var(--color-brand-strong);
    transition: background-color 120ms, color 120ms;
  }
  .pill:hover { background: var(--color-brand); color: #fff; }
  .pill-on { background: var(--color-brand-strong); color: #fff; }
</style>
