---
/*
 * /events
 *
 * Measured off the original at 1512 with `npm run metrics`, `npm run assets`
 * and a hover/click probe. The numbers below are read, not guessed:
 *
 *   .upcoming-events  #fafbfe, padding 64/32/96, column, centred
 *     > .hero         max-width 580, margin-block 64, padding-inline 32
 *         h1 48/57.6/900 #22242b mb 8, h2 20/28/400 #5a6072 mb 8
 *   .past-events      white, padding 0/0/96
 *     > .hero         max-width 580, padding-block 64
 *         h2 36/43.2/900 mb 8, p 20/28/400 mb 16,
 *         p 16/26/700 "Pick a series" mt 32 mb 16 with a curved arrow
 *     > carousel      1512x480, relative, clipped, margin-top -45
 *         track       absolute, inset-block 65, 350 tall, gap 32, pad-left 312
 *         card        280x350 r16, cover, shadow 16/24/40 .05 0 1 2
 *                     hover: translateY(-65px), shadow .094 0 8 8 -4
 *         tagline     absolute inset 0, flex-end, p 18/26/400 centred #5a6072
 *                     rest opacity 0 translateY(20), hover opacity 1 translateY(0)
 *                     transition opacity/transform .3s ease-in-out
 *         fader       two 90px white edge gradients, pointer-events none
 *     > .events-entry 800x210 white r24, 1px #e4ecfb, pad 24, gap 24, mb 24
 *         img 160x160 r12, p 16/24/400 #8d93a5, h3 24/32/700 #22242b,
 *         button pad 12/18 r8 #509ee3 white 16/24/700
 *         hover: bg #fcfcfd, border #c2daf0, button #1c6bb0
 *
 * Both bands use the same card; only the date format and the button label
 * differ ("Register now" with a full date, "Learn more" with "30 Sept 2026").
 *
 * The original filters the recordings in JavaScript: clicking a poster shows
 * only that series, and clicking it again shows everything. Here the posters
 * are labels for hidden checkboxes read with `:has()`, so the behaviour is the
 * same -- including toggling back off -- with no JavaScript and no reload.
 *
 * Both images come from Strapi, off the category rather than the event: the
 * original keys its artwork by strand, so storing it per event would be the
 * same picture eighteen times. They are fixed crops, so they are requested at
 * exactly the box they fill at 1x and 2x rather than through a width srcset.
 */
import { getEvents, getEventCategories } from '../../lib/strapi';
import { cld } from '../../lib/image';
import type { StrapiImage, PageSection } from '../../lib/types';

interface Props { section: PageSection }
const { section: s } = Astro.props;

const [events, series] = await Promise.all([getEvents(), getEventCategories()]);

const now = Date.now();
const upcoming = events
  .filter((e) => new Date(e.startsAt).getTime() >= now)
  .sort((a, b) => +new Date(a.startsAt) - +new Date(b.startsAt));
const past = events
  .filter((e) => new Date(e.startsAt).getTime() < now)
  .sort((a, b) => +new Date(b.startsAt) - +new Date(a.startsAt));

/* Conferences and partner tech talks have a poster but no square -- neither has
 * run an event yet, so the original never drew one. Falling back beats a gap. */
const square = (c?: { artwork?: StrapiImage | null; poster?: StrapiImage | null } | null) =>
  c?.artwork?.url ?? c?.poster?.url ?? null;

const crop = (url: string, w: number, h: number, scale = 1) =>
  cld(url, `f_auto,q_auto,c_fill,w_${w * scale},h_${h * scale}`);

/* A series with no recording yet is still a poster, as on the original, but
 * picking it would leave the list empty with nothing to explain why. */
const empty = series.filter((s) => !past.some((e) => e.category?.slug === s.slug));

/* One loop is the width of a single copy of the row: each slide is 280 wide
 * with 32 of gap. The row is rendered twice so the wrap has no seam. */
const LOOP = series.length * (280 + 32);
const SECONDS = LOOP / 60; /* the 60px a second the original runs at */

const filterCss = [
  /* Nothing picked shows everything. Once anything is picked, hide the lot and
   * put back only the series that are checked -- which stays correct if more
   * than one ends up checked. */
  `.ev:has(.ev-pick-input:checked) .ev-card--past{display:none}`,
  ...series.map((s) =>
    `.ev:has(#es-${s.slug}:checked) .ev-card--past[data-series="${s.slug}"]{display:flex}`),
  /* The original gives the picked poster no marker of its own, so it borrows
   * the hover treatment rather than inventing a new one. */
  ...series.map((s) =>
    `.ev:has(#es-${s.slug}:checked) .ev-slide[data-series="${s.slug}"] .ev-poster` +
    `{transform:translateY(-65px);box-shadow:0 8px 8px -4px rgb(16 24 40 / 0.094)}` +
    `.ev:has(#es-${s.slug}:checked) .ev-slide[data-series="${s.slug}"] .ev-tagline` +
    `{opacity:1;transform:translateY(0)}`),
  ...empty.map((s) => `.ev:has(#es-${s.slug}:checked) .ev-empty{display:block}`),
].join('');

/* The original prints the viewer's own timezone from the browser. A static
 * build has no viewer, so this is fixed to UTC and says so, rather than
 * silently baking in the build machine's clock. */
const fmtFull = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', {
    weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    hour: '2-digit', minute: '2-digit', timeZone: 'UTC', hour12: false,
  }).format(new Date(iso)) + ' (UTC)';

/* Recordings carry the short form the original uses: "30 Sept 2026". */
const fmtShort = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
  }).format(new Date(iso));
---
  <div class="ev">
    <section class="ev-upcoming">
      <div class="ev-head">
        <h1 class="ev-h1">{s.heading}</h1>
        <h2 class="ev-sub">{s.standfirst}</h2>
      </div>

      {upcoming.length === 0 ? (
        <p class="ev-none">{s.noUpcoming}</p>
      ) : upcoming.map((e, i) => (
        <a class="ev-card" href={e.registrationUrl ?? `/events/${e.slug}`}>
          {square(e.category) && (
            <img class="ev-thumb" src={crop(square(e.category)!, 160, 160)}
                 srcset={`${crop(square(e.category)!, 160, 160)} 1x, ${crop(square(e.category)!, 160, 160, 2)} 2x`}
                 width="160" height="160" alt=""
                 loading={i === 0 ? 'eager' : 'lazy'}
                 fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" />
          )}
          <div class="ev-body">
            <p class="ev-date">{fmtFull(e.startsAt)}</p>
            <h3 class="ev-title">{e.title}</h3>
            <span class="ev-btn">{s.upcomingCta}</span>
          </div>
        </a>
      ))}
    </section>

    <section class="ev-watch">
      <div class="ev-watch-head">
        <h2 class="ev-watch-h">{s.watchHeading}</h2>
        <p class="ev-watch-sub">{s.watchStandfirst}</p>
        <p class="ev-pick">
          <svg class="ev-pick-arrow" width="15" height="18" viewBox="0 0 15 18" fill="none"
               stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true">
            <path d="M6.6 14.4S5.39 12.87 5.39 6.19C5.39-.49 13.9 1.64 13.9 1.64" />
            <path d="M10.42 10.26 7.21 16.12 1.5 12.64" />
          </svg>
          {s.pickLabel}
        </p>
      </div>

      {/* The posters are labels for these. Checkboxes rather than radios so a
          second click clears the filter, as the original does. */}
      <fieldset class="ev-picker">
        <legend>Pick a series to filter the recordings</legend>
        {series.map((s) => (
          <input class="ev-pick-input" type="checkbox" id={`es-${s.slug}`} />
        ))}
      </fieldset>

      <div class="ev-carousel">
        <div class="ev-track" style={`--ev-loop:${LOOP}px;--ev-dur:${SECONDS}s`}>
          {[0, 1].map((copy) => series.map((s) => (
            <div class="ev-slide" data-series={s.slug} aria-hidden={copy === 1 ? 'true' : undefined}>
              <span class="ev-tagline"><span>{s.description}</span></span>
              <label class="ev-poster" for={`es-${s.slug}`}
                     style={s.poster?.url
                       ? `--ev-art:url(${crop(s.poster.url, 280, 350)});` +
                         `--ev-art:image-set(url(${crop(s.poster.url, 280, 350)}) 1x,` +
                         ` url(${crop(s.poster.url, 280, 350, 2)}) 2x)`
                       : undefined}>
                <span class="sr-only">{s.name}</span>
              </label>
            </div>
          )))}
        </div>
        <div class="ev-fade" aria-hidden="true"></div>
      </div>

      <p class="ev-empty">{s.noRecordings}</p>

      <div class="ev-list">
        {past.map((e) => (
          <a class="ev-card ev-card--past" href={e.recordingUrl ?? `/events/${e.slug}`}
             data-series={e.category?.slug}>
            {square(e.category) && (
              <img class="ev-thumb" src={crop(square(e.category)!, 160, 160)}
                   srcset={`${crop(square(e.category)!, 160, 160)} 1x, ${crop(square(e.category)!, 160, 160, 2)} 2x`}
                   width="160" height="160" alt="" loading="lazy" decoding="async" />
            )}
            <div class="ev-body">
              <p class="ev-date">{fmtShort(e.startsAt)}</p>
              <h3 class="ev-title">{e.title}</h3>
              <span class="ev-btn">{s.watchCta}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
  <style set:html={filterCss} is:inline></style>
