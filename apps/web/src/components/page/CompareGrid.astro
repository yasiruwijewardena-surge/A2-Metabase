---
/*
 * /features/data-segregation
 *
 * Measured off the original at 1512 with `npm run metrics --root
 * div.data-segregation`:
 *   hero band  #fafbfe with a 1px bottom border, 1059 tall
 *     eyebrow  h2 18/26/700 muted, margin 64 top / 8 bottom
 *     h1       592 36/40/900 centred, mb 16
 *     lede     592 18/26 centred
 *     switcher 946x42, r8, 1px, padding 4, mt 24; four 32-tall tabs at
 *              16px/700 padded 4/16, r4, the open one on #eef6fc
 *     diagram  1264x562 per tab, then an 800-wide 18/26 line and a
 *              16/24/700 link, the link margined 12 top / 96 bottom
 *   compare    h3 1264 36/40/900 mb 8, then a 1264 grid, r12, 1px, mt 64:
 *              a label row then four rows of 330 + 4x233 cells, each cell
 *              bordered top and right and padded 16/24
 *   final CTA  #fafbfe, mt 80, padding 80/76, h3 36/48 mb 24, 600-wide
 *              18/32 mb 16, then a 14/21 button padded 16/24
 *
 * The original's tabs are href="#" and swap the panel with JavaScript.
 * Here they are radio inputs read with `:has()`, so the switcher works
 * before anything hydrates.
 *
 * Method names, their subtitles and the comparison column labels are the
 * original's, since they are what the page is for. The prose in the cells
 * is written here.
 */
import type { PageSection } from '../../lib/types';

interface Props { section: PageSection }
const { section: s } = Astro.props;
const tabs = s.tabs ?? [];
const columns = s.columns ?? [];
const rows = s.rows ?? [];
---
  <div class="dseg">
    <div class="ds-hero">
      <div class="container-mb ds-hero-inner">
        <h2 class="ds-eyebrow">{s.eyebrow}</h2>
        <h1 class="ds-h1">{s.heading}</h1>
        <p class="ds-lede">{s.standfirst}</p>

        <div class="ds-switch">
          {tabs.map((t, i) => (
            <input class="ds-radio" type="radio" name="ds-tab" id={`ds-${t.anchor}`} checked={i === 0} />
          ))}
          <div class="ds-tabs" aria-label="Segregation method">
            {tabs.map((t) => (
              <label class="ds-tab" for={`ds-${t.anchor}`} data-tab={t.anchor}>{t.label}</label>
            ))}
          </div>
          {tabs.map((t) => (
            <div class="ds-panel" data-tab={t.anchor}>
              <picture>
                <source media="(max-width: 767px)" srcset={`/images/data-segregation/${t.image}-mobile.webp`} />
                <img src={`/images/data-segregation/${t.image}.svg`} alt={`How ${t.label.toLowerCase()} works`}
                     width="1264" height="562" loading="lazy" decoding="async" />
              </picture>
              <p class="ds-panel-lede">{t.lede}</p>
              <a class="ds-panel-link" href={`#${t.anchor}`}>{t.linkLabel}</a>
            </div>
          ))}
        </div>
      </div>
    </div>

    <section class="container-mb ds-compare">
      <h2 class="ds-compare-h">Compare</h2>
      <div class="ds-grid" role="table" aria-label="Comparison of data segregation methods">
        <div class="ds-row ds-row--head" role="row">
          <div class="ds-cell ds-cell--name" role="columnheader"><span class="sr-only">Method</span></div>
          {columns.map((c) => <div class="ds-cell" role="columnheader"><b>{c.text}</b></div>)}
        </div>
        {rows.map((r) => (
          <div class="ds-row" role="row">
            <div class="ds-cell ds-cell--name" role="rowheader">
              <b>{r.name}</b>
              {r.sub && <p class="ds-sub">{r.sub}</p>}
            </div>
            <div class="ds-cell" role="cell"><p>{r.mean}</p></div>
            <div class="ds-cell" role="cell"><ul>{(r.when ?? []).map((x) => <li>{x.text}</li>)}</ul></div>
            <div class="ds-cell" role="cell"><p>{r.example}</p></div>
            <div class="ds-cell" role="cell"><ul>{(r.tradeoffs ?? []).map((x) => <li>{x.text}</li>)}</ul></div>
          </div>
        ))}
      </div>
    </section>

    <section class="ds-final">
      <div class="container-mb">
        <h2 class="ds-final-h">{s.ctaHeading}</h2>
        <p class="ds-final-p">{s.ctaBody}</p>
        <a href={s.ctaUrl} class="ds-final-btn">{s.ctaLabel}</a>
      </div>
    </section>
  </div>
