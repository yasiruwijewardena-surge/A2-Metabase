---
/*
 * /roadmap
 *
 * Measured off the original at 1512 with `npm run metrics --root div.roadmap`:
 *   tabs       two pills, 42 tall, r12, padding 8/12, 8 apart; the active one
 *              is brand text on #eef6fc
 *   h1         1264x108 30/36/700, padding 24 top / 48 bottom, mb 8
 *   body       824 main + 232 sidebar inside 1264, so 208 of gutter
 *   group      824 wide, #fafbfe, r12, mb 24, made of
 *                a 73-tall header strip at 20px/700, r12, padding 24, each
 *                  stage in its own pair of colours
 *                a white body padded 24, holding 375-wide item cards two up
 *                  (#fafbfe, r12, 26 apart): strong 20/28/700 with 5 under
 *                  it, then a 16/22 line padded 0/52/16/20
 *   sidebar    three stage buttons (101x37, 16/700), a 182-wide note, then
 *              232-wide white r12 cards padded 24
 *
 * The three stage buttons are a scroll-position indicator on the original
 * (one is brand, the others grey). Reproducing that needs JavaScript to
 * track the viewport, so here they are in-page anchor links instead: the
 * same navigation, and they work before anything hydrates.
 *
 * The item titles are Metabase's own published roadmap, which is factual
 * and public. The one-line descriptions are written here rather than
 * copied, as elsewhere in the replica.
 */
import type { PageSection } from '../../lib/types';

interface Props { section: PageSection }
const { section: s } = Astro.props;
const groups = s.groups ?? [];
---
  <div class="rm">
    <div class="container-mb">
      <nav class="rm-tabs" aria-label="Product updates">
        {(s.tabs ?? []).map((t) => (
          <a href={t.url} class:list={['rm-tab', t.style === 'primary' && 'rm-tab--on']}
             aria-current={t.style === 'primary' ? 'page' : undefined}>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                 stroke-width="1.4" aria-hidden="true">
              {t.style === 'primary'
                ? <path d="M1.5 3.8l4-1.6 5 2 4-1.6v9.6l-4 1.6-5-2-4 1.6zM5.5 2.2v10M10.5 4.2v10"
                        stroke-linecap="round" stroke-linejoin="round" />
                : <path d="M5.2 2v3.2M3.6 3.6h3.2M10 7l1.1 2.9L14 11l-2.9 1.1L10 15l-1.1-2.9L6 11l2.9-1.1z"
                        stroke-linecap="round" stroke-linejoin="round" />}
            </svg>
            {t.label}
          </a>
        ))}
      </nav>

      <h1 class="rm-h1">{s.heading}</h1>

      <div class="rm-body">
        <nav class="rm-rail" aria-label="Jump to a stage">
          {groups.map((g, i) => (
            <a href={`#${g.anchor}`} data-stage={g.anchor}
               class:list={['rm-stage', `rm-stage--${g.tone}`, i === 0 && 'rm-stage--on']}>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor"
                   stroke-width="1.4" aria-hidden="true">
                {i === 0 ? <path d="M7.8 1L2.5 8h3.3l-.6 5L11 6H7.4z" stroke-linejoin="round" />
                 : i === 1 ? <><circle cx="7" cy="7" r="5.6" /><path d="M7 3.8V7l2.2 1.4" stroke-linecap="round" /></>
                 : <path d="M11.6 8.4A5 5 0 015.6 2.4a5 5 0 106 6z" stroke-linejoin="round" />}
              </svg>
              <span>{g.navLabel}</span>
            </a>
          ))}
        </nav>

        <div class="rm-main">
          {/* The groups are wrapped so the spine between the rail and the
              panels can run their full height and stop where they stop, as
              the original's does. */}
          <div class="rm-groups">
          {groups.map((g) => (
            <section class:list={['rm-group', `rm-group--${g.tone}`]} id={g.anchor}>
              <h2 class:list={['rm-group-h', `rm-group-h--${g.tone}`]}>{g.heading}</h2>
              <ul class="rm-items">
                {(g.items ?? []).map((it) => (
                  <li class="rm-item">
                    <strong>{it.title}</strong>
                    {it.pro && (
                      <svg class="rm-gem" width="24" height="24" fill="none" aria-hidden="true">
                        <title>Paid plan</title>
                        <path fill="#fff" fill-rule="evenodd" clip-rule="evenodd"
                              d="m13.921 21.851 8.982-11.842c.55-.725.595-1.715.112-2.487l-2.807-4.493A2.193 2.193 0 0 0 18.348 2H6.001c-.757 0-1.46.39-1.86 1.03L1.333 7.522a2.193 2.193 0 0 0 .113 2.487l8.981 11.842a2.193 2.193 0 0 0 3.495 0Z" />
                        <path fill="#00D5FF" fill-rule="evenodd" clip-rule="evenodd"
                              d="M2.547 8.481a.877.877 0 0 0 .14.714l.013.018 8.77 11.694a.877.877 0 0 0 1.404 0l8.772-11.696a.877.877 0 0 0 .05-.977l-2.631-4.386a.877.877 0 0 0-.752-.426H6.033a.877.877 0 0 0-.753.426L2.648 8.234a.876.876 0 0 0-.1.247ZM6.53 5.176l-1.58 2.632h2.873l.614-2.632H6.53ZM5.155 9.562h2.718l1.942 6.214-4.66-6.214Zm7.017 7.875 2.461-7.875H9.711l2.461 7.875Zm4.3-7.875-1.942 6.214 4.66-6.214h-2.719Zm-.013-1.754-.877-2.632h2.234l1.58 2.632h-2.937Zm-2.727-2.632.878 2.632H9.623l.614-2.632h3.494Z" />
                      </svg>
                    )}
                    <p>{it.body}</p>
                  </li>
                ))}
              </ul>
            </section>
          ))}
          </div>
          <p class="rm-foot">
            {s.footLead}
            <a href={s.footLinkUrl}>
              {s.footLinkLabel}
              <svg width="9" height="16" viewBox="0 0 9 16" fill="none" stroke="currentColor"
                   stroke-width="2" aria-hidden="true"><path d="M1.5 1.5L7 8l-5.5 6.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </p>
        </div>

        <aside class="rm-side">
          {(s.cards ?? []).map((c, i) => (
            <div class:list={['rm-card', i === 0 && 'rm-card--lead']}>
              {i === 0 && <p class="rm-note">{s.note}</p>}
              {c.heading && <h2 class="rm-card-h">{c.heading}</h2>}
              {c.strong && <b>{c.strong}</b>}
              {c.body && <p>{c.body}</p>}
              <a href={c.linkUrl} class="rm-card-link">
                {c.linkLabel}
                <svg width="9" height="16" viewBox="0 0 9 16" fill="none" stroke="currentColor"
                     stroke-width="2" aria-hidden="true"><path d="M1.5 1.5L7 8l-5.5 6.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </div>
          ))}
        </aside>
      </div>
    </div>
  </div>

<script>
  /* Marks the stage whose group is currently in view, which is what the
     original's rail does. Without this the first stage stays marked. */
  const stages = [...document.querySelectorAll<HTMLAnchorElement>('.rm-stage')];
  const groups = stages
    .map((a) => document.getElementById(a.dataset.stage ?? ''))
    .filter((el): el is HTMLElement => el !== null);
  if (stages.length === groups.length && groups.length > 1) {
    const update = () => {
      /* The last group whose top has passed a third of the viewport. */
      let active = 0;
      groups.forEach((g, i) => { if (g.getBoundingClientRect().top < innerHeight / 3) active = i; });
      stages.forEach((a, i) => a.classList.toggle('rm-stage--on', i === active));
      /* The original drops the rail once the panels have scrolled past it. */
      const last = groups[groups.length - 1];
      const rail = stages[0].closest<HTMLElement>('.rm-rail');
      rail?.toggleAttribute('data-done', last.getBoundingClientRect().bottom < innerHeight / 2);
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update, { passive: true });
  }
</script>
