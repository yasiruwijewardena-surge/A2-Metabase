---
/*
 * The glyph above a pillar card.
 *
 * The artwork used to be a hardcoded map here, alongside a second map aliasing
 * the names content actually uses onto it. Both now live in the CMS as the
 * `pillar` icon set, with the aliases flattened into real entries, so the list
 * an editor browses is exactly the list content may ask for.
 *
 * A name with no glyph used to render nothing at all, which left a hole at the
 * top of the card and read as a broken section. Unknown names still fall back
 * to the shield.
 */
import { resolveIcon } from '../../lib/icons';

interface Props { name?: string | null }
const { name } = Astro.props;

const icon = (name ? await resolveIcon(name, 'pillar') : undefined)
  ?? await resolveIcon('shield', 'pillar');
---
{icon && (
  <svg class="pp-pillar-icon" width={icon.box.split(' ')[2] ?? 24} height="24"
       viewBox={icon.box} fill="none" aria-hidden="true" set:html={icon.body} />
)}
