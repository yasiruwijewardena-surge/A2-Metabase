---
/*
 * Pricing.
 *
 * Three independent axes — use case, deployment and billing period. The
 * original holds them as data attributes on <main> and flips them with
 * JavaScript, hiding and showing variants through CSS. Here the controls are
 * real radio inputs and the filtering is done with `:has()`, so the page works
 * with JavaScript switched off and the keyboard and screen-reader behaviour is
 * the browser's own rather than something re-implemented.
 *
 * Plans come from Strapi: one record per tier, declaring which deployments and
 * use cases it belongs to, rather than one record per combination.
 */
import { getPlans, getUseCases, getFaqs, getPricingAddons } from '../../lib/strapi';
import type { PageSection } from '../../lib/types';

interface Props { section: PageSection }
const { section: s } = Astro.props;

const [plans, useCases, faqs, addons] = await Promise.all([
  getPlans(), getUseCases(), getFaqs('pricing'), getPricingAddons(),
]);

const slugOf = (x: string) => x.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
/* The original addresses these by initials -- /pricing?use_case=bi and ?use_case=ea --
   while the collection knows them by slug. Carry both so either form works. */
const codeOf = (name: string) => name.split(/\s+/).map((w) => w[0]).join('').toLowerCase();
const money = (n: number) => `$${n.toLocaleString('en-US')}`;
---
  <div class="pricing container-mb">
    <h1 class="pricing-title">
      <span class="pricing-title-uc" data-uc="business-intelligence">Business intelligence</span>{' '}
      <span class="pricing-title-uc" data-uc="embedded-analytics">Embedded analytics</span>{' '}
      {s.titleSuffix}
    </h1>

    <fieldset class="pricing-axis pricing-axis--uc">
      <legend class="sr-only">What are you pricing?</legend>
      {useCases.map((u, i) => (
        <>
          <input class="sr-only" type="radio" name="use-case" id={`uc-${u.slug}`} value={u.slug}
                 data-code={codeOf(u.name)} checked={i === 0} />
          <label class="pricing-tab" for={`uc-${u.slug}`}>{u.name}</label>
        </>
      ))}
    </fieldset>

    <section class="pricing-row">
      <div class="pricing-label pricing-label--mid"><h2 class="pricing-row-head">{s.deploymentLabel}</h2></div>
      <fieldset class="pricing-deploys">
        <legend class="sr-only">Where should Metabase run?</legend>
        {[
          ['cloud', 'Cloud deployment', 'Metabase handles setup, backups, and upgrades'],
          ['self-hosted', 'Self-hosted', 'Manage your own infrastructure'],
        ].map(([value, title, note], i) => (
          <>
            <input class="sr-only" type="radio" name="deployment" id={`dep-${value}`} value={value} checked={i === 0} />
            <label class="pricing-deploy" for={`dep-${value}`}>
              <span class="pricing-deploy-dot" aria-hidden="true"></span>
              <span>
                <span class="pricing-deploy-title">{title}</span>
                <span class="pricing-deploy-note">{note}</span>
              </span>
            </label>
          </>
        ))}
      </fieldset>
    </section>

    <section class="pricing-row pricing-row--plans">
      <div class="pricing-label">
        <h2 class="pricing-row-head">{s.plansLabel}</h2>
        <fieldset class="pricing-billing">
          <legend class="sr-only">Billing period</legend>
          {[['monthly', 'Monthly billing', null], ['yearly', 'Yearly', 'Save 10%']].map(([value, label, badge], i) => (
            <span class="pricing-billing-opt">
              <input type="radio" name="billing" id={`bill-${value}`} value={value} checked={i === 0} />
              <label for={`bill-${value}`}>
                {label}
                {badge && <span class="pricing-save">{badge}</span>}
              </label>
            </span>
          ))}
        </fieldset>
        <p class="pricing-compare">
          See the full list of features
          <a href="/pricing">Compare plans</a>
        </p>
      </div>

      <div class="pricing-plans">
        {plans.map((p) => (
          <article
            class:list={['plan', p.highlighted && 'plan--on']}
            data-deploy={(p.deployments ?? []).join(' ')}
            data-uc={(p.useCases ?? []).map((u) => u.slug ?? slugOf(u.name)).join(' ')}
          >
            <div class="plan-head">
              <h3 class="plan-name">{p.name}</h3>
              {/* The saving is advertised while you are looking at monthly
                  prices: the yearly rate, with the monthly one struck out. */}
              {p.priceMonthly != null && p.priceYearly != null && p.priceYearly < p.priceMonthly && (
                <span class="plan-save" data-billing="monthly">
                  <s>{money(p.priceMonthly)}</s>{money(p.priceYearly)} / mo.
                </span>
              )}
            </div>

            <p class="plan-price">
              {p.priceMonthly == null ? (
                <span class="plan-price-figure">{p.priceNote}</span>
              ) : (
                <>
                  <span class="plan-price-when" data-billing="monthly">
                    <span class="plan-price-figure">{money(p.priceMonthly)}</span>
                    <span class="plan-price-unit"> / month</span>
                  </span>
                  <span class="plan-price-when" data-billing="yearly">
                    <span class="plan-price-figure">{money(p.priceYearly ?? p.priceMonthly)}</span>
                    <span class="plan-price-unit"> / month</span>
                  </span>
                </>
              )}
            </p>

            <div class="plan-features">
              {p.featuresLead && <p class="plan-lead">{p.featuresLead}</p>}
              <ul>
                {(p.features ?? []).map((f) => (
                  <li>
                    <svg class="plan-bullet" width="4" height="21" viewBox="0 0 4 21" fill="none" aria-hidden="true">
                      <circle cx="2" cy="10.5" r="2" fill="currentColor" />
                    </svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="plan-cta-row">
              {p.cta && (
                <a href={p.cta.url} class:list={[p.cta.style === 'primary' ? 'btn-primary' : 'btn-secondary', 'plan-cta']}>
                  {p.cta.label}
                </a>
              )}
              {p.footnote && <span class="plan-foot">{p.footnote}</span>}
              {p.footnoteSecondary && <span class="plan-foot">{p.footnoteSecondary}</span>}
            </div>
          </article>
        ))}
      </div>
    </section>

    {/*
      Every row below is the same grid: a 240px column, a 24px gap, then the
      content — so every heading lands on the same left edge. The table rows
      fill that column with a tinted panel; the prose sections leave it empty.
    */}
    <section class="pricing-row pricing-row--block">
      <div class="pricing-label"><h2 class="pricing-row-head">{s.usersLabel}</h2></div>
      <div class="pricing-block">
        <p class="pricing-fine">
          Both your internal team developing analytics and users of your embeds accessed
          through your product count as users.
        </p>
        <div class="pricing-users">
          <div>
            <span class="pricing-users-head">Free unlimited users</span>
            <span class="pricing-users-note">Open Source</span>
          </div>
          <div>
            <span class="pricing-users-head">+ $6 per user <i>/ month</i></span>
            <span class="pricing-users-note">$65 per user / year</span>
          </div>
          <div>
            <span class="pricing-users-head">+ $12 per user <i>/ month</i></span>
            <span class="pricing-users-note">First 5 users included in the plan</span>
          </div>
          <div>
            <span class="pricing-users-head">Custom pricing</span>
            <span class="pricing-users-note">First 10 users included in the plan</span>
          </div>
        </div>
      </div>
    </section>

    <p class="pricing-tax">{s.taxNote}</p>

    <section class="pricing-row pricing-sec">
      <div class="pricing-spacer"></div>
      <div class="pricing-narrow">
        <svg class="pricing-squiggle" width="67" height="9" viewBox="0 0 67 9" fill="none" aria-hidden="true">
          <path d="M1 5.5c4-5 8-5 12 0s8 5 12 0 8-5 12 0 8 5 12 0 8-5 12 0"
                stroke="#509EE3" stroke-width="2" stroke-linecap="round" />
        </svg>
        <h2 class="pricing-sec-title">{s.optionalHeading}</h2>
        <p class="pricing-body">{s.optionalBody}</p>
      </div>
    </section>

    <section class="pricing-row pricing-sec">
      <div class="pricing-label"><h2 class="pricing-row-head">{s.usageLabel}</h2></div>
      <div class="pricing-card">
        <span class="pricing-pill">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 7.5v.5" stroke-linecap="round" />
          </svg>
          {s.usagePill}
        </span>
        <ul class="pricing-addons">
          {addons.map((a) => (
            <li>
              <h3 class="pricing-sub-title">{a.name}</h3>
              <p class="pricing-body" set:html={a.body.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* The original shows every answer; it is not an accordion. */}
    <section class="pricing-row pricing-sec">
      <div class="pricing-spacer"></div>
      <div class="pricing-block">
        <h2 class="pricing-sec-title">{s.faqHeading}</h2>
        <p class="pricing-body">{s.faqBody}</p>
        <a href={s.faqCtaUrl} class="pricing-talk">{s.faqCtaLabel}</a>
        <div class="pricing-faq">
          {faqs.map((f) => (
            <article>
              <h3 class="pricing-sub-title">{f.question}</h3>
              <p class="pricing-body">
                {f.answer}
                {f.linkLabel && f.linkUrl && <> <a href={f.linkUrl}>{f.linkLabel}</a></>}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pricing-row pricing-sec pricing-sec--compliance">
      <div class="pricing-spacer"></div>
      <div class="pricing-narrow">
        <h2 class="pricing-sec-title pricing-sec-title--sm">{s.complianceHeading}</h2>
        <p class="pricing-body">{s.complianceBody}</p>
      </div>
      <div class="pricing-badges">
        {(s.badges ?? []).map((b) => (
          <img src={b.url} alt="" width="80" height="80" loading="lazy" decoding="async" />
        ))}
      </div>
    </section>

    {/* A cross-sell: the original shows this on the Business Intelligence view
        and hides it once you switch to Embedded Analytics, since by then you
        are already reading the thing it advertises. */}
    <section class="pricing-row pricing-sec pricing-embed">
      <div class="pricing-label"><h2 class="pricing-row-head">{s.embedLabel}</h2></div>
      <div class="pricing-embed-card">
        <div class="pricing-embed-copy">
          <h3 class="pricing-embed-title">{s.embedHeading}</h3>
          <p class="pricing-embed-price">{s.embedPrice} <span>{s.embedPriceUnit}</span></p>
          <p class="pricing-embed-note">{s.embedNote}</p>
          <a href={s.embedLinkUrl} class="pricing-embed-link">{s.embedLinkLabel}</a>
        </div>
        <div class="pricing-embed-media" aria-hidden="true">
          {s.embedMedia && <img src={s.embedMedia.url} alt="" width="471" height="267"
               loading="lazy" decoding="async" />}
        </div>
      </div>
    </section>

    <p class="pricing-note">{s.footNote}</p>
  </div>

{/*
  The tabs are radios the CSS reads, so the page needs no script to work --
  but a URL cannot reach a radio on its own, and the header links here with
  ?use_case=bi and ?use_case=ea. Without this the two Pricing menu items both
  landed on whichever tab happened to be first, showing identical pages.

  Kept to the two directions that matter: the url selects the tab on arrival,
  and choosing a tab rewrites the url so the address bar is still true if
  someone copies it. replaceState rather than pushState, because switching a
  tab is not a navigation anyone wants to press Back through.
*/}
<script>
  const field = document.querySelector('.pricing-axis--uc');

  if (field) {
    const radios = [...field.querySelectorAll('input[type="radio"]')] as HTMLInputElement[];

    const wanted = new URLSearchParams(location.search).get('use_case');
    if (wanted) {
      const key = wanted.toLowerCase();
      const match = radios.find((r) => r.value === key || r.dataset.code === key);
      if (match) match.checked = true;
    }

    for (const radio of radios) {
      radio.addEventListener('change', () => {
        if (!radio.checked) return;
        const url = new URL(location.href);
        url.searchParams.set('use_case', radio.dataset.code || radio.value);
        history.replaceState(null, '', url);
      });
    }
  }
</script>
