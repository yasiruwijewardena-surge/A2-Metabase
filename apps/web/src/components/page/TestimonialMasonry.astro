---
/*
 * The testimonial wall at /love.
 *
 * CSS columns rather than a masonry library. The original loads Bootstrap,
 * Masonry.js and List.js from a CDN to lay out this one page
 * (SITE-ANALYSIS.md 6.8); this needs no JavaScript at all.
 */
import Avatar from '../Avatar.astro';
import type { PageSection, Testimonial } from '../../lib/types';

interface Props { section: PageSection; items: Testimonial[] }
const { section: s, items: social } = Astro.props;
---
  <div class="container-mb py-14">
    <header class="mb-12 flex flex-col items-center gap-6 md:flex-row md:justify-between">
      <h1 class="max-w-[640px] text-center text-3xl md:text-start">
        <span class="text-(--color-brand)">{s.headingLead}</span> {s.heading}
      </h1>
      <p class="rounded-full bg-(--color-brand-muted) px-5 py-3 text-sm font-bold text-(--color-brand-strong)">
        {s.badge}
      </p>
    </header>

    {/* CSS columns rather than a masonry library. The original loads Bootstrap,
        Masonry.js and List.js from a CDN to lay out this one page
        (SITE-ANALYSIS.md §6.8); this needs no JavaScript at all. */}
    <div class="columns-1 gap-6 sm:columns-2 lg:columns-3 [&>*]:mb-6 [&>*]:break-inside-avoid">
      {social.map((t) => (
        <figure class="rounded-xl border border-(--color-line) bg-white p-5 shadow-sm">
          <div class="mb-4 flex items-center gap-3">
            <Avatar image={t.person?.avatar} name={t.person?.name} size={36} class="h-9 w-9 bg-(--color-surface)" />
            <figcaption class="leading-tight">
              <span class="block text-sm font-bold text-(--color-ink-2)">{t.person?.name}</span>
              <span class="block text-xs text-(--color-ink-3)">
                {t.person?.company?.name ?? t.company?.name ?? t.person?.role}
              </span>
            </figcaption>
          </div>
          <blockquote class="text-(--color-ink-2)">{t.quote}</blockquote>
        </figure>
      ))}
    </div>

    <p class="mt-10 text-center text-sm text-(--color-ink-3)">
      {s.note}
    </p>
  </div>
