---
/*
 * A heading and standfirst over an image and a feature list, one open at a
 * time. Radio inputs plus `:has()`, as the rest of the site filters, so it
 * behaves like the original's accordion while shipping no JavaScript.
 *
 * The radio group needs a name unique to the section, because a page may hold
 * more than one of these; the component's own id provides it.
 */
import NavIcon from '../NavIcon.astro';
import Media from './Media.astro';
import type { AccordionSection } from '../../lib/types';

interface Props { section: AccordionSection }
const { section: s } = Astro.props;
const group = `acc-${s.id}`;
---
<section class="pp-band container-mb">
  <div class="pp-center">
    <h2 class="pp-h36">{s.heading}</h2>
    {s.sub && <p class="pp-band-sub">{s.sub}</p>}
  </div>
  {/* The track gives the pinned carousel something to scroll through. Its
      height is the original's 3000px of scrub plus a viewport. */}
  <div class="pp-accordion-track" data-track>
  <div class="pp-accordion" data-carousel>
    <div class="pp-frame pp-frame--grey pp-accordion-media">
      {/* One shot per item; only the selected one is shown. Falls back to the
          section's own media when the items carry none. */}
      {(s.items ?? []).some((f) => f.media?.url)
        ? (s.items ?? []).map((f, i) => (
            <Media media={f.media ?? s.media} label={f.mediaLabel ?? s.mediaLabel}
                   width={602} height={555} class={`pp-accordion-shot pp-accordion-shot--${i}`} />
          ))
        : <Media media={s.media} label={s.mediaLabel} width={602} height={555} />}
    </div>
    <ul class="pp-features">
      {(s.items ?? []).map((f, i) => (
        <li class="pp-feature">
          <input class="pp-feature-radio" type="radio" name={group}
                 id={`${group}-${i}`} checked={i === 0} />
          {/* The rail doubles as the clock: its fill animates over the dwell
              time and the script advances when that animation ends. */}
          <span class="pp-feature-rail" aria-hidden="true"><i class="pp-feature-fill"></i></span>
          <div class="pp-feature-body">
            {f.icon && <NavIcon name={f.icon} size={32} class="pp-feature-icon" />}
            {f.badge && (
              <span class="pp-feature-badge">
                {f.icon && <NavIcon name={f.icon} size={24} class="pp-feature-badge-icon" />}
                {f.badge}
              </span>
            )}
            <h3 class="pp-feature-title"><label for={`${group}-${i}`}>{f.title}</label></h3>
            <div class="pp-feature-detail">
              {f.body && <p class="pp-feature-text">{f.body}</p>}
              {f.linkLabel && f.linkUrl && <a class="pp-feature-link" href={f.linkUrl}>{f.linkLabel}</a>}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
  </div>
</section>

<style is:global>
  /* Only the selected item's shot is shown; the rest are stacked under it. */
  .pp-accordion-media { position: relative; }
  .pp-accordion-shot { display: none; }
  .pp-feature-rail { position: relative; overflow: hidden; }
  .pp-feature-fill {
    display: block; position: absolute; inset: 0 0 auto 0;
    height: 0; background: var(--color-brand); border-radius: inherit;
  }

  /*
   * The original pins this section and scrubs through its items as you
   * scroll, over 3000px: five steps, each taking a fifth of that, with the
   * rail filling by however far into its own step you are. The track below
   * is that scroll distance; the carousel sticks to the top of the viewport
   * while you move through it.
   */
  .pp-accordion-track { position: relative; }
  @media (min-width: 769px) {
    .pp-accordion-track[data-track] { height: calc(100vh + 3000px); }
    .pp-accordion-track[data-track] > .pp-accordion {
      position: sticky; top: 0;
      min-height: 100vh; display: flex; align-items: center;
    }
  }

  /* Without script, or with reduced motion, it is a plain click accordion and
     the track collapses to its content. */
  @media (prefers-reduced-motion: reduce) {
    .pp-accordion-track[data-track] { height: auto; }
    .pp-accordion-track[data-track] > .pp-accordion { position: static; min-height: 0; }
  }
  .pp-accordion-track:not([data-pinned]) { height: auto; }
  .pp-accordion-track:not([data-pinned]) > .pp-accordion { position: static; min-height: 0; }
</style>

<script>
  /*
   * Scroll-driven, as the original is: the section pins and the five items
   * advance as you scroll through a fixed distance, the active item's rail
   * filling by the fraction of its own step you have covered.
   *
   * The original does this with GSAP's ScrollTrigger (pin + scrub over
   * 3000px). This uses a sticky element inside a track of the same height,
   * which needs no library and degrades to a click accordion when script or
   * motion is unavailable -- the radios underneath still work either way.
   */
  const SCRUB = 3000;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.closest<HTMLElement>('[data-track]');
    const radios = [...root.querySelectorAll<HTMLInputElement>('.pp-feature-radio')];
    const fills = [...root.querySelectorAll<HTMLElement>('.pp-feature-fill')];
    const shots = [...root.querySelectorAll<HTMLElement>('.pp-accordion-shot')];
    if (!track || radios.length < 2) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wide = window.matchMedia('(min-width: 769px)');

    const showShot = (i: number) =>
      shots.forEach((el, n) => (el.style.display = n === i ? 'block' : 'none'));

    /* Opt the track in only when it is actually driving, so the CSS above can
       fall back to a plain accordion otherwise. */
    const arm = () => {
      const on = wide.matches && !reduced.matches;
      track.toggleAttribute('data-pinned', on);
      if (!on) {
        fills.forEach((f) => (f.style.height = ''));
        showShot(radios.findIndex((r) => r.checked));
      }
      return on;
    };

    const update = () => {
      if (!track.hasAttribute('data-pinned')) return;
      const top = track.getBoundingClientRect().top;
      const progress = Math.min(Math.max(-top / SCRUB, 0), 1);

      const raw = progress * radios.length;
      const active = Math.min(Math.floor(raw), radios.length - 1);
      const within = raw - active;

      if (!radios[active].checked) radios[active].checked = true;
      showShot(active);
      fills.forEach((f, i) => {
        f.style.height = i < active ? '100%' : i > active ? '0%' : `${within * 100}%`;
      });
    };

    /* A click still picks an item; the next scroll takes over again. */
    radios.forEach((r) => r.addEventListener('change', () => showShot(radios.indexOf(r))));

    arm();
    showShot(radios.findIndex((r) => r.checked));
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', () => { arm(); update(); }, { passive: true });
    reduced.addEventListener('change', () => { arm(); update(); });
  });
</script>
