---
/*
 * A section whose body is a collection rather than authored copy.
 *
 * The editor picks the source and the layout; the fetch happens here, at build
 * time, so a page row never carries a copy of content that already lives in
 * its own type. Detail routes -- a post, a case study -- stay templates over
 * their type and are not page rows.
 */
import TestimonialWall from './TestimonialWall.astro';
import TestimonialMasonry from './TestimonialMasonry.astro';
import GlossaryIndex from './GlossaryIndex.astro';
import BlogIndex from './BlogIndex.astro';
import CaseStudyIndex from './CaseStudyIndex.astro';
import { getTestimonials, getGlossary } from '../../lib/strapi';
import type { PageSection } from '../../lib/types';

interface Props { section: PageSection }
const { section: s } = Astro.props;
const layout = s.layout ?? s.source;

const needsTestimonials = layout === 'testimonial-wall' || layout === 'testimonial-masonry';

let testimonials: Awaited<ReturnType<typeof getTestimonials>> = [];
if (needsTestimonials) {
  testimonials = (await getTestimonials())
    .filter((t) => t.variant === 'social')
    .sort((a, b) => Number(b.featured) - Number(a.featured) || a.displayOrder - b.displayOrder);
  if (s.limit) testimonials = testimonials.slice(0, s.limit);
}

const terms = layout === 'glossary' ? await getGlossary() : [];
---
{layout === 'testimonial-wall' && (
  <TestimonialWall heading={s.heading} items={testimonials}
                   linkLabel={s.linkLabel} linkUrl={s.linkUrl} />
)}
{layout === 'testimonial-masonry' && <TestimonialMasonry section={s} items={testimonials} />}
{layout === 'glossary' && <GlossaryIndex section={s} items={terms} />}
{layout === 'blog-index' && <BlogIndex />}
{layout === 'case-study-index' && <CaseStudyIndex />}
