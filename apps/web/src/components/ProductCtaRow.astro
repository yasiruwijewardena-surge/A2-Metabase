---
/*
 * The pair of hero buttons plus the ticked reassurance row beneath them.
 * Both product pages repeat this verbatim in the hero and again in the
 * closing CTA, so it lives in one place.
 *
 * Measured: buttons 14/21 with 12/18 padding (45 tall, 47 with the border);
 * ticks at 14px, the last icon a size smaller than the first two. The
 * closing CTA on Embedded Analytics sets the same row a notch down — 43
 * tall with 12px labels — which is what `small` does.
 */
interface Props {
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
  small?: boolean;
}
const {
  primary = { href: '/start', label: 'Try Metabase Cloud free' },
  secondary = { href: '/open-source', label: 'Deploy Metabase Open Source' },
  small = false,
} = Astro.props;
---
<div class:list={['pp-cta-row', small && 'pp-cta-row--sm']}>
  <a href={primary.href} class="btn-primary pp-btn">{primary.label}</a>
  <a href={secondary.href} class="btn-secondary pp-btn">{secondary.label}</a>
</div>
<p class:list={['pp-points', small && 'pp-points--sm']}>
  {/* Three different marks, not one repeated: a ticked circle, a clock and
      the GitHub logo, each the original's own path. The first two are
      stroked at 1.5 in tertiary ink; the third is a filled 26-unit glyph
      drawn at 20. */}
  <span class="pp-point">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4.75 12C4.75 7.99594 7.99594 4.75 12 4.75C16.0041 4.75 19.25 7.99594 19.25 12C19.25 16.0041 16.0041 19.25 12 19.25C7.99594 19.25 4.75 16.0041 4.75 12Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M9.75 12.75L10.1837 13.6744C10.5275 14.407 11.5536 14.4492 11.9564 13.7473L14.25 9.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    Free 14-day trial
  </span>
  <span class="pp-point">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path stroke="currentColor" stroke-width="1.5" d="M12 19.25a7.25 7.25 0 1 0 0-14.5 7.25 7.25 0 0 0 0 14.5Z" />
      <path stroke="currentColor" stroke-width="1.5" d="M12 8v4l2 2" />
    </svg>
    Super-fast setup
  </span>
  <span class="pp-point">
    <svg width="20" height="20" viewBox="0 0 26 26" fill="currentColor" aria-hidden="true">
      <path d="M12.7888232,0 C5.72701843,0 0,5.72623326 0,12.7903935 C0,18.4412506 3.664381,23.2347038 8.74677616,24.9259565 C9.38668842,25.0437318 9.61988344,24.6487921 9.61988344,24.3095993 C9.61988344,24.0065243 9.60889108,23.2017267 9.60260973,22.1346828 C6.04501164,22.9072885 5.29439063,20.419875 5.29439063,20.419875 C4.71258083,18.942188 3.87402097,18.5488187 3.87402097,18.5488187 C2.71275688,17.7557986 3.96195983,17.7715019 3.96195983,17.7715019 C5.24571019,17.8617963 5.92095503,19.0897997 5.92095503,19.0897997 C7.06180474,21.0440839 8.9148022,20.4795478 9.64343849,20.1521326 C9.75964341,19.3261354 10.0901993,18.7623845 10.4553026,18.4428209 C7.61534847,18.1201167 4.62935298,17.0224513 4.62935298,12.12143 C4.62935298,10.7254006 5.12793493,9.58298052 5.94608042,8.68945886 C5.81417212,8.36596947 5.37526298,7.06494541 6.07170736,5.30459782 C6.07170736,5.30459782 7.14503259,4.96069405 9.5884767,6.61582907 C10.6084105,6.33159811 11.7029352,6.19026779 12.7903935,6.18477161 C13.8770666,6.19026779 14.9708062,6.33159811 15.9923103,6.61582907 C18.4341841,4.96069405 19.505939,5.30459782 19.505939,5.30459782 C20.2039537,7.06494541 19.7650445,8.36596947 19.6339214,8.68945886 C20.4536372,9.58298052 20.9482933,10.7254006 20.9482933,12.12143 C20.9482933,17.035014 17.9575868,18.1161909 15.1089958,18.4326137 C15.5675342,18.8275535 15.9766069,19.6080109 15.9766069,20.8014669 C15.9766069,22.5107785 15.9609036,23.8903194 15.9609036,24.3095993 C15.9609036,24.6519328 16.1917431,25.0500132 16.8402922,24.9251714 C21.9187615,23.2299928 25.5800018,18.4396803 25.5800018,12.7903935 C25.5800018,5.72623326 19.8529834,0 12.7888232,0" />
    </svg>
    Open source
  </span>
</p>
