---
/*
 * The pair of hero buttons plus the ticked reassurance row beneath them.
 * Both product pages repeat this verbatim in the hero and again in the
 * closing CTA, so it lives in one place.
 *
 * Measured: buttons 14/21 with 12/18 padding (45 tall, 47 with the border);
 * ticks at 14px, the last icon a size smaller than the first two. The
 * closing CTA on Embedded Analytics sets the same row a notch down — 43
 * tall with 12px labels — which is what `small` does.
 */
interface Props {
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
  small?: boolean;
}
const {
  primary = { href: '/start', label: 'Try Metabase Cloud free' },
  secondary = { href: '/open-source', label: 'Deploy Metabase Open Source' },
  small = false,
} = Astro.props;
---
<div class:list={['pp-cta-row', small && 'pp-cta-row--sm']}>
  <a href={primary.href} class="btn-primary pp-btn">{primary.label}</a>
  <a href={secondary.href} class="btn-secondary pp-btn">{secondary.label}</a>
</div>
<p class:list={['pp-points', small && 'pp-points--sm']}>
  {[['Free 14-day trial', 24], ['Super-fast setup', 24], ['Open source', 20]].map(([label, size]) => (
    <span class="pp-point">
      <svg width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
        <path d="M8.5 12.2l2.4 2.4 4.6-4.9" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {label}
    </span>
  ))}
</p>
