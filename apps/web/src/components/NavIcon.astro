/*
 * The original's own icons, lifted from its markup rather than redrawn.
 *
 * These used to be hand-approximated line drawings, which is why they read as
 * wrong everywhere they appear -- the navigation, the product pillars, the
 * feature cards. Each entry is the path data from the corresponding icon on
 * metabase.com, keeping its own viewBox, because they are not all 24x24.
 *
 * Every stroke and ink fill is rewritten to `currentColor`. The original inks
 * the same artwork differently depending on where it sits -- grey in a menu
 * list, brand blue on a card -- so the colour belongs to the CSS that places
 * the icon, not to the icon. It is also what lets the colour transition on the
 * row carry the icon with it on hover. The tinted plate behind the larger
 * category icons (#EEF6FC and white) is artwork rather than ink, and stays.
 */
interface Props { name: string; size?: number; class?: string }
