---
/*
 * One icon from the site's set, looked up by key.
 *
 * The artwork used to be a hardcoded map here, which made the set a developer
 * concern: an editor could only use what had already been pasted in, and had
 * to guess the key from nothing. It now comes from the Icon collection in the
 * CMS -- see `lib/icons.ts` for how the files become inlinable markup.
 *
 * The icons are inlined rather than linked, because they draw themselves in
 * `currentColor`. The original inks the same artwork differently depending on
 * where it sits -- grey in a menu list, brand blue on a card -- so the colour
 * belongs to the CSS that places the icon, not to the icon, and that is also
 * what lets the colour transition on a row carry the icon with it on hover.
 */
import { resolveIcon } from '../lib/icons';
import type { IconSet } from '../lib/types';

interface Props { name: string; size?: number; class?: string; set?: IconSet }
const { name, size = 24, class: cls = 'nav-icon', set = 'nav' } = Astro.props;

const icon = name ? await resolveIcon(name, set) : undefined;
---
{icon && (
  <svg
    width={size}
    height={size}
    viewBox={icon.box}
    fill="none"
    class={cls}
    aria-hidden="true"
    set:html={icon.body}
  />
)}
