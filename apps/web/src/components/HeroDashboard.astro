---
/**
 * The hero's product panel: a Metabase dashboard beside a Metabot chat.
 *
 * Chrome and type are measured off the original rather than inferred: the
 * panel is a 24px-radius #fafbfe slab with 24px of padding, the dashboard
 * takes 68% of it with a 28px gutter before the 388px chat, and the three
 * cards sit on a 3-column grid of 242px and 380px rows at a 12px gap.
 *
 * Charts are static SVG rather than drawn at runtime, so they are in the first
 * paint. The entrance - the headline number counting up and the bars growing
 * from the baseline - runs once on scroll, matching the original's behaviour
 * without redrawing anything.
 */
import HeroChat from './demos/HeroChat.astro';

// Accounts added per year, by source — the original's five series and colours.
const SOURCES = [
  { name: 'Organic',  color: '#7172AD' },
  { name: 'Facebook', color: '#509EE3' },
  { name: 'Google',   color: '#EF8C8C' },
  { name: 'Invite',   color: '#F2A86F' },
  { name: 'LinkedIn', color: '#F9D45C' },
];
const YEARS = [
  { year: 2021, v: [118, 42, 58, 34, 52] },
  { year: 2022, v: [ 88, 30, 42, 26, 44] },
  { year: 2023, v: [ 96, 34, 48, 28, 50] },
  { year: 2024, v: [ 78, 28, 38, 24, 42] },
  { year: 2025, v: [104, 32, 50, 30, 56] },
  { year: 2026, v: [ 62, 18, 30, 20, 32] },
];

const AX_W = 720, AX_H = 210, PAD_L = 42, PAD_B = 26;
const scale = (v: number) => ((AX_H - PAD_B) * v) / 400;
const bandW = (AX_W - PAD_L) / YEARS.length;
const barW = bandW * 0.56;

// Payments received per quarter by plan — a denser series, as on the original.
const PLANS = [
  { name: 'Basic',    color: '#87BCEC' },
  { name: 'Premium',  color: '#EF8C8C' },
  { name: 'Business', color: '#227FD2' },
];
const quarters = Array.from({ length: 48 }, (_, i) => {
  const cycle = i % 8;
  const growth = 1 + Math.floor(i / 8) * 0.22;
  const basic = (14 + cycle * 11) * growth;
  return { basic, premium: basic * 0.06, business: basic * (cycle > 5 ? 0.62 : 0.3) };
});
const maxQ = Math.max(...quarters.map((q) => q.basic + q.premium + q.business));
---

<div class="hero-demo-panel" data-hero-dash>
  <div class="hd-viz">
    <div class="hd-grid">
      <!-- Total Accounts -->
      <section class="hd-card hd-card-trend">
        <div class="hd-card-head"><div class="hd-card-title">Total Accounts</div></div>
        <div class="hd-card-body">
          <div class="hd-trend">
            <div class="hd-trend-value" data-countup="1228">0</div>
            <div class="hd-trend-period">Jun 2026</div>
            <div class="hd-trend-compare">
              <span class="hd-delta up"><span class="hd-arr" aria-hidden="true">&#8593;</span>0.9%</span>
              <span class="hd-ref">vs. previous month: 1,217</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Accounts added per year, by source -->
      <section class="hd-card hd-card-accounts">
        <div class="hd-card-head"><div class="hd-card-title">Accounts added per year, by source</div></div>
        <div class="hd-card-body">
          <div class="hd-bar-legend">
            {SOURCES.map((s) => (
              <span class="hd-legend-item"><span class="hd-dot" style={`background:${s.color}`}></span>{s.name}</span>
            ))}
          </div>
          <div class="hd-bar-wrap">
            <svg viewBox={`0 0 ${AX_W} ${AX_H}`} preserveAspectRatio="none" role="img"
                 aria-label="Stacked bar chart of accounts added per year by source">
              {[0, 100, 200, 300, 400].map((t) => {
                const y = AX_H - PAD_B - scale(t);
                return (
                  <>
                    <line x1={PAD_L} x2={AX_W} y1={y} y2={y} stroke="#e2e4e9" stroke-width="1" vector-effect="non-scaling-stroke" />
                    <text x={PAD_L - 8} y={y + 4} text-anchor="end" font-size="12" fill="#8d93a5">{t}</text>
                  </>
                );
              })}
              {YEARS.map((row, i) => {
                let acc = 0;
                const x = PAD_L + i * bandW + (bandW - barW) / 2;
                return (
                  <>
                    {row.v.map((v, si) => {
                      const h = scale(v);
                      const y = AX_H - PAD_B - scale(acc) - h;
                      acc += v;
                      return <rect x={x} y={y} width={barW} height={h} fill={SOURCES[si].color} class="hd-bar" style={`--d:${i * 70}ms`} />;
                    })}
                    <text x={x + barW / 2} y={AX_H - 8} text-anchor="middle" font-size="12" fill="#8d93a5">{row.year}</text>
                  </>
                );
              })}
            </svg>
          </div>
        </div>
      </section>

      <!-- Payments received per quarter by plan -->
      <section class="hd-card hd-card-pay">
        <div class="hd-card-head"><div class="hd-card-title">Payments received per quarter by plan</div></div>
        <div class="hd-card-body">
          <div class="hd-bar-legend">
            {PLANS.map((p) => (
              <span class="hd-legend-item"><span class="hd-dot" style={`background:${p.color}`}></span>{p.name}</span>
            ))}
          </div>
          <div class="hd-bar-wrap">
            <svg viewBox="0 0 960 170" preserveAspectRatio="none" role="img"
                 aria-label="Stacked bar chart of payments received per quarter by plan">
              {[0, 1, 2, 3, 4, 5].map((t) => {
                const y = 150 - (t / 5) * 140;
                return <line x1="56" x2="960" y1={y} y2={y} stroke="#e2e4e9" stroke-width="1" vector-effect="non-scaling-stroke" />;
              })}
              {['250,000','200,000','150,000','100,000','50,000','0'].map((lbl, i) => (
                <text x="48" y={150 - ((5 - i) / 5) * 140 + 4} text-anchor="end" font-size="11" fill="#8d93a5">{lbl}</text>
              ))}
              {quarters.map((q, i) => {
                const w = (960 - 56) / quarters.length;
                const x = 56 + i * w;
                const bw = w * 0.72;
                const hb = (q.basic / maxQ) * 140;
                const hp = (q.premium / maxQ) * 140;
                const hu = (q.business / maxQ) * 140;
                return (
                  <>
                    <rect x={x} y={150 - hu} width={bw} height={hu} fill="#227FD2" class="hd-bar" style={`--d:${i * 9}ms`} />
                    <rect x={x} y={150 - hu - hp} width={bw} height={hp} fill="#EF8C8C" class="hd-bar" style={`--d:${i * 9}ms`} />
                    <rect x={x} y={150 - hu - hp - hb} width={bw} height={hb} fill="#87BCEC" class="hd-bar" style={`--d:${i * 9}ms`} />
                  </>
                );
              })}
              {[0, 1, 2, 3, 4, 5].map((i) => (
                <text x={56 + i * 150 + 30} y="166" text-anchor="middle" font-size="11" fill="#8d93a5">
                  Jan {2021 + i}
                </text>
              ))}
            </svg>
          </div>
        </div>
      </section>
    </div>
  </div>

  <aside class="hd-chat">
    <HeroChat />
  </aside>
</div>

<style is:global>
  /* All measured off the original at a 1440 viewport. */
  .hero-demo-panel {
    display: flex;
    border: 1px solid var(--color-line); border-radius: 24px; background: #fafbfe;
    padding: 24px;
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.04), 0 8px 48px rgb(0 0 0 / 0.05);
  }
  .hd-viz { flex: 1 1 68%; min-width: 0; padding-right: 28px; }
  .hd-chat { flex: 0 0 388px; min-width: 0; }

  .hd-grid { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: 242px 380px; gap: 12px; }
  .hd-card-trend { grid-column: span 1; }
  .hd-card-accounts { grid-column: span 2; }
  .hd-card-pay { grid-column: 1 / -1; }

  .hd-card {
    display: flex; flex-direction: column; min-width: 0;
    border: 1px solid var(--color-line); border-radius: 16px; background: #fff;
    padding: 14px 16px; box-shadow: 0 1px 3px rgb(0 0 0 / 0.04);
  }
  .hd-card-head { display: flex; padding-bottom: 10px; }
  .hd-card-title { font-size: 14px; line-height: 17.5px; font-weight: 700; color: var(--color-admin); }
  .hd-card-body { display: flex; flex-direction: column; flex: 1; min-height: 0; }

  .hd-trend { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .hd-trend-value { font-size: 58px; line-height: 55px; font-weight: 700; color: var(--color-ink); }
  .hd-trend-period { margin-top: 12px; font-size: 14px; font-weight: 700; color: var(--color-ink); }
  .hd-trend-compare { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 6px; margin-top: 8px; font-size: 13px; color: var(--color-ink-2); }
  .hd-delta { display: flex; gap: 3px; font-weight: 700; }
  .hd-delta.up { color: #4e7527; }  /* the original's #669438 is 2.6:1 here */

  .hd-bar-legend { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: var(--color-ink); }
  .hd-legend-item { display: flex; align-items: center; gap: 6px; }
  .hd-dot { width: 10px; height: 10px; border-radius: 50%; }
  .hd-bar-wrap { flex: 1; min-height: 0; margin-top: 10px; }
  .hd-bar-wrap svg { display: block; width: 100%; height: 100%; }

  /* Bars grow from the baseline once the panel scrolls into view. */
  [data-hero-dash] .hd-bar { transform-box: fill-box; transform-origin: bottom; scale: 1 0; }
  [data-hero-dash][data-shown='true'] .hd-bar {
    scale: 1 1;
    transition: scale 600ms cubic-bezier(.2,.7,.3,1);
    transition-delay: var(--d, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-hero-dash] .hd-bar { scale: 1 1; transition: none; }
  }

  /* Below the panel's two-column width the chat drops under the dashboard. */
  @media (max-width: 1199px) {
    .hero-demo-panel { flex-direction: column; padding: 16px; border-radius: 16px; }
    .hd-viz { flex: 1 1 auto; padding-right: 0; }
    .hd-chat { flex: 1 1 auto; margin-top: 12px; }
    .hd-grid { grid-template-columns: 1fr; grid-template-rows: none; }
    .hd-card-accounts, .hd-card-pay { grid-column: 1 / -1; }
    .hd-card-accounts, .hd-card-pay { min-height: 280px; }
    .hd-card-trend { min-height: 220px; }
  }
</style>

<script>
  // Entrance: the headline number counts up and the bars grow in, once.
  document.querySelectorAll<HTMLElement>('[data-hero-dash]').forEach((root) => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const num = root.querySelector<HTMLElement>('[data-countup]');
    const target = Number(num?.dataset.countup ?? 0);

    if (reduced) {
      root.dataset.shown = 'true';
      if (num) num.textContent = target.toLocaleString('en-US');
      return;
    }

    let done = false;
    new IntersectionObserver((entries, obs) => {
      for (const e of entries) {
        if (!e.isIntersecting || done) continue;
        done = true;
        obs.disconnect();
        root.dataset.shown = 'true';

        if (!num) return;
        const DUR = 1100;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - start) / DUR, 1);
          // ease-out so it settles rather than stopping dead
          const v = Math.round(target * (1 - Math.pow(1 - p, 3)));
          num.textContent = v.toLocaleString('en-US');
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.35 }).observe(root);
  });
</script>
