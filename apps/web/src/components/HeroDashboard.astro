---
/**
 * The hero's product panel: a Metabase dashboard beside a Metabot chat.
 *
 * Charts are static SVG rather than drawn at runtime, so they are in the first
 * paint. The entrance - the headline number counting up and the bars growing
 * from the baseline - runs once on scroll, matching the original's behaviour
 * without redrawing anything.
 */
import HeroChat from './demos/HeroChat.astro';

// Accounts added per year, by source — stacked, read from the original.
const SOURCES = [
  { name: 'Organic',  color: '#6b5fbf' },
  { name: 'Facebook', color: '#4a9be8' },
  { name: 'Google',   color: '#ec7b72' },
  { name: 'Invite',   color: '#e8905c' },
  { name: 'LinkedIn', color: '#f0d04e' },
];
const YEARS = [
  { year: 2021, v: [118, 42, 58, 34, 52] },
  { year: 2022, v: [ 88, 30, 42, 26, 44] },
  { year: 2023, v: [ 96, 34, 48, 28, 50] },
  { year: 2024, v: [ 78, 28, 38, 24, 42] },
  { year: 2025, v: [104, 32, 50, 30, 56] },
  { year: 2026, v: [ 62, 18, 30, 20, 32] },
];

const AX_W = 720, AX_H = 210, PAD_L = 42, PAD_B = 26;
const maxTotal = Math.max(...YEARS.map((y) => y.v.reduce((a, b) => a + b, 0)));
const scale = (v: number) => ((AX_H - PAD_B) * v) / 400;
const bandW = (AX_W - PAD_L) / YEARS.length;
const barW = bandW * 0.56;

// Payments received per quarter by plan — a denser series, as on the original.
const PLANS = [
  { name: 'Basic',    color: '#9cc9f0' },
  { name: 'Premium',  color: '#ec7b72' },
  { name: 'Business', color: '#2d6fbf' },
];
const quarters = Array.from({ length: 48 }, (_, i) => {
  const cycle = i % 8;
  const growth = 1 + Math.floor(i / 8) * 0.22;
  const basic = (14 + cycle * 11) * growth;
  return { basic, premium: basic * 0.06, business: basic * (cycle > 5 ? 0.62 : 0.3) };
});
const maxQ = Math.max(...quarters.map((q) => q.basic + q.premium + q.business));
---
<div class="overflow-hidden rounded-2xl border border-(--color-line) bg-white shadow-[0_1px_3px_rgba(0,0,0,.04)]" data-hero-dash>
  <div class="grid lg:grid-cols-[1fr_380px]">
    <!-- Dashboard -->
    <div class="bg-(--color-brand-faint) p-5">
      <div class="mb-4 grid gap-4 sm:grid-cols-[minmax(0,260px)_1fr]">
        <!-- Big number -->
        <section class="rounded-xl border border-(--color-line) bg-white p-5">
          <p class="mb-5 text-base font-bold text-(--color-brand-hover)">Total Accounts</p>
          <p class="text-center text-[3.25rem] leading-none font-black tracking-tight" data-countup="1228">0</p>
          <p class="mt-3 text-center text-sm font-bold text-(--color-ink-2)">Jun 2026</p>
          <p class="mt-1 text-center text-sm text-(--color-ink-3)">
            <span class="font-bold text-(--color-ok-strong)">↑ 0.9%</span> vs. previous month: 1,217
          </p>
        </section>

        <!-- Stacked bars -->
        <section class="rounded-xl border border-(--color-line) bg-white p-5">
          <p class="mb-3 text-base font-bold text-(--color-brand-hover)">Accounts added per year, by source</p>
          <ul class="mb-3 flex flex-wrap gap-x-4 gap-y-1">
            {SOURCES.map((s) => (
              <li class="flex items-center gap-1.5 text-xs text-(--color-ink-2)">
                <span class="h-2.5 w-2.5 rounded-full" style={`background:${s.color}`}></span>{s.name}
              </li>
            ))}
          </ul>
          <svg viewBox={`0 0 ${AX_W} ${AX_H}`} class="w-full" role="img"
               aria-label="Stacked bar chart of accounts added per year by source">
            {[0, 100, 200, 300, 400].map((t) => {
              const y = AX_H - PAD_B - scale(t);
              return (
                <>
                  <line x1={PAD_L} x2={AX_W} y1={y} y2={y} stroke="#e2e4e9" stroke-width="1" />
                  <text x={PAD_L - 8} y={y + 4} text-anchor="end" font-size="12" fill="#8d93a5">{t}</text>
                </>
              );
            })}
            {YEARS.map((row, i) => {
              let acc = 0;
              const x = PAD_L + i * bandW + (bandW - barW) / 2;
              return (
                <>
                  {row.v.map((v, si) => {
                    const h = scale(v);
                    const y = AX_H - PAD_B - scale(acc) - h;
                    acc += v;
                    return <rect x={x} y={y} width={barW} height={h} fill={SOURCES[si].color} class="hd-bar" style={`--d:${i * 70}ms`} />;
                  })}
                  <text x={x + barW / 2} y={AX_H - 8} text-anchor="middle" font-size="12" fill="#8d93a5">{row.year}</text>
                </>
              );
            })}
          </svg>
        </section>
      </div>

      <!-- Dense quarterly series -->
      <section class="rounded-xl border border-(--color-line) bg-white p-5">
        <p class="mb-3 text-base font-bold text-(--color-brand-hover)">Payments received per quarter by plan</p>
        <ul class="mb-3 flex flex-wrap gap-x-4 gap-y-1">
          {PLANS.map((p) => (
            <li class="flex items-center gap-1.5 text-xs text-(--color-ink-2)">
              <span class="h-2.5 w-2.5 rounded-full" style={`background:${p.color}`}></span>{p.name}
            </li>
          ))}
        </ul>
        <svg viewBox="0 0 960 170" class="w-full" role="img"
             aria-label="Stacked bar chart of payments received per quarter by plan">
          {[0, 1, 2, 3, 4, 5].map((t) => {
            const y = 150 - (t / 5) * 140;
            return <line x1="56" x2="960" y1={y} y2={y} stroke="#e2e4e9" stroke-width="1" />;
          })}
          {['250,000','200,000','150,000','100,000','50,000','0'].map((lbl, i) => (
            <text x="48" y={150 - ((5 - i) / 5) * 140 + 4} text-anchor="end" font-size="11" fill="#8d93a5">{lbl}</text>
          ))}
          {quarters.map((q, i) => {
            const w = (960 - 56) / quarters.length;
            const x = 56 + i * w;
            const bw = w * 0.72;
            const hb = (q.basic / maxQ) * 140;
            const hp = (q.premium / maxQ) * 140;
            const hu = (q.business / maxQ) * 140;
            return (
              <>
                <rect x={x} y={150 - hu} width={bw} height={hu} fill="#2d6fbf" class="hd-bar" style={`--d:${i * 9}ms`} />
                <rect x={x} y={150 - hu - hp} width={bw} height={hp} fill="#ec7b72" class="hd-bar" style={`--d:${i * 9}ms`} />
                <rect x={x} y={150 - hu - hp - hb} width={bw} height={hb} fill="#9cc9f0" class="hd-bar" style={`--d:${i * 9}ms`} />
              </>
            );
          })}
          {[0, 1, 2, 3, 4, 5].map((i) => (
            <text x={56 + i * 150 + 30} y="166" text-anchor="middle" font-size="11" fill="#8d93a5">
              Jan {2021 + i}
            </text>
          ))}
        </svg>
      </section>
    </div>

    <aside class="hero-dash__chat">
      <HeroChat />
    </aside>
  </div>
</div>

<style is:global>
  .hero-dash__chat { border-top: 1px solid var(--color-line); background: #fff; padding: 1.25rem; }
  @media (min-width: 1024px) {
    .hero-dash__chat { border-top: 0; border-inline-start: 1px solid var(--color-line); }
  }

  /* Bars grow from the baseline once the panel scrolls into view. */
  [data-hero-dash] .hd-bar { transform-box: fill-box; transform-origin: bottom; scale: 1 0; }
  [data-hero-dash][data-shown='true'] .hd-bar {
    scale: 1 1;
    transition: scale 600ms cubic-bezier(.2,.7,.3,1);
    transition-delay: var(--d, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-hero-dash] .hd-bar { scale: 1 1; transition: none; }
  }
</style>

<script>
  // Entrance: the headline number counts up and the bars grow in, once.
  document.querySelectorAll<HTMLElement>('[data-hero-dash]').forEach((root) => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const num = root.querySelector<HTMLElement>('[data-countup]');
    const target = Number(num?.dataset.countup ?? 0);

    if (reduced) {
      root.dataset.shown = 'true';
      if (num) num.textContent = target.toLocaleString('en-US');
      return;
    }

    let done = false;
    new IntersectionObserver((entries, obs) => {
      for (const e of entries) {
        if (!e.isIntersecting || done) continue;
        done = true;
        obs.disconnect();
        root.dataset.shown = 'true';

        if (!num) return;
        const DUR = 1100;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - start) / DUR, 1);
          // ease-out so it settles rather than stopping dead
          const v = Math.round(target * (1 - Math.pow(1 - p, 3)));
          num.textContent = v.toLocaleString('en-US');
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.35 }).observe(root);
  });
</script>
