---
import { getPosts } from '../lib/strapi';

// The original's megamenu carries a live "Recent Blog Posts" column. Resolved
// at build time, so it costs nothing at runtime.
const recent = (await getPosts()).slice(0, 5);

const features = [
  ['Metabase AI', '/features/metabase-ai', 'New'], ['Data Studio', '/product/data-studio', 'New'],
  ['Dashboards and reporting', '/features/analytics-dashboards'], ['Query builder', '/features/query-builder'],
  ['Data segregation', '/features/data-segregation'], ['Usage analytics', '/features/usage-analytics'],
  ['Embedded analytics SDK', '/features/embedded-analytics-sdk'], ['White-label analytics', '/features/white-label'],
  ['Drill-through', '/features/drill-through'], ['SQL editor', '/features/sql-editor'],
  ['Permissions', '/features/permissions'], ['CSV upload', '/product/csv-uploads'],
];
---
{/* The original's bar is 74 tall, solid white and carries no bottom rule. */}
<header class="sticky top-0 z-50 bg-white">
  {/* Three parts: the logo, the menu taking the slack and centring in it, then
      the actions. Left-aligning the menu against the logo put it ~190px left
      of where the original has it. */}
  <nav class="nav-row" aria-label="Main">
    <a href="/" class="nav-logo" aria-label="Metabase home">
      <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true" fill="var(--color-brand)">
        <circle cx="5" cy="5" r="2.6"/><circle cx="12" cy="4" r="2.2" opacity=".75"/><circle cx="19" cy="5" r="2.6"/>
        <circle cx="5" cy="12" r="2.2" opacity=".75"/><circle cx="12" cy="12" r="2.6"/><circle cx="19" cy="12" r="2.2" opacity=".75"/>
        <circle cx="5" cy="19" r="2.6"/><circle cx="12" cy="20" r="2.2" opacity=".75"/><circle cx="19" cy="19" r="2.6"/>
      </svg>
      <span class="nav-logo-word">Metabase</span>
    </a>

    <ul class="nav-menu hidden lg:flex" data-menu-root>
      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="product">Product<svg class="nav-chevron" width="11" height="7" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1.5 1.5 6 6l4.5-4.5"/></svg></button>
        {/*
            Panel anatomy measured off the original: a 24px-radius white sheet
            on a deep soft shadow, an optional row of bordered cards, optional
            link columns, and an optional #f9fbfe footer strip of pill buttons.
            Widths are the original's per menu.
        */}
        <div class="nav-panel" style="width:596px" data-panel="product" hidden>
          <div class="nav-cards">
            <a href="/product/business-intelligence" class="nav-card">
              <span class="nav-card-glyph" aria-hidden="true">
                <svg width="34" height="24" viewBox="0 0 34 24" fill="none">
                  <rect x="2" y="12" width="4" height="10" rx="1" fill="#509EE3" />
                  <rect x="9" y="7" width="4" height="15" rx="1" fill="#509EE3" opacity=".75" />
                  <rect x="16" y="3" width="4" height="19" rx="1" fill="#509EE3" />
                  <rect x="23" y="9" width="4" height="13" rx="1" fill="#509EE3" opacity=".75" />
                </svg>
              </span>
              <span class="nav-card-title">Business Intelligence</span>
              <span class="nav-card-sub">Self-service analytics for your team</span>
            </a>
            <a href="/product/embedded-analytics" class="nav-card">
              <span class="nav-card-glyph" aria-hidden="true">
                <svg width="34" height="24" viewBox="0 0 34 24" fill="none">
                  <rect x="3" y="2" width="28" height="20" rx="3" stroke="#509EE3" stroke-width="1.8" />
                  <path d="M3 8h28" stroke="#509EE3" stroke-width="1.8" />
                  <circle cx="23" cy="15" r="4" fill="#509EE3" opacity=".75" />
                </svg>
              </span>
              <span class="nav-card-title">Embedded Analytics</span>
              <span class="nav-card-sub">Fast, flexible customer-facing analytics</span>
            </a>
          </div>
          <div class="nav-foot">
            {[['Data sources', '/data-sources', 'M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3Zm0 0v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7'],
              ['Security', '/security', 'M12 3l7 2.5v5.5c0 4.2-2.9 7.4-7 8.5-4.1-1.1-7-4.3-7-8.5V5.5L12 3Z'],
              ['Cloud', '/cloud', 'M7 18a4 4 0 0 1 .5-8 5.5 5.5 0 0 1 10.6 1.4A3.5 3.5 0 0 1 17.5 18H7Z']].map(([label, href, d]) => (
              <a href={href}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg>
                {label}
              </a>
            ))}
          </div>
        </div>
      </li>

      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="features">Features<svg class="nav-chevron" width="11" height="7" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1.5 1.5 6 6l4.5-4.5"/></svg></button>
        <div class="nav-panel" style="width:543px" data-panel="features" hidden>
          <div class="nav-cols nav-cols--2">
            {[features.slice(0, 6), features.slice(6)].map((col) => (
              <div>
                {col.map(([label, href, badge]) => (
                  <a href={href} class="nav-item">
                    {label}
                    {badge && <span class="nav-badge">{badge}</span>}
                  </a>
                ))}
              </div>
            ))}
          </div>
          <div class="nav-foot">
            <a href="/releases">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v16M4 12h16" /></svg>
              What's new
            </a>
            <a href="/roadmap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 18h16M6 14l4-5 4 3 4-7" /></svg>
              Roadmap
            </a>
          </div>
        </div>
      </li>

      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="docs">Docs<svg class="nav-chevron" width="11" height="7" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1.5 1.5 6 6l4.5-4.5"/></svg></button>
        <div class="nav-panel" style="width:720px" data-panel="docs" hidden>
          <div class="nav-cards">
            <a href="/docs" class="nav-card">
              <span class="nav-card-glyph" aria-hidden="true">
                <svg width="34" height="24" viewBox="0 0 34 24" fill="none">
                  <rect x="6" y="2" width="22" height="20" rx="2" stroke="#509EE3" stroke-width="1.8" />
                  <path d="M11 8h12M11 12h12M11 16h7" stroke="#509EE3" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </span>
              <span class="nav-card-title">Documentation</span>
              <span class="nav-card-sub">The Metabase manual</span>
            </a>
            <a href="/learn" class="nav-card">
              <span class="nav-card-glyph" aria-hidden="true">
                <svg width="34" height="24" viewBox="0 0 34 24" fill="none">
                  <path d="M17 4 4 9l13 5 13-5-13-5Z" stroke="#509EE3" stroke-width="1.8" stroke-linejoin="round" />
                  <path d="M9 11.5V17c0 1.7 3.6 3 8 3s8-1.3 8-3v-5.5" stroke="#509EE3" stroke-width="1.8" opacity=".75" />
                </svg>
              </span>
              <span class="nav-card-title">Learn</span>
              <span class="nav-card-sub">Guides and tutorials</span>
            </a>
          </div>
          <div class="nav-cols nav-cols--2">
            <div>
              <p class="nav-eyebrow">Getting started</p>
              <a href="/learn" class="nav-item">Querying and dashboards</a>
              <a href="/learn" class="nav-item">Everyone's data</a>
              <a href="/learn" class="nav-item">Asking questions</a>
            </div>
            <div>
              <p class="nav-eyebrow">Guides</p>
              <a href="/learn" class="nav-item">Installing Metabase</a>
              <a href="/learn" class="nav-item">Adding a database</a>
              <a href="/learn" class="nav-item">Creating a dashboard</a>
            </div>
          </div>
        </div>
      </li>

      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="resources">Resources<svg class="nav-chevron" width="11" height="7" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1.5 1.5 6 6l4.5-4.5"/></svg></button>
        <div class="nav-panel" style="width:718px" data-panel="resources" hidden>
          <div class="nav-cols nav-cols--split">
            <div class="nav-desc-list">
              {[['Blog', '/blog', 'News, updates, and ideas'],
                ['Customers', '/case-studies', 'Real companies, real data, real stories'],
                ['Love', '/love', 'What people say about Metabase'],
                ['Glossary', '/glossary', 'Data and BI terms, defined'],
                ['Community', '/community-posts', 'Share and connect with other users'],
                ['Professional Services', '/professional-services', 'Extra help from our team']].map(([label, href, sub]) => (
                <a href={href} class="nav-item">
                  <span class="nav-item-title">{label}</span>
                  <span class="nav-sub">{sub}</span>
                </a>
              ))}
            </div>
            <div>
              <p class="nav-eyebrow">Recent blog posts</p>
              {recent.map((p) => (
                <a href={`/blog/${p.slug}`} class="nav-item nav-item--post">{p.title}</a>
              ))}
            </div>
          </div>
        </div>
      </li>

      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="pricing">Pricing<svg class="nav-chevron" width="11" height="7" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1.5 1.5 6 6l4.5-4.5"/></svg></button>
        <div class="nav-panel" style="width:420px" data-panel="pricing" hidden>
          <div class="nav-desc-list nav-desc-list--pad">
            <a href="/pricing" class="nav-item">
              <span class="nav-item-title">Business Intelligence pricing</span>
              <span class="nav-sub">Self-service analytics for your team</span>
            </a>
            <a href="/pricing" class="nav-item">
              <span class="nav-item-title">Embedded Analytics pricing</span>
              <span class="nav-sub">Fast, flexible customer-facing analytics</span>
            </a>
          </div>
        </div>
      </li>
    </ul>

    <div class="nav-actions">
      <a
        href="https://github.com/metabase/metabase"
        class="nav-stars hidden items-center gap-1.5 text-sm font-bold text-(--color-ink-2) hover:text-(--color-brand-hover) md:flex"
        {/* WCAG 2.5.3: the accessible name has to contain the visible text, and
            the visible text here is "49.6k". "Metabase on GitHub" dropped it,
            so anyone saying "click 49.6k" to a voice control had nothing to
            match. */}
        aria-label="49.6k GitHub stars — Metabase on GitHub"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#f5c518" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        49.6k
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.3-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.48.11-3.08 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.6.23 2.78.12 3.07.74.82 1.18 1.85 1.18 3.11 0 4.43-2.69 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/>
        </svg>
      </a>
      <a href="/login" class="btn-secondary hidden sm:inline-flex">Log in</a>
      <a href="/start" class="btn-primary">Get started</a>
      <button type="button" class="lg:hidden" data-mobile-toggle aria-expanded="false" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
      </button>
    </div>
  </nav>

  <div class="container-mb hidden border-t border-(--color-line) py-4 lg:!hidden" data-mobile-panel hidden>
    <ul class="space-y-2">
      {[['Product','/product/business-intelligence'],['Docs','/docs'],['Blog','/blog'],['Customers','/case-studies'],['Love','/love'],['Glossary','/glossary'],['Pricing','/pricing']].map(([l,h]) => (
        <li><a href={h} class="block py-1 font-bold text-(--color-ink)">{l}</a></li>
      ))}
    </ul>
  </div>
</header>

<style>
  /* Measured off the original: 8px/12px padding in an 8px-radius box, the
     chevron 8px clear of the label. With a 10px gap between boxes that puts
     34px between one label and the next, which is what the original has. */
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-ink-2);
    border-radius: 8px;
    cursor: pointer;
  }
  .nav-trigger:hover, .nav-trigger[aria-expanded='true'] { color: var(--color-brand-hover); background: var(--color-brand-faint); }
  /* Measured: a 24px-radius white sheet, no border, on a two-layer shadow,
     sitting flush under the bar rather than 8px below it. Sections provide
     their own padding, so the panel itself has none. */
  /* The row item fills the bar's height so `top: 100%` is the underside of the
     bar, not the underside of the 37px trigger — otherwise the panel opens
     18px too high. */
  .nav-menu > li { display: flex; align-items: center; height: 74px; }

  .nav-panel {
    position: absolute; top: calc(100% - 2px); left: 6px;
    overflow: hidden;
    background: #fff;
    border-radius: 24px;
    box-shadow: 0 16px 28px -6px rgb(24 39 75 / 0.12), 0 6px 12px -4px rgb(24 39 75 / 0.08);
  }

  /* Card row: two bordered cards, each with a 65x48 glyph tile above its
     label. */
  .nav-cards { display: flex; gap: 12px; padding: 24px; }
  .nav-card {
    display: block; flex: 1; min-width: 0;
    border: 1px solid #eef6fc; border-radius: 8px; padding: 12px;
  }
  .nav-card:hover { background: var(--color-brand-faint); border-color: var(--color-brand-border); }
  .nav-card-glyph {
    display: grid; place-items: center; width: 65px; height: 48px;
    margin-bottom: 24px; border-radius: 8px; background: var(--color-brand-muted);
  }
  .nav-card-title { display: block; font-size: 14px; line-height: 18.62px; font-weight: 700; color: var(--color-ink-2); }
  /* The original's #8d93a5 is 2.6:1; one stop down the ramp as elsewhere. */
  .nav-card-sub { display: block; font-size: 14px; line-height: 26px; color: var(--color-ink-3); }

  .nav-cols { display: flex; gap: 24px; padding: 0 24px 24px; }
  .nav-cards + .nav-cols { padding-top: 0; }
  .nav-cols > div { flex: 1; min-width: 0; }
  .nav-cols--split > :first-child { flex: 1.1; }
  .nav-desc-list--pad { padding: 16px; }
  .nav-item-title { display: block; font-weight: 700; color: var(--color-ink); }
  .nav-item--post { font-size: 14px; line-height: 1.35; }
  .nav-badge {
    margin-left: 6px; border-radius: 4px; background: var(--color-brand-muted);
    padding: 1px 5px; font-size: 10px; font-weight: 700; color: var(--color-brand-hover);
  }

  /* Footer strip of pill buttons on the faint blue. */
  .nav-foot {
    display: flex; gap: 24px; padding: 24px 32px;
    background: #f9fbfe; border-top: 1px solid var(--color-brand-muted);
  }
  .nav-foot a {
    display: flex; flex: 1; align-items: center; justify-content: center; gap: 8px;
    border: 1px solid var(--color-brand-muted); border-radius: 8px; padding: 12px 0;
    font-size: 14px; line-height: 21px; font-weight: 700; color: var(--color-ink-2);
  }
  .nav-foot a:hover { border-color: var(--color-brand); color: var(--color-brand-hover); }
  .nav-eyebrow {
    margin-bottom: 0.5rem; font-size: 0.6875rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-3);
  }
  .nav-item {
    display: block; padding: 0.375rem 0.5rem; border-radius: 0.375rem;
    color: var(--color-ink); font-size: 0.9375rem;
  }
  .nav-item:hover { background: var(--color-brand-faint); color: var(--color-brand-hover); }
  .nav-chevron { transition: rotate 150ms; }
  .nav-trigger[aria-expanded='true'] .nav-chevron { rotate: 180deg; }
  .nav-sub { display: block; font-size: 0.8125rem; font-weight: 400; color: var(--color-ink-3); }
</style>

<script>
  // The only navigation JS: open/close the megamenus and keep aria-expanded
  // honest. Everything else on the page is static HTML.
  const root = document.querySelector('[data-menu-root]');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-menu]')];
  const panels = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-panel]')].map((p) => [p.dataset.panel!, p])
  );

  const closeAll = (except?: string) => {
    triggers.forEach((t) => {
      const name = t.dataset.menu!;
      if (name === except) return;
      t.setAttribute('aria-expanded', 'false');
      panels.get(name)!.hidden = true;
    });
  };

  triggers.forEach((trigger) => {
    const name = trigger.dataset.menu!;
    const panel = panels.get(name)!;
    const show = (on: boolean) => {
      if (on) closeAll(name);
      trigger.setAttribute('aria-expanded', String(on));
      panel.hidden = !on;
    };

    /*
     * The original opens these on hover. Hover alone would leave the menus
     * unreachable by keyboard, so click still toggles and Escape still closes;
     * hover is layered on top for pointers that have it. `any-hover` keeps it
     * off touch, where a hover would fire on the tap that should navigate.
     */
    const item = trigger.parentElement;
    if (item && window.matchMedia('(any-hover: hover)').matches) {
      let leaveTimer: number | undefined;
      item.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType === 'touch') return;
        window.clearTimeout(leaveTimer);
        show(true);
      });
      item.addEventListener('pointerleave', () => {
        // A short grace period, so crossing the gap to the panel does not
        // close it.
        leaveTimer = window.setTimeout(() => show(false), 120);
      });
    }

    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      closeAll(name);
      trigger.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  });

  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
  document.addEventListener('click', (e) => {
    if (root && !root.contains(e.target as Node)) closeAll();
  });

  const mobileToggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const mobilePanel = document.querySelector<HTMLElement>('[data-mobile-panel]');
  mobileToggle?.addEventListener('click', () => {
    const open = mobileToggle.getAttribute('aria-expanded') === 'true';
    mobileToggle.setAttribute('aria-expanded', String(!open));
    if (mobilePanel) mobilePanel.hidden = open;
  });
</script>
