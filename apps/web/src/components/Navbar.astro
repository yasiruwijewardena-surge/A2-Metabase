---
import { getPosts } from '../lib/strapi';

// The original's megamenu carries a live "Recent Blog Posts" column. Resolved
// at build time, so it costs nothing at runtime.
const recent = (await getPosts()).slice(0, 5);

const features = [
  ['Metabase AI', '/features/metabase-ai', 'New'], ['Data Studio', '/product/data-studio', 'New'],
  ['Dashboards and reporting', '/features/analytics-dashboards'], ['Query builder', '/features/query-builder'],
  ['Data segregation', '/features/data-segregation'], ['Usage analytics', '/features/usage-analytics'],
  ['Embedded analytics SDK', '/features/embedded-analytics-sdk'], ['White-label analytics', '/features/white-label'],
  ['Drill-through', '/features/drill-through'], ['SQL editor', '/features/sql-editor'],
  ['Permissions', '/features/permissions'], ['CSV upload', '/product/csv-uploads'],
];
---
{/* The original's bar is 74 tall, solid white and carries no bottom rule. */}
<header class="sticky top-0 z-50 bg-white">
  <nav class="container-mb flex h-[74px] items-center gap-8" aria-label="Main">
    <a href="/" class="flex shrink-0 items-center gap-2 font-black text-(--color-ink)" aria-label="Metabase home">
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" fill="var(--color-brand)">
        <circle cx="5" cy="5" r="2.6"/><circle cx="12" cy="4" r="2.2" opacity=".75"/><circle cx="19" cy="5" r="2.6"/>
        <circle cx="5" cy="12" r="2.2" opacity=".75"/><circle cx="12" cy="12" r="2.6"/><circle cx="19" cy="12" r="2.2" opacity=".75"/>
        <circle cx="5" cy="19" r="2.6"/><circle cx="12" cy="20" r="2.2" opacity=".75"/><circle cx="19" cy="19" r="2.6"/>
      </svg>
      <span class="text-lg">Metabase</span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex" data-menu-root>
      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="product">Product<svg class="nav-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"/></svg></button>
        <div class="nav-panel w-[420px]" data-panel="product" hidden>
          <div>
            <div>
              <p class="nav-eyebrow">Platform</p>
              <a href="/product/business-intelligence" class="nav-item">
                <span class="font-bold">Business Intelligence</span>
                <span class="nav-sub">Self-service analytics for your team</span>
              </a>
              <a href="/product/embedded-analytics" class="nav-item">
                <span class="font-bold">Embedded Analytics</span>
                <span class="nav-sub">Fast, flexible customer-facing analytics</span>
              </a>
              <a href="/data-sources" class="nav-item">Data sources</a>
              <a href="/security" class="nav-item">Security</a>
              <a href="/cloud" class="nav-item">Cloud</a>
              <a href="/demo" class="nav-item">Watch 5-minute demo</a>
              <a href="/roadmap" class="nav-item">Roadmap</a>
            </div>
          </div>
        </div>
      </li>

      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="features">Features<svg class="nav-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"/></svg></button>
        <div class="nav-panel w-[520px]" data-panel="features" hidden>
          <p class="nav-eyebrow">Features</p>
          <div class="grid grid-cols-2 gap-x-3">
            {features.map(([label, href, badge]) => (
              <a href={href} class="nav-item text-sm">
                {label}
                {badge && <span class="ml-1 rounded bg-(--color-brand-muted) px-1 text-[10px] font-bold text-(--color-brand-hover)">{badge}</span>}
              </a>
            ))}
          </div>
        </div>
      </li>

      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="docs">Docs<svg class="nav-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"/></svg></button>
        <div class="nav-panel w-[420px]" data-panel="docs" hidden>
          <p class="nav-eyebrow">Learn</p>
          <a href="/docs" class="nav-item"><span class="font-bold">Documentation</span><span class="nav-sub">The Metabase manual</span></a>
          <a href="/learn" class="nav-item"><span class="font-bold">Learn</span><span class="nav-sub">Guides and tutorials</span></a>
          <p class="nav-eyebrow mt-4">Guides</p>
          <a href="/learn" class="nav-item text-sm">Installing Metabase</a>
          <a href="/learn" class="nav-item text-sm">Adding a database</a>
          <a href="/learn" class="nav-item text-sm">Asking questions</a>
          <a href="/learn" class="nav-item text-sm">Creating a dashboard</a>
        </div>
      </li>

      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="resources">Resources<svg class="nav-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"/></svg></button>
        <div class="nav-panel w-[620px]" data-panel="resources" hidden>
          <div class="grid grid-cols-2 gap-6">
            <div>
              <a href="/blog" class="nav-item"><span class="font-bold">Blog</span><span class="nav-sub">News, updates, and ideas</span></a>
              <a href="/case-studies" class="nav-item"><span class="font-bold">Customers</span><span class="nav-sub">Real companies, real data, real stories</span></a>
              <a href="/love" class="nav-item"><span class="font-bold">Love</span><span class="nav-sub">What people say about Metabase</span></a>
              <a href="/glossary" class="nav-item"><span class="font-bold">Glossary</span><span class="nav-sub">Data and BI terms, defined</span></a>
            </div>
            <div>
              <p class="nav-eyebrow">Recent blog posts</p>
              {recent.map((p) => (
                <a href={`/blog/${p.slug}`} class="nav-item text-sm leading-snug">{p.title}</a>
              ))}
            </div>
          </div>
        </div>
      </li>

      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="pricing">Pricing<svg class="nav-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"/></svg></button>
        <div class="nav-panel w-[380px]" data-panel="pricing" hidden>
          <a href="/pricing" class="nav-item">
            <span class="font-bold">Business Intelligence pricing</span>
            <span class="nav-sub">Self-service analytics for your team</span>
          </a>
          <a href="/pricing" class="nav-item">
            <span class="font-bold">Embedded Analytics pricing</span>
            <span class="nav-sub">Fast, flexible customer-facing analytics</span>
          </a>
        </div>
      </li>
    </ul>

    <div class="ml-auto flex items-center gap-3">
      <a
        href="https://github.com/metabase/metabase"
        class="hidden items-center gap-1.5 text-sm font-bold text-(--color-ink-2) hover:text-(--color-brand-hover) md:flex"
        {/* WCAG 2.5.3: the accessible name has to contain the visible text, and
            the visible text here is "49.6k". "Metabase on GitHub" dropped it,
            so anyone saying "click 49.6k" to a voice control had nothing to
            match. */}
        aria-label="49.6k GitHub stars — Metabase on GitHub"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#f5c518" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        49.6k
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.3-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.48.11-3.08 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.6.23 2.78.12 3.07.74.82 1.18 1.85 1.18 3.11 0 4.43-2.69 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/>
        </svg>
      </a>
      <a href="/login" class="btn-secondary hidden sm:inline-flex">Log in</a>
      <a href="/start" class="btn-primary">Get started</a>
      <button type="button" class="lg:hidden" data-mobile-toggle aria-expanded="false" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
      </button>
    </div>
  </nav>

  <div class="container-mb hidden border-t border-(--color-line) py-4 lg:!hidden" data-mobile-panel hidden>
    <ul class="space-y-2">
      {[['Product','/product/business-intelligence'],['Docs','/docs'],['Blog','/blog'],['Customers','/case-studies'],['Love','/love'],['Glossary','/glossary'],['Pricing','/pricing']].map(([l,h]) => (
        <li><a href={h} class="block py-1 font-bold text-(--color-ink)">{l}</a></li>
      ))}
    </ul>
  </div>
</header>

<style>
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.75rem;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-ink-2);
    border-radius: 0.375rem;
    cursor: pointer;
  }
  .nav-trigger:hover, .nav-trigger[aria-expanded='true'] { color: var(--color-brand-hover); background: var(--color-brand-faint); }
  .nav-panel {
    position: absolute; top: calc(100% + 0.5rem); left: 0;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    box-shadow: 0 12px 32px rgb(34 36 43 / 0.10);
    padding: 1.25rem;
  }
  .nav-eyebrow {
    margin-bottom: 0.5rem; font-size: 0.6875rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-3);
  }
  .nav-item {
    display: block; padding: 0.375rem 0.5rem; border-radius: 0.375rem;
    color: var(--color-ink); font-size: 0.9375rem;
  }
  .nav-item:hover { background: var(--color-brand-faint); color: var(--color-brand-hover); }
  .nav-chevron { transition: rotate 150ms; }
  .nav-trigger[aria-expanded='true'] .nav-chevron { rotate: 180deg; }
  .nav-sub { display: block; font-size: 0.8125rem; font-weight: 400; color: var(--color-ink-3); }
</style>

<script>
  // The only navigation JS: open/close the megamenus and keep aria-expanded
  // honest. Everything else on the page is static HTML.
  const root = document.querySelector('[data-menu-root]');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-menu]')];
  const panels = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-panel]')].map((p) => [p.dataset.panel!, p])
  );

  const closeAll = (except?: string) => {
    triggers.forEach((t) => {
      const name = t.dataset.menu!;
      if (name === except) return;
      t.setAttribute('aria-expanded', 'false');
      panels.get(name)!.hidden = true;
    });
  };

  triggers.forEach((trigger) => {
    const name = trigger.dataset.menu!;
    const panel = panels.get(name)!;
    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      closeAll(name);
      trigger.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  });

  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
  document.addEventListener('click', (e) => {
    if (root && !root.contains(e.target as Node)) closeAll();
  });

  const mobileToggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const mobilePanel = document.querySelector<HTMLElement>('[data-mobile-panel]');
  mobileToggle?.addEventListener('click', () => {
    const open = mobileToggle.getAttribute('aria-expanded') === 'true';
    mobileToggle.setAttribute('aria-expanded', String(!open));
    if (mobilePanel) mobilePanel.hidden = open;
  });
</script>
