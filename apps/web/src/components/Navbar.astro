---
import { getPosts, getSiteSettings } from '../lib/strapi';
import type { NavLink } from '../lib/types';
import Logo from './Logo.astro';

// The original's megamenu carries a live "Recent Blog Posts" column. Resolved
// at build time, so it costs nothing at runtime.
const recent = (await getPosts()).slice(0, 5);

/*
 * Every panel was measured separately: they do not share one anatomy. Product
 * and Pricing are cards with the icon on a tile above the label;
 * Features is two columns of icon links over a button strip; Resources is two
 * columns of title-and-description links. Widths are per panel too.
 *
 * Only destinations this build actually serves appear here. The original's
 * Docs menu, its Product footer strip (data sources, security, cloud) and a
 * few feature entries point at pages that were never built, so they are not
 * drawn rather than drawn dead -- the information architecture is still
 * recorded in ia-paths.json and reachable by URL.
 */
import NavIcon from './NavIcon.astro';

/*
 * The menus come from Site Settings so an editor can add, remove or reorder a
 * link without a code change. The panel chrome does not: each one has its own
 * anatomy (Product draws a CSS bar chart and an illustration, Features is icon
 * columns, Resources is title-and-description rows), so the shapes stay here
 * and only the destinations are content.
 *
 * The fallbacks below are what the site shipped with, so a database without
 * Site Settings still renders the right menus rather than an empty bar.
 */
const settings = await getSiteSettings();
const group = (key: string, fallback: NavLink[]): NavLink[] =>
  settings?.navGroups?.find((g) => g.key === key)?.items?.length
    ? settings.navGroups.find((g) => g.key === key)!.items!
    : fallback;

const product = group('product', [
  { label: 'Business Intelligence', url: '/product/business-intelligence', icon: 'bi',
    description: 'Self-service analytics for your team' },
  { label: 'Embedded Analytics', url: '/product/embedded-analytics', icon: 'ea',
    description: 'Fast, flexible customer-facing analytics' },
]);

const featureLinks = group('features', [
  { label: 'Metabase AI', url: '/features/metabase-ai', icon: 'ai' },
  { label: 'Data Studio', url: '/product/data-studio', icon: 'studio', badge: 'New' },
  { label: 'Dashboards and reporting', url: '/features/analytics-dashboards', icon: 'dashboards' },
  { label: 'Query builder', url: '/features/query-builder', icon: 'query' },
  { label: 'Data segregation', url: '/features/data-segregation', icon: 'segregation' },
  { label: 'Usage analytics', url: '/features/usage-analytics', icon: 'usage' },
  { label: 'White-label analytics', url: '/features/white-label-analytics', icon: 'whitelabel' },
  { label: 'Drill-through', url: '/features/drill-through', icon: 'drill' },
  { label: 'SQL editor', url: '/features/sql-editor', icon: 'sql' },
  { label: 'Permissions', url: '/features/permissions', icon: 'permissions' },
]);

/* The shape the existing panel markup reads. */
const features: [string, string, string, string?][] = featureLinks.map(
  (l) => [l.label, l.url, l.icon ?? '', l.badge ?? undefined] as [string, string, string, string?]);

/*
 * The original's Resources menu is Blog, Events, Customers, Discussion,
 * Professional Services and Metabase Experts. Love, Glossary and Community
 * were never in it — /love and /glossary are real pages on metabase.com, but
 * they are reached from elsewhere, and /community-posts does not exist there
 * at all. The last three menu entries are the ones the original carries that
 * this replica has not built yet, so the menu stops at Customers for now.
 */
const resourceLinks = group('resources', [
  { label: 'Blog', url: '/blog', icon: 'blog', description: 'News, updates, and ideas' },
  { label: 'Events', url: '/events', icon: 'events', description: 'Join a live event or watch on demand' },
  { label: 'Customers', url: '/case-studies', icon: 'customers', description: 'Real companies, real data, real stories' },
]);
const resources: [string, string, string, string][] = resourceLinks.map(
  (l) => [l.label, l.url, l.icon ?? '', l.description ?? ''] as [string, string, string, string]);

const pricingLinks = group('pricing', [
  { label: 'Business Intelligence pricing', url: '/pricing?use_case=business-intelligence',
    icon: 'bi', description: 'Self-service analytics for your team' },
  { label: 'Embedded Analytics pricing', url: '/pricing?use_case=embedded-analytics',
    icon: 'ea', description: 'Fast, flexible customer-facing analytics' },
]);

/*
 * The mobile panel, built from the same arrays the megamenus above use rather
 * than a second hardcoded list -- the old panel carried six links that matched
 * no menu on the site. The original's own mobile nav is a row per menu that
 * opens an accordion, with Log in pinned to the foot; this is that, minus the
 * Docs row, which this replica does not build.
 */
const row = (l: NavLink): [string, string, string?, string?] =>
  [l.label, l.url, l.icon ?? undefined, l.description ?? undefined];

const mobileNav: { label: string; items: [string, string, string?, string?][] }[] = [
  { label: 'Product', items: product.map(row) },
  { label: 'Features', items: [...featureLinks.map(row),
    ['Roadmap', '/roadmap', 'roadmap'] as [string, string, string]] },
  { label: 'Resources', items: resourceLinks.map(row) },
  { label: 'Pricing', items: pricingLinks.map(row) },
];
---
{/* The original's bar is 74 tall, solid white and carries no bottom rule. */}
<header class="sticky top-0 z-50 bg-white">
  {/* Three parts: the logo, the menu taking the slack and centring in it, then
      the actions. Left-aligning the menu against the logo put it ~190px left
      of where the original has it. */}
  <nav class="nav-row" aria-label="Main">
    <a href="/" class="nav-logo" aria-label="Metabase home">
      <Logo width={129} />
    </a>

    <ul class="nav-menu hidden lg:flex" data-menu-root>
      <span class="nav-pill" aria-hidden="true" data-pill></span>
      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="product">Product<svg class="nav-chevron" width="11" height="7" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1.5 1.5 6 6l4.5-4.5"/></svg></button>
        {/* Product: two cards with the icon on a tile above the label, over a
            strip of three buttons. 596 wide. */}
        <div class="nav-panel" style="width:596px" data-panel="product">
          {/* The two cards carry artwork rather than icons, and not the same
              kind: Business Intelligence is a bar chart drawn in CSS whose
              bars re-sort on hover, and Embedded Analytics is a flat
              illustration on a tinted plate. An icon in a tile was neither. */}
          {/* The artwork is per card and stays in code; the destination and
              the words come from Site Settings. `icon` picks which one. */}
          <div class="nav-cards">
            {product.map((l) => (
              <a href={l.url} class="nav-card nav-card--stack">
                {l.icon === 'ea'
                  ? <span class="nav-embed" aria-hidden="true">
                      <img src="/images/nav/embed.svg" width="64" height="56" alt="" />
                    </span>
                  : <span class="nav-bars" aria-hidden="true">
                      {[20, 30, 35, 24, 16, 20].map(() => <span></span>)}
                    </span>}
                <span class="nav-card-title">{l.label}</span>
                <span class="nav-card-sub">{l.description}</span>
              </a>
            ))}
          </div>
        </div>
      </li>

      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="features">Features<svg class="nav-chevron" width="11" height="7" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1.5 1.5 6 6l4.5-4.5"/></svg></button>
        {/* Features: two columns of 32px icon links over a two-button strip. */}
        <div class="nav-panel" style="width:560px" data-panel="features">
          <div class="nav-icon-cols">
            {[features.slice(0, 6), features.slice(6)].map((col) => (
              <div>
                {col.map(([label, href, icon, badge]) => (
                  <a href={href} class="nav-icon-link">
                    <NavIcon name={icon} size={24} />
                    <span>{label}</span>
                    {badge && <span class="nav-badge">{badge}</span>}
                  </a>
                ))}
              </div>
            ))}
          </div>
          <div class="nav-foot">
            <a href="/roadmap"><NavIcon name="roadmap" size={24} /> Roadmap</a>
          </div>
        </div>
      </li>

      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="resources">Resources<svg class="nav-chevron" width="11" height="7" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1.5 1.5 6 6l4.5-4.5"/></svg></button>
        {/* Resources: one white section, two columns of title-and-description
            links beside the recent posts. 718 wide. */}
        <div class="nav-panel" style="width:740px" data-panel="resources">
          <div class="nav-res">
            <div class="nav-res-links">
              {resources.map(([label, href, icon, sub]) => (
                <a href={href} class="nav-rich nav-rich--sm">
                  <span class="nav-rich-ico" aria-hidden="true"><NavIcon name={icon} size={24} /></span>
                  <span>
                    <span class="nav-rich-title">{label}</span>
                    <span class="nav-rich-desc">{sub}</span>
                  </span>
                </a>
              ))}
            </div>
            <div class="nav-res-posts">
              <span class="nav-eyebrow">Recent blog posts</span>
              {recent.map((post) => (
                <a href={`/blog/${post.slug}`} class="nav-post">{post.title}</a>
              ))}
            </div>
          </div>
        </div>
      </li>

      <li class="relative">
        <button type="button" class="nav-trigger" aria-expanded="false" data-menu="pricing">Pricing<svg class="nav-chevron" width="11" height="7" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1.5 1.5 6 6l4.5-4.5"/></svg></button>
        {/* Pricing: cards only, same shape as Product's. 578 wide. */}
        <div class="nav-panel" style="width:596px" data-panel="pricing">
          <div class="nav-cards">
            {pricingLinks.map((l) => (
              <a href={l.url} class="nav-card nav-card--stack">
                <span class="nav-card-art" aria-hidden="true">
                  <img src={`/images/nav/pricing-${l.icon === 'ea' ? 'ea' : 'bi'}.svg`}
                       width="64" height="56" alt="" />
                </span>
                <span>
                  <span class="nav-card-title">{l.label}</span>
                  <span class="nav-card-sub">{l.description}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </li>
    </ul>

    <div class="nav-actions">
      <a
        href="https://github.com/metabase/metabase"
        class="nav-stars hidden items-center gap-1.5 text-sm font-bold text-(--color-ink-2) hover:text-(--color-brand-hover) md:flex"
        {/* WCAG 2.5.3: the accessible name has to contain the visible text, and
            the visible text here is "49.6k". "Metabase on GitHub" dropped it,
            so anyone saying "click 49.6k" to a voice control had nothing to
            match. */}
        aria-label="49.6k GitHub stars — Metabase on GitHub"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#f5c518" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        49.6k
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.3-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.48.11-3.08 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.6.23 2.78.12 3.07.74.82 1.18 1.85 1.18 3.11 0 4.43-2.69 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/>
        </svg>
      </a>
      <a href="/pricing" class="btn-secondary hidden sm:inline-flex">Log in</a>
      <a href="/pricing" class="btn-primary">Get started</a>
      {/* The bars become a cross once the panel is open, as the original's do. */}
      <button type="button" class="nav-burger" data-mobile-toggle
              aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <svg class="nav-burger-open" width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
        <svg class="nav-burger-close" width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19"/>
        </svg>
      </button>
    </div>
  </nav>

  {/* A row per menu, each opening its own list, over a Log in pinned to the
      foot -- the shape the original uses below 992. */}
  <div class="nav-mobile" id="mobile-nav" data-mobile-panel>
    <div class="nav-mobile-scroll">
      {mobileNav.map((sec) => (
        <section class="nav-mobile-sec">
          <h2>
            <button type="button" class="nav-mobile-row" aria-expanded="false" data-msec>
              {sec.label}
              <svg class="nav-mobile-chev" width="14" height="9" viewBox="0 0 12 8" fill="none"
                   stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1.5 1.5 6 6l4.5-4.5"/></svg>
            </button>
          </h2>
          <div class="nav-mobile-items" hidden>
            {sec.items.map(([label, href, icon, sub]) => (
              <a href={href} class="nav-mobile-link">
                {icon && <NavIcon name={icon} size={24} />}
                <span class="nav-mobile-link-text">
                  <span class="nav-mobile-link-title">{label}</span>
                  {sub && <span class="nav-mobile-link-sub">{sub}</span>}
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
    <a href="/pricing" class="nav-mobile-login">Log in</a>
  </div>
</header>

<style>
  /* --- mobile navigation ------------------------------------------------
   * Measured off the original at 390: a 78-tall row per menu, 24/28 padding,
   * ruled off with a 1px #f1f2f4 hairline, over a Log in bar at the foot.
   * The panel fills what is left under the 74px bar and scrolls on its own,
   * so a long Features list cannot push Log in off the screen.
   */
  .nav-burger { display: none; }
  .nav-burger-close { display: none; }
  .nav-burger[aria-expanded='true'] .nav-burger-open { display: none; }
  .nav-burger[aria-expanded='true'] .nav-burger-close { display: block; }

  .nav-mobile { display: none; }

  @media (max-width: 1023px) {
    .nav-burger { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; }

    .nav-mobile {
      position: fixed; inset: 74px 0 0; z-index: 40;
      display: none; flex-direction: column;
      background: #fff;
      overscroll-behavior: contain;
    }
    .nav-mobile[data-open] { display: flex; }
    .nav-mobile-scroll { flex: 1 1 auto; overflow-y: auto; -webkit-overflow-scrolling: touch; }

    .nav-mobile-sec h2 { margin: 0; font: inherit; }
    .nav-mobile-row {
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
      width: 100%; padding: 24px 28px;
      border-bottom: 1px solid var(--color-line);
      font-size: 24px; line-height: 30px; font-weight: 700; color: var(--color-ink);
      text-align: left; background: none; cursor: pointer;
    }
    .nav-mobile-chev { flex: none; color: var(--color-brand); transition: rotate 200ms; }
    .nav-mobile-row[aria-expanded='true'] .nav-mobile-chev { rotate: 180deg; }

    .nav-mobile-link {
      display: flex; align-items: flex-start; gap: 12px;
      padding: 16px 28px;
      border-bottom: 1px solid var(--color-line);
      color: var(--color-ink);
    }
    .nav-mobile-link:active { background: var(--color-brand-faint); }
    .nav-mobile-link :global(svg) { flex: none; margin-top: 2px; color: var(--color-ink-3); }
    .nav-mobile-link-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .nav-mobile-link-title { font-size: 16px; line-height: 24px; font-weight: 700; }
    .nav-mobile-link-sub { font-size: 14px; line-height: 20px; color: var(--color-ink-3); }

    .nav-mobile-login {
      flex: none; display: block; padding: 24px;
      border-top: 1px solid var(--color-line);
      background: var(--color-brand-faint);
      font-size: 16px; line-height: 24px; font-weight: 700;
      color: var(--color-ink); text-align: center;
    }

    /* The bar stops scrolling with the page while the panel is open. */
    :global(body[data-nav-open]) { overflow: hidden; }
  }

  /* Measured off the original: 8px/12px padding in an 8px-radius box, the
     chevron 8px clear of the label. With a 10px gap between boxes that puts
     34px between one label and the next, which is what the original has. */
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    /* 40 tall on the original with 8px of padding, so the height is set
       rather than implied: 14px text at 1.33 leaves a 35px box otherwise. */
    height: 40px;
    padding: 8px 12px;
    font-size: 14px;
    line-height: 18.62px;
    font-weight: 700;
    color: var(--color-ink-2);
    border-radius: 8px;
    cursor: pointer;
  }
  /* Measured on the original: the trigger's own background stays transparent
     in every state. The light-blue box behind the open item is a separate
     element that slides, so it must not be duplicated here. Colour alone
     changes, over 0.1s. */
  .nav-trigger { transition: color 100ms ease; position: relative; z-index: 1; }
  .nav-trigger:hover, .nav-trigger[aria-expanded='true'] { color: var(--color-brand); }

  /* The sliding highlight. #eef6fc, 8px radius, 40 tall, `all 0.3s` — which is
     what makes it travel between items rather than blink from one to the
     next. It is hidden until JS has measured a target so it never animates in
     from 0,0 on first hover. */
  .nav-pill {
    position: absolute; top: 50%; left: 0;
    width: var(--pill-w, 0px); height: 40px;
    translate: var(--pill-x, 0px) -50%;
    border-radius: 8px;
    background: #eef6fc;
    opacity: var(--pill-o, 0);
    transition: translate 300ms ease, width 300ms ease, opacity 300ms ease;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) { .nav-pill { transition: opacity 300ms ease; } }
  /* Measured: a 24px-radius white sheet, no border, on a two-layer shadow,
     sitting flush under the bar rather than 8px below it. Sections provide
     their own padding, so the panel itself has none. */
  /* The row item fills the bar's height so `top: 100%` is the underside of the
     bar, not the underside of the 37px trigger — otherwise the panel opens
     18px too high. */
  .nav-menu { position: relative; }
  .nav-menu > li { display: flex; align-items: center; height: 74px; }

  .nav-panel {
    position: fixed; top: 72px; left: 50%;
    transform: translateX(-50%);
    overflow: hidden;
    background: #fff;
    border-radius: 24px;
    box-shadow: 0 16px 28px -6px rgb(24 39 75 / 0.12), 0 32px 88px -4px rgb(24 39 75 / 0.14);
    /* Closed: a touch small and transparent, and out of the tab order.
       The original scales 0.97 -> 1 over 100ms while opacity runs over 200ms. */
    transform: translateX(-50%) scale(0.97);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 200ms ease, transform 100ms ease, visibility 0s linear 200ms;
  }
  .nav-panel[data-open] {
    transform: translateX(-50%) scale(1);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 200ms ease, transform 100ms ease, visibility 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-panel { transition: opacity 200ms ease, visibility 0s linear 200ms; transform: translateX(-50%); }
    .nav-panel[data-open] { transition: opacity 200ms ease, visibility 0s; }
  }

  /* --- shared ---------------------------------------------------------- */
  .nav-cards { display: flex; gap: 12px; padding: 24px; }
  .nav-card {
    display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0;
    border: 1px solid #eef6fc; border-radius: 8px; padding: 12px;
  }
  /* Product and Pricing stand the artwork above the label; Docs sets it
     beside, which is why those cards are 71 tall against 143. The column
     spaces its two blocks over a fixed 117, which is how a 48-tall bar chart
     and a 56-tall illustration both land on the same card height. */
  .nav-card--stack {
    flex-direction: column; align-items: stretch;
    justify-content: space-between; gap: 0; min-height: 143px;
  }
  .nav-card-art { display: block; }
  .nav-card { transition: background-color 300ms ease, border-color 300ms ease, box-shadow 300ms ease; }
  .nav-card:hover {
    background: var(--color-brand-faint);
    border-color: var(--color-brand-muted);
    box-shadow: 0 4px 8px -2px rgb(16 24 40 / 0.1), 0 2px 4px -2px rgb(16 24 40 / 0.06);
  }
  /* --- the two Product cards' artwork --------------------------------- */
  /* Business Intelligence is a bar chart drawn in CSS, not an icon: six 5px
     bars on a tinted plate, each transitioning its own height over 400ms. On
     hover the series re-sorts, which is the whole point of it -- it reads as
     live data rather than a picture. Measured heights, rest and hovered. */
  .nav-bars {
    display: flex; align-items: flex-end; gap: 4px;
    width: 65px; height: 48px;
    padding: 7px 8px 6px; border-radius: 8px;
    background: #eef6fc;
  }
  .nav-bars > span {
    width: 5px; border-radius: 1px; background: var(--color-brand);
    transition: height 400ms ease;
  }
  .nav-bars > span:nth-child(1) { height: 20px; }
  .nav-bars > span:nth-child(2) { height: 30px; }
  .nav-bars > span:nth-child(3) { height: 35px; }
  .nav-bars > span:nth-child(4) { height: 24px; }
  .nav-bars > span:nth-child(5) { height: 16px; }
  .nav-bars > span:nth-child(6) { height: 20px; }
  .nav-card:hover .nav-bars > span:nth-child(1) { height: 20px; }
  .nav-card:hover .nav-bars > span:nth-child(2) { height: 19px; }
  .nav-card:hover .nav-bars > span:nth-child(3) { height: 25px; }
  .nav-card:hover .nav-bars > span:nth-child(4) { height: 35px; }
  .nav-card:hover .nav-bars > span:nth-child(5) { height: 24px; }
  .nav-card:hover .nav-bars > span:nth-child(6) { height: 16px; }

  /* Embedded Analytics is a flat illustration standing proud of its plate --
     76x71 of artwork over 64x48 of background -- held at -15deg and
     straightening on hover over 400ms. */
  .nav-embed {
    display: grid; place-items: center;
    width: 64px; height: 48px;
    border-radius: 8px;
    background: url('/images/nav/embed-background.svg') center / cover no-repeat;
  }
  /* 64x56 of artwork; the 76x71 it measures is that box once rotated. */
  .nav-embed img {
    width: 64px; height: 56px; max-width: none;
    transform: rotate(-15deg);
    transition: transform 400ms ease;
  }
  .nav-card:hover .nav-embed img { transform: rotate(0deg); }
  @media (prefers-reduced-motion: reduce) {
    .nav-embed img { transform: none; }
    .nav-bars > span, .nav-embed img { transition: none; }
  }
  /* Product and Pricing stand the icon on a tile above the label; Docs sets it
     beside, which is why its cards are 71 tall rather than 138. */
  .nav-card-tile {
    display: grid; place-items: center; width: 48px; height: 48px;
    margin-bottom: 24px; border-radius: 8px;
    background: var(--color-brand-muted); color: var(--color-brand);
  }
  .nav-card--row { display: flex; gap: 10px; align-items: flex-start; }
  .nav-card-ico { flex: none; color: var(--color-brand); }
  .nav-card-title { display: block; font-size: 14px; line-height: 18.62px; font-weight: 700; color: var(--color-ink-2); }
  /* The original's #8d93a5 is 2.6:1; one stop down the ramp as elsewhere. */
  .nav-card-sub { display: block; font-size: 14px; line-height: 26px; color: var(--color-ink-3); }

  .nav-eyebrow {
    display: block; margin-bottom: 16px; padding-left: 8px;
    font-size: 11px; line-height: 13.2px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-3);
  }

  /* --- Features: two columns of icon links ------------------------------- */
  .nav-icon-cols { display: flex; gap: 49px; padding: 24px; }
  .nav-icon-cols > div { display: flex; flex-direction: column; gap: 12px; flex: 1; min-width: 0; }
  /* Sampled from a screenshot of the original's open panel rather than read
     off computed style, which reports the anchor's inherited brand blue: the
     label renders #5a6072 and the icon #8d93a5. Item box 232x33, rows 45
     apart, 16/24/700, colour transitioning over 300ms. */
  .nav-icon-link {
    display: flex; align-items: center; gap: 10px; padding: 4px 8px; height: 33px;
    font-size: 14px; line-height: 24px; font-weight: 700; color: var(--color-ink-2);
    transition: color 300ms ease;
  }
  .nav-icon-link > :global(svg) { flex: none; color: var(--color-ink-4-mid, #8d93a5); transition: color 300ms ease; }
  .nav-icon-link:hover { color: var(--color-brand); }
  .nav-icon-link:hover > :global(svg) { color: var(--color-brand); }

  /* --- Docs: tinted lower section ---------------------------------------- */
  .nav-sub-section { display: flex; gap: 12px; padding: 0 24px; background: var(--color-brand-faint); }
  /* 427 / 255 on the original, with a hairline between them. */
  /* The original's two columns are 427 and 255 inside the section's own 24 of
     padding, with nothing between them but the 12 gap. The inner padding here
     was eating 24 off each, which is why every row in this menu measured
     exactly 24 narrow. */
  .nav-col-wide {
    flex: 0 0 427px; min-width: 0; padding: 24px 0;
    border-right: 1px solid var(--color-brand-muted);
  }
  .nav-col-narrow { flex: 1; min-width: 0; padding: 24px 0; }

  .nav-rich { display: flex; gap: 10px; align-items: center; padding: 12px 0; }
  /* The Docs list drops the bottom padding on its last row, which is what
     keeps that panel 419 tall rather than 430. The Resources list keeps it,
     so this is scoped rather than applied to every `.nav-rich`. */
  .nav-col-wide .nav-rich:last-child { padding-bottom: 0; }
  .nav-rich-ico {
    display: grid; place-items: center; flex: none; width: 54px; height: 54px;
    color: var(--color-brand);
  }
  /* Resources rows are the muted grey of every other menu list; only the Docs
     category illustrations are brand blue, which is why one rule for both put
     blue icons down the Resources column. Their rows are also tighter: the
     original sets 4px 8px against the 12px 0 the Docs rows use. */
  .nav-rich--sm { padding: 4px 8px; }
  .nav-rich--sm .nav-rich-ico {
    width: 38px; height: 38px;
    color: var(--color-ink-3);
    background: transparent; box-shadow: none;
  }
  .nav-rich--sm:hover .nav-rich-ico { color: var(--color-brand); }
  .nav-rich-label { display: block; font-size: 14px; line-height: 26px; color: var(--color-ink-3); }
  .nav-rich-title { display: block; font-size: 14px; line-height: 24px; font-weight: 700; color: var(--color-ink-2); }
  .nav-rich-desc { display: block; font-size: 14px; line-height: 20px; font-weight: 700; color: var(--color-ink-2); }
  .nav-rich--sm .nav-rich-desc { font-weight: 400; color: var(--color-ink-3); }
  .nav-rich:hover .nav-rich-desc, .nav-rich:hover .nav-rich-title { color: var(--color-brand-hover); }

  .nav-ruled {
    display: block; padding: 10px 0;
    border-bottom: 1px solid var(--color-brand-muted);
    font-size: 14px; line-height: 21px; font-weight: 700; color: var(--color-ink-2);
  }
  .nav-ruled:last-child { padding-bottom: 0; border-bottom: 0; }
  /* Resources lists its posts with a 12px gap and no rule — only the Docs
     guides column is ruled. */
  .nav-post {
    display: block; margin-bottom: 12px;
    font-size: 14px; line-height: 19px; font-weight: 700; color: var(--color-ink-2);
  }
  .nav-post:hover { color: var(--color-brand-hover); }
  .nav-ruled:last-child { border-bottom: 0; }
  .nav-ruled:hover { color: var(--color-brand-hover); }

  /* --- Resources --------------------------------------------------------- */
  .nav-res { display: flex; gap: 24px; padding: 24px; }
  .nav-res-links { flex: 1.2; min-width: 0; }
  .nav-res-posts { flex: 1; min-width: 0; }

  .nav-badge {
    margin-left: 6px; border-radius: 4px; background: var(--color-brand-muted);
    padding: 1px 4px; font-size: 12px; line-height: 12px; font-weight: 700;
    color: var(--color-brand-hover);
  }

  /* --- footer strip ------------------------------------------------------ */
  .nav-foot {
    display: flex; gap: 24px; padding: 24px 32px;
    background: #f9fbfe; border-top: 1px solid var(--color-brand-muted);
  }
  .nav-foot a {
    display: flex; flex: 1; align-items: center; justify-content: center; gap: 8px;
    border: 1px solid var(--color-brand-muted); border-radius: 8px; padding: 12px 0;
    font-size: 14px; line-height: 21px; font-weight: 700; color: var(--color-ink-2);
  }
  /* The strip's icons are the same muted grey as the menu lists. They were
     inheriting the anchor's brand blue, which is why every footer icon read
     as the wrong colour while the lists above them were right. */
  .nav-foot a > :global(svg) { color: var(--color-ink-3); transition: color 300ms ease; }
  .nav-foot a:hover > :global(svg) { color: var(--color-brand); }
  .nav-foot a:hover { border-color: var(--color-brand); color: var(--color-brand-hover); }

  /* The original transitions each icon path's colour over 300ms, so an icon
     warms up with the row it sits in rather than switching instantly. */
  :global(.nav-icon path) { transition: stroke 300ms ease, fill 300ms ease; }
  .nav-card:hover :global(.nav-icon path),
  .nav-rich:hover :global(.nav-icon path),
  .nav-foot a:hover :global(.nav-icon path) { stroke: var(--color-brand-hover); }
  .nav-card:hover .nav-card-tile { background: var(--color-brand-border); }
  .nav-chevron { transition: rotate 150ms; }
  .nav-trigger[aria-expanded='true'] .nav-chevron { rotate: 180deg; }
</style>

<script>
  // The only navigation JS: open/close the megamenus and keep aria-expanded
  // honest. Everything else on the page is static HTML.
  const root = document.querySelector('[data-menu-root]');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-menu]')];
  const panels = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-panel]')].map((p) => [p.dataset.panel!, p])
  );

  /*
   * The sliding highlight. The original keeps its triggers transparent and
   * moves one #eef6fc pill between them with `all 0.3s`, so the box appears to
   * travel rather than blink. The pill is positioned from the live trigger box
   * so it stays correct when the bar reflows.
   */
  const pill = document.querySelector<HTMLElement>('[data-pill]');
  const menuRoot = document.querySelector<HTMLElement>('[data-menu-root]');
  const movePill = (to: HTMLElement | null) => {
    if (!pill || !menuRoot) return;
    if (!to) { pill.style.setProperty('--pill-o', '0'); return; }
    const a = to.getBoundingClientRect();
    const b = menuRoot.getBoundingClientRect();
    pill.style.setProperty('--pill-x', `${Math.round(a.left - b.left)}px`);
    pill.style.setProperty('--pill-w', `${Math.round(a.width)}px`);
    pill.style.setProperty('--pill-o', '1');
  };

  const closeAll = (except?: string) => {
    triggers.forEach((t) => {
      const name = t.dataset.menu!;
      if (name === except) return;
      t.setAttribute('aria-expanded', 'false');
      delete panels.get(name)!.dataset.open;
    });
  };

  triggers.forEach((trigger) => {
    const name = trigger.dataset.menu!;
    const panel = panels.get(name)!;
    const show = (on: boolean) => {
      if (on) closeAll(name);
      trigger.setAttribute('aria-expanded', String(on));
      if (on) panel.dataset.open = '';
      else delete panel.dataset.open;
      /* Moving between two items fires the new one's enter before the old
       * one's leave, so clearing the pill unconditionally on close would wipe
       * the highlight that the item being entered has just claimed. Only
       * retract it once nothing is open. */
      if (on) movePill(trigger);
      else if (!triggers.some((t) => t.getAttribute('aria-expanded') === 'true')) movePill(null);
    };

    /*
     * The original opens these on hover. Hover alone would leave the menus
     * unreachable by keyboard, so click still toggles and Escape still closes;
     * hover is layered on top for pointers that have it. `any-hover` keeps it
     * off touch, where a hover would fire on the tap that should navigate.
     */
    const item = trigger.parentElement;
    if (item && window.matchMedia('(any-hover: hover)').matches) {
      let leaveTimer: number | undefined;
      item.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType === 'touch') return;
        window.clearTimeout(leaveTimer);
        show(true);
      });
      item.addEventListener('pointerleave', () => {
        // A short grace period, so crossing the gap to the panel does not
        // close it.
        leaveTimer = window.setTimeout(() => show(false), 120);
      });
    }

    trigger.addEventListener('click', () => {
      show(trigger.getAttribute('aria-expanded') !== 'true');
    });
  });

  const closeEverything = () => { closeAll(); movePill(null); };
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeEverything(); });
  document.addEventListener('click', (e) => {
    if (root && !root.contains(e.target as Node)) closeEverything();
  });

  /*
   * The panel used to be toggled by its `hidden` attribute while a Tailwind
   * `hidden` class held display:none, so it never opened at all -- on a phone
   * the only navigation was the logo and Get started. It opens on a data
   * attribute now, which is what the CSS above reads.
   */
  const mobileToggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const mobilePanel = document.querySelector<HTMLElement>('[data-mobile-panel]');
  const sections = [...document.querySelectorAll<HTMLButtonElement>('[data-msec]')];

  const setOpen = (open: boolean) => {
    if (!mobileToggle || !mobilePanel) return;
    mobileToggle.setAttribute('aria-expanded', String(open));
    mobileToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobilePanel.toggleAttribute('data-open', open);
    document.body.toggleAttribute('data-nav-open', open);
    if (!open) sections.forEach(collapse);
  };

  const collapse = (btn: HTMLButtonElement) => {
    btn.setAttribute('aria-expanded', 'false');
    const items = btn.closest('section')?.querySelector<HTMLElement>('.nav-mobile-items');
    if (items) items.hidden = true;
  };

  mobileToggle?.addEventListener('click', () =>
    setOpen(mobileToggle.getAttribute('aria-expanded') !== 'true'));

  /* One section open at a time, as the original does. */
  sections.forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      sections.forEach(collapse);
      if (open) return;
      btn.setAttribute('aria-expanded', 'true');
      const items = btn.closest('section')?.querySelector<HTMLElement>('.nav-mobile-items');
      if (items) items.hidden = false;
    });
  });

  /* Following a link, pressing Escape, or widening past the breakpoint all
     close it -- otherwise the panel survives as a stuck overlay on desktop. */
  mobilePanel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileToggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      mobileToggle.focus();
    }
  });
  const wide = window.matchMedia('(min-width: 1024px)');
  wide.addEventListener('change', () => { if (wide.matches) setOpen(false); });
</script>
