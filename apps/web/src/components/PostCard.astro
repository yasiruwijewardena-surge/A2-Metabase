---
import CldImage from './CldImage.astro';
import Avatar from './Avatar.astro';
import type { Post } from '../lib/types';

interface Props { post: Post; featured?: boolean; eager?: boolean }
const { post, featured = false, eager = false } = Astro.props;

const date = new Date(post.publishedDate).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric',
});
---
<article class={featured ? 'mb-8' : ''}>
  <div class={featured ? 'blog-card' : ''}>
  {featured && (
    <CldImage
      image={post.coverImage}
      priority={eager}
      class="mb-8 w-full rounded-md"
    />
  )}

  <span class="mb-3 block text-base text-(--color-ink-3)">
    {date}{post.category && <> in <b class="font-bold">{post.category.name}</b></>}
  </span>

  {/* These cards sit directly under the page h1, so they are h2 — jumping
      straight to h3 is what PSI flags as a non-sequential heading order. */}
  {/* 24px / 1.33 / weight 700 — the original's card titles are bold, not the
      900 its page headings use. */}
  <h2 class={featured ? 'mb-4 text-[1.5rem] leading-[1.33] font-bold' : 'mb-1 text-lg leading-snug font-bold'}>
    <a href={`/blog/${post.slug}`} class="hover:text-(--color-brand-hover)">{post.title}</a>
  </h2>

  {featured && <p class="mb-6 text-base text-(--color-ink-2)">{post.excerpt}</p>}

  <div class="flex flex-row items-center gap-2 text-base text-(--color-ink-3)">
    {featured && <Avatar image={post.author?.avatar} size={36} class="h-9 w-9" />}
    {post.author && (
      <a href={`/blog/authors/${post.author.slug}`} class="font-bold text-(--color-ink-2) hover:text-(--color-brand-hover)">
        {post.author.name}
      </a>
    )}
    {post.readTimeMinutes && <span>‧ {post.readTimeMinutes} min read</span>}
  </div>
  </div>
</article>
