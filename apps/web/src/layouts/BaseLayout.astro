---
import '../styles/global.css';

// Self-hosted, latin subset only. The Google Fonts stylesheet was the single
// largest render-blocking request on the page at ~751 ms; bundling the
// @font-face rules into the page CSS removes that request entirely.
import '@fontsource/lato/latin-400.css';
import '@fontsource/lato/latin-700.css';
import '@fontsource/lato/latin-900.css';

// Body and heading weights are needed for the first paint, and a font inside a
// stylesheet is only discovered once that stylesheet has parsed. Preloading the
// weights used above the fold cuts that extra round trip. Imported as URLs so
// the hashes stay correct across builds.
//
// 700 belongs here as much as the other two: it is the weight nearly every
// heading on the product, features and roadmap pages is set in, and leaving it
// to be discovered after the stylesheet parsed was holding first paint.
import lato400 from '@fontsource/lato/files/lato-latin-400-normal.woff2?url';
import lato700 from '@fontsource/lato/files/lato-latin-700-normal.woff2?url';
import lato900 from '@fontsource/lato/files/lato-latin-900-normal.woff2?url';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import type { Seo } from '../lib/types';
import type { PreloadAttrs } from '../lib/image';

interface Props {
  title: string;
  description?: string;
  seo?: Seo | null;
  ogImage?: string | null;
  /** LCP image descriptor, preloaded so it is discovered in the first HTML scan
      rather than after layout. Built by `preloadFor` so imagesrcset and
      imagesizes mirror the <img> exactly; without them the browser preloads one
      candidate and downloads a different one. The original does the opposite
      again — its blog LCP image is lazy-loaded. See SITE-ANALYSIS.md §2. */
  preload?: PreloadAttrs | null;
  noIndex?: boolean;
}

const { title, description, seo, ogImage, preload, noIndex } = Astro.props;

const metaTitle = seo?.metaTitle || title;
const metaDesc = seo?.metaDescription || description || '';
const canonical = seo?.canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;
const social = ogImage || seo?.ogImage?.url || null;
const blocked = noIndex || seo?.noIndex;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{metaTitle}</title>
    {metaDesc && <meta name="description" content={metaDesc} />}
    <link rel="canonical" href={canonical} />
    {blocked && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Metabase" />
    <meta property="og:title" content={metaTitle} />
    {metaDesc && <meta property="og:description" content={metaDesc} />}
    <meta property="og:url" content={canonical} />
    {social && <meta property="og:image" content={social} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="font" type="font/woff2" href={lato400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={lato700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={lato900} crossorigin />

    {preload && (
      <link
        rel="preload"
        as="image"
        href={preload.href}
        imagesrcset={preload.imagesrcset}
        imagesizes={preload.imagesizes}
        fetchpriority="high"
      />
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:shadow">Skip to content</a>
    <Navbar />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
