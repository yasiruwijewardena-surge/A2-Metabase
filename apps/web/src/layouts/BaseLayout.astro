---
import '../styles/global.css';

// Self-hosted, latin subset only. The Google Fonts stylesheet was the single
// largest render-blocking request on the page at ~751 ms; bundling the
// @font-face rules into the page CSS removes that request entirely.
import '@fontsource/lato/latin-400.css';
import '@fontsource/lato/latin-700.css';
import '@fontsource/lato/latin-900.css';

// Body and heading weights are needed for the first paint, and a font inside a
// stylesheet is only discovered once that stylesheet has parsed. Preloading the
// weights used above the fold cuts that extra round trip. Imported as URLs so
// the hashes stay correct across builds.
//
// 700 belongs here as much as the other two: it is the weight nearly every
// heading on the product, features and roadmap pages is set in, and leaving it
// to be discovered after the stylesheet parsed was holding first paint.
import lato400 from '@fontsource/lato/files/lato-latin-400-normal.woff2?url';
import lato700 from '@fontsource/lato/files/lato-latin-700-normal.woff2?url';
import lato900 from '@fontsource/lato/files/lato-latin-900-normal.woff2?url';
import Navbar from '../components/Navbar.astro';
import { getSiteSettings } from '../lib/strapi';
import { cld } from '../lib/image';
import Footer from '../components/Footer.astro';
import type { Seo } from '../lib/types';
import type { PreloadAttrs } from '../lib/image';

interface Props {
  title: string;
  description?: string;
  seo?: Seo | null;
  ogImage?: string | null;
  /** LCP image descriptor, preloaded so it is discovered in the first HTML scan
      rather than after layout. Built by `preloadFor` so imagesrcset and
      imagesizes mirror the <img> exactly; without them the browser preloads one
      candidate and downloads a different one. The original does the opposite
      again — its blog LCP image is lazy-loaded. See SITE-ANALYSIS.md §2. */
  preload?: PreloadAttrs | null;
  noIndex?: boolean;
}

const { title, description, seo, ogImage, preload, noIndex } = Astro.props;

/* Read first: the fallbacks below come from here. */
const site = await getSiteSettings();
const siteName = site?.siteName || 'Metabase';

const metaTitle = seo?.metaTitle || title;
/* A page's own description wins; the site-wide one is the floor, so a page
   that sets none still has something in search results and link previews. */
const metaDesc = seo?.metaDescription || description || site?.defaultMetaDescription || '';
const canonical = seo?.canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;
const social = ogImage || seo?.ogImage?.url || site?.defaultSocialImage?.url || null;
const blocked = noIndex || seo?.noIndex;

/*
 * The tab icon. Site Settings wins when an editor has set one; otherwise the
 * file bundled with the site is used, so a database with no settings still has
 * an icon rather than whatever the browser guesses.
 *
 * Both links are deliberate. SVG is sharp at every size and is what modern
 * browsers take; the .ico is the fallback for the ones that do not, and naming
 * it explicitly is better than relying on browsers probing /favicon.ico.
 */
const faviconUrl = site?.favicon?.url ?? '/favicon.svg';
const faviconType = faviconUrl.endsWith('.svg') ? 'image/svg+xml' : undefined;

/*
 * iOS wants a square raster of its own and ignores an SVG. When the icon comes
 * from the CMS, Cloudinary can produce that square from the same upload, so an
 * editor does not have to supply a second file. `cld` returns the url
 * untouched for anything it does not serve, which is why the bundled fallback
 * is not sent down this path.
 */
const squared = site?.favicon?.url
  ? cld(site.favicon.url, 'f_png,c_pad,b_white,w_180,h_180')
  : null;
/* `cld` hands back the url unchanged for anything it does not serve. Emitting
   that would advertise the original file -- an SVG, most likely -- as an
   apple-touch icon, which iOS ignores, so only link it when the transform
   actually took. */
const appleTouch = squared && squared !== site?.favicon?.url ? squared : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    {/* Every image on the site is delivered by Cloudinary, so the first one
        costs a DNS lookup, a TCP handshake and a TLS negotiation before a byte
        of it arrives -- measured at ~176ms. Opening that connection while the
        head is still parsing takes it off the critical path.

        Pages whose LCP is an image already absorb this through the preload
        below; this is for the ones the preload deliberately skips, where the
        first Cloudinary request is further down the page -- the home page's
        logo strip, a card thumbnail -- and would otherwise pay in full.

        No `crossorigin`: the images are plain <img> with no crossorigin
        attribute, so they are no-CORS requests. A CORS preconnect opens a
        connection in a different pool that those requests cannot reuse, which
        would warm a socket nobody touches and cost a second handshake. */}
    <link rel="preconnect" href="https://res.cloudinary.com" />

    <link rel="icon" href={faviconUrl} type={faviconType} />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    {appleTouch && <link rel="apple-touch-icon" sizes="180x180" href={appleTouch} />}

    <title>{metaTitle}</title>
    {metaDesc && <meta name="description" content={metaDesc} />}
    <link rel="canonical" href={canonical} />
    {blocked && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={metaTitle} />
    {metaDesc && <meta property="og:description" content={metaDesc} />}
    <meta property="og:url" content={canonical} />
    {social && <meta property="og:image" content={social} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="font" type="font/woff2" href={lato400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={lato700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={lato900} crossorigin />

    {preload && (
      <link
        rel="preload"
        as="image"
        href={preload.href}
        imagesrcset={preload.imagesrcset}
        imagesizes={preload.imagesizes}
        fetchpriority="high"
      />
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Whatever Site Settings carries for the head -- a tag manager, say.
        Written by an administrator and baked in at build time, so it is the
        same trust boundary as the rest of the templates. */}
    {site?.headScripts && <Fragment set:html={site.headScripts} />}
  </head>
  <body>
    {site?.bodyScripts && <Fragment set:html={site.bodyScripts} />}
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:shadow">Skip to content</a>
    <Navbar />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
