---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { src as atWidth } from '../../../lib/image';
import BlogListing from '../../../components/BlogListing.astro';
import { getPosts, getCategories } from '../../../lib/strapi';

export async function getStaticPaths() {
  const [posts, categories] = await Promise.all([getPosts(), getCategories()]);
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      categories,
      posts: posts.filter((p) => p.category?.slug === category.slug),
    },
  }));
}

const { category, categories, posts } = Astro.props;
---
<BaseLayout
  title={`${category.name} | Metabase Blog`}
  description={category.description ?? `Posts in ${category.name}.`}
  preloadImage={posts[0]?.coverImage ? atWidth(posts[0].coverImage.url, 760) : null}
>
  <BlogListing posts={posts} categories={categories} active={category.slug} />
</BaseLayout>
