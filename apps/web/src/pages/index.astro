---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import CldImage from '../components/CldImage.astro';
import { getCaseStudies, getTestimonials } from '../lib/strapi';
import HeroDashboard from '../components/HeroDashboard.astro';
import PaymentsDashboard from '../components/demos/PaymentsDashboard.astro';
import DataStudioAccount from '../components/demos/DataStudioAccount.astro';
import MetabotChat from '../components/demos/MetabotChat.astro';
import EmbeddedDashboard from '../components/demos/EmbeddedDashboard.astro';
import ScaleIcon from '../components/ScaleIcon.astro';
import CopyCommand from '../components/CopyCommand.astro';
import DataSourceMarquee from '../components/DataSourceMarquee.astro';
import EyebrowArrow from '../components/EyebrowArrow.astro';
import EaFeatureIcon from '../components/EaFeatureIcon.astro';
import { thumbSet } from '../lib/image';

/*
 * The pull-quote portraits are a landscape 84x50 slot on the original. These
 * people are fictional personas, so there is no photograph to put in it —
 * initials fill the same slot rather than collapsing the row's geometry.
 */
const initialsOf = (name?: string | null) =>
  (name ?? '').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]?.toUpperCase()).join('');

const [cases, testimonials] = await Promise.all([getCaseStudies(), getTestimonials()]);

const pullQuotes = testimonials
  .filter((t) => t.variant === 'pull-quote')
  .sort((a, b) => Number(b.featured) - Number(a.featured) || a.displayOrder - b.displayOrder);

const social = testimonials
  .filter((t) => t.variant === 'social')
  .sort((a, b) => Number(b.featured) - Number(a.featured) || a.displayOrder - b.displayOrder);


/** The customer logo strip, matching the original's row. */
const logos = [
  ['Huggingface', 'Hugging Face'], ['mcdonalds', "McDonald's"], ['huma', 'Huma'],
  ['capital-one', 'Capital One'], ['mistral', 'Mistral'], ['linear', 'Linear'],
  ['deutsche-telekom', 'Deutsche Telekom'], ['kong', 'Kong'],
];


/** The three supporting points under Embedded Analytics, each on its own card. */
const eaFeatures = [
  { icon: 'window' as const,
    title: 'Way less engineering overhead than rolling your own in-app reporting',
    body: 'Data teams and non-technical teammates can work with data without bugging devs.' },
  { icon: 'package' as const,
    title: 'Self-host or deploy on Metabase Cloud',
    body: 'Start with simple charts, embed full dashboards, or use the SDK for advanced setups as your needs grow.' },
  { icon: 'shield' as const,
    title: 'Customizable to fit your product',
    body: 'White-labeling, dynamic styling, and interactive controls from view-only to full data discovery with a low-code integration.' },
];

/** "Metabase scales as you grow" — six cards, each with an inline feature link. */
const scaleCards = [
  { icon: 'grid', title: 'Multi-tenant data segregation',
    link: ['Granular permissions', '/features/data-segregation'],
    tail: ' to make sure people see what they need to, and nothing else.' },
  { icon: 'eye', title: 'Secure and simple access', link: null,
    tail: 'Integrate with SSO IdPs (SAML, LDAP, JWT, Google) and map to Metabase groups.' },
  { icon: 'terminal', title: 'Drop into SQL',
    lead: 'When you need an ', link: ['escape hatch into SQL', '/features/sql-editor'],
    tail: " to run raw queries, tweak logic, or join tables, you're covered." },
  { icon: 'chart', title: 'Track data and dashboard usage',
    link: ['No more unused dashboards', '/features/usage-analytics'],
    tail: '. Inspect user behavior across content, data access and downloads.' },
  { icon: 'bolt', title: 'Keep dashboards snappy',
    lead: 'Go faster with ', link: ['result and model caching', '/docs'],
    tail: '. No schedulers or pipelines needed.' },
  { icon: 'layers', title: 'Test and deploy safely',
    lead: 'Spin up ', link: ['staging environments', '/docs'],
    tail: ' without touching prod. Export configs, models, and dashboards to test or scale across multiple instances.' },
];

const biPoints = [
  {
    mock: 'ai' as const,
    frame: 'query' as const,
    title: 'Query data in plain English with AI',
    body: 'AI on all plans so anyone can explore data, visualize results, and answer their own questions. Ask Metabot AI or connect to the MCP server, click on charts to find the "why" with built-in drilldowns, or spin up a no-code query with the visual query builder.',
    link: ['Explore Metabase AI', '/features/metabase-ai'],
  },
  {
    mock: 'dashboard' as const,
    frame: 'share' as const,
    title: 'Share reports and create custom insights',
    body: 'Filter and breakout interactive dashboards. Combine charts with text in Documents for collaborative reporting. Set up subscriptions and alerts to keep everyone in the loop.',
    link: ['Explore interactive dashboards', '/features/analytics-dashboards'],
  },
  {
    mock: 'semantic' as const,
    frame: 'guide' as const,
    title: 'Guide people to the right answers',
    body: 'Curate your semantic layer in Data Studio to make your data usable and correct for humans and AI. Define trusted, reusable metrics, and mark vetted data sources so everyone builds on consistent, accurate foundations.',
    link: ['Explore Data Studio', '/product/data-studio'],
  },
];
---
<BaseLayout
  title="Metabase | Open source Business Intelligence and Embedded Analytics"
  description="Metabase gives you answers guided by your semantic layer — your metrics and business logic — whether reached by an agent or a teammate. Inspect the query behind every answer."
>
  <!-- Hero -->
  <section class="hero-band">
    <div class="container-mb">
      <div class="hero-content">
        <h1>Open source AI analytics<br />you can verify</h1>
        <p class="hero-sub">
          Metabase gives you answers guided by your semantic layer — your metrics and business
          logic — whether reached by an agent or a teammate. Inspect the query behind every answer.
        </p>
        <div class="hero-cta">
          <a href="/start" class="btn-primary">Try Metabase Cloud free</a>
          <a href="/open-source" class="btn-secondary">Deploy Metabase Open Source</a>
        </div>
      </div>

      <HeroDashboard />

      <div class="hero-trust">
        <p class="hero-trust-label">Trusted by 100,000+ companies</p>
        <ul class="hero-logos">
          {logos.map(([file, name]) => (
            <li>
              <img src={`/images/logos/${file}.svg`} alt={name} width="135" height="38"
                   loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>

      <a href="/demo" class="hero-tour">
        <span class="hero-tour__play" aria-hidden="true">
          <svg width="15" height="18" viewBox="0 0 18 20" fill="currentColor"><path d="M0 0l18 10L0 20z"/></svg>
        </span>
        <span class="hero-tour__label">Watch a 1-minute demo</span>
        <span class="hero-tour__media" aria-hidden="true">
          <img src="/images/home/tour-dashboard.webp" alt="" width="380" height="130"
               loading="lazy" decoding="async" />
          <img src="/images/home/tour-presenter.webp" alt="" width="104" height="104"
               loading="lazy" decoding="async" />
        </span>
      </a>
    </div>
  </section>

  <!-- Deploy -->
  <section class="pt-[120px] pb-[140px]">
    <div class="container-mb">
      {/* Centred with an 840px standfirst at 20/28, as every section header on
          the original is. */}
      <header class="mb-14 text-center">
        <h2 class="mb-6">Deploy in minutes, scale infinitely</h2>
        <p class="section-standfirst">
          Start simple. Keep your data secure and compliant as you grow. From pre-seed to post-IPO.
        </p>
      </header>
      <div class="grid gap-8 md:grid-cols-3">
        <div>
          <div class="frontier-visual">
            <CopyCommand command="docker run -d -p 3000:3000 metabase/metabase" />
          </div>
          <h3 class="mb-2">Always open source</h3>
          <p class="frontier-text">
            Run the script to spin up your free, self-hosted instance in minutes. Ships with AI
            features. Used by millions worldwide.
          </p>
        </div>
        <div>
          <div class="frontier-visual">
            <DataSourceMarquee />
          </div>
          <h3 class="mb-2">Connect your data and your tools</h3>
          <p class="frontier-text">
            Query and visualize data from your database or warehouse. Work with your data via the
            MCP server, CLI, APIs, Slack, and more.
          </p>
        </div>
        <div>
          <div class="frontier-visual">
            <div class="grid grid-cols-2 gap-2">
              {[
                ['soc-2-type-1-badge', 'SOC 2 Type 1'],
                ['soc-2-type-2-badge', 'SOC 2 Type 2'],
                ['gdpr-certificate-badge', 'GDPR'],
                ['ccpa-certificate-badge', 'CCPA Certificate'],
              ].map(([file, label]) => (
                <a href="/security" class="badge-link" aria-label={label}>
                  <img src={`/images/home/${file}.png`} alt={label} width="93" height="93"
                       class="h-[93px] w-[93px] object-contain" loading="lazy" decoding="async" />
                </a>
              ))}
            </div>
          </div>
          <h3 class="mb-2">Enterprise-grade security</h3>
          <p class="frontier-text">
            We treat your data the way we'd want ours — it's secure and compliant (SOC1, SOC2,
            GDPR, CCPA, and more).
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Business Intelligence -->
  <section class="pt-24 pb-14">
    <div class="container-mb">
      <header class="mx-auto mb-14 text-center">
        <a href="/product/business-intelligence" class="eyebrow-link">
          Business Intelligence
          <EyebrowArrow />
        </a>
        <h2 class="mb-6">Analytics your team will use and trust</h2>
        <p class="section-standfirst">
          Teams can explore data on their own, guided to correct answers with a trustworthy
          foundation. Your data team can curate a governed semantic layer of canonical tables
          and metrics in Data Studio.
        </p>
      </header>

      <div>
        {biPoints.map((point, i) => (
          <article class:list={['bi-panel', i % 2 === 1 && 'bi-panel--reverse']}>
            <div class="panel-copy">
              <h3 class="panel-heading">{point.title}</h3>
              <p class="panel-text">{point.body}</p>
              <a href={point.link[1]} class="panel-cta">
                {point.link[0]}
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M5.5 3.5L9 7L5.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>

              {pullQuotes[i] && (
                <figure class="panel-quote">
                  <blockquote>"{pullQuotes[i].quote}"</blockquote>
                  <figcaption>
                    {pullQuotes[i].person?.avatar?.url ? (
                      <img
                        class="quote-thumb"
                        src={thumbSet(pullQuotes[i].person.avatar.url, 84, 50).src}
                        srcset={thumbSet(pullQuotes[i].person.avatar.url, 84, 50).srcset}
                        width="84"
                        height="50"
                        alt={`Photo of ${pullQuotes[i].person?.name}`}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="quote-thumb quote-thumb--initials" aria-hidden="true">
                        {initialsOf(pullQuotes[i].person?.name)}
                      </span>
                    )}
                    <span class="quote-meta">
                      <span class="quote-author">{pullQuotes[i].person?.name}</span>
                      <span class="quote-company">
                        {pullQuotes[i].person?.role}{pullQuotes[i].person?.company?.name && <>, {pullQuotes[i].person.company.name}</>}
                      </span>
                    </span>
                  </figcaption>
                </figure>
              )}
            </div>

            <div class="panel-media">
              <div class:list={['bi-frame', `bi-frame--${point.frame}`]}>
                {point.mock === 'ai' && <MetabotChat />}
                {point.mock === 'dashboard' && <PaymentsDashboard />}
                {point.mock === 'semantic' && <DataStudioAccount />}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Embedded Analytics -->
  <section class="pt-24 pb-0">
    <div class="container-mb">
      <header class="mb-10 text-center">
        <a href="/product/embedded-analytics" class="eyebrow-link">
          Embedded Analytics
          <EyebrowArrow />
        </a>
        <h2 class="mx-auto mb-6 max-w-[640px]">
          Put production-grade analytics into your app without drama
        </h2>
        <p class="section-standfirst">
          Embed dashboards, visualizations, and self-serve reporting in your SaaS app.
          Multi-tenant, customizable analytics components, with plumbing and permissions built in.
        </p>
      </header>

      <EmbeddedDashboard />

      <div class="ea-features">
        {eaFeatures.map((f) => (
          <div class="ea-feature">
            <span class="ea-feature-icon"><EaFeatureIcon name={f.icon} /></span>
            <h3 class="ea-feature-title">{f.title}</h3>
            <p class="ea-feature-text">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Metabase scales as you grow -->
  {/* Not a plain section on the original but a tinted slab inset 60px from
      the viewport, with its own 80/72 padding and a 12px radius. */}
  <section class="scales-section">
    <div class="scales-slab">
      <h2 class="scales-title">Metabase scales as you grow</h2>
      <p class="scales-standfirst">
        Advanced features for managing lots of users and compliance. Flexible even as your
        tooling or workflow evolves.
      </p>

      {/* Cards, not bare text: 24px padding, 12px radius, white on a 1px
          border, in a 3-up grid with a 20px gutter. */}
      <div class="scale-grid">
        {scaleCards.map((c) => (
          <div class="scale-card">
            <ScaleIcon name={c.icon} />
            <h4 class="scale-card__title">{c.title}</h4>
            <p class="scale-card__body">
              {c.lead}
              {c.link && <a href={c.link[1]} class="scale-card__link">{c.link[0]}</a>}
              {c.tail}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Social wall -->
  {social.length > 0 && (
    <section class="love-revamp">
      <div class="container-mb">
        <div class="love-head">
          <h2 class="love-title">Analytics that people straight up love</h2>
        </div>

        <div class="love-masonry">
          {social.map((t) => (
            <figure class="love-card">
              <blockquote class="love-quote">{t.quote}</blockquote>
              <figcaption class="love-author">
                <Avatar image={t.person?.avatar} name={t.person?.name} size={36} class="love-avatar" />
                <span class="love-name">
                  {t.sourceUrl
                    ? <a class="love-name-link" href={t.sourceUrl} target="_blank" rel="noopener noreferrer">{t.person?.name}</a>
                    : t.person?.name}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>

        <p class="love-more">
          <a class="love-more-link" href="/love">See more love for Metabase <span aria-hidden="true">›</span></a>
        </p>
      </div>
    </section>
  )}

  <!-- Final CTA -->
  {/* The original has no bottom padding here and rules the top off with a
      hairline; the air below comes from the footer. */}
  <section class="final-cta-section">
    <div class="final-cta">
      <h2 class="final-cta-title">Ready to get started?</h2>
      <p class="final-cta-sub">
        We could keep typing, or you could just try it. AI on all plans. 100k+ teams already love it.
      </p>
      <div class="final-cta-actions">
        <a href="/start" class="btn-primary">Try Metabase Cloud free</a>
        <a href="/open-source" class="btn-secondary">Deploy Metabase Open Source</a>
      </div>
      <ul class="final-cta-points">
        <li>
          <span class="final-cta-point-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M4.75 12C4.75 7.99594 7.99594 4.75 12 4.75C16.0041 4.75 19.25 7.99594 19.25 12C19.25 16.0041 16.0041 19.25 12 19.25C7.99594 19.25 4.75 16.0041 4.75 12Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M9.75 12.75L10.1837 13.6744C10.5275 14.407 11.5536 14.4492 11.9564 13.7473L14.25 9.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          Free 14-day trial
        </li>
        <li>
          <span class="final-cta-point-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path stroke="currentColor" stroke-width="1.5" d="M12 19.25a7.25 7.25 0 1 0 0-14.5 7.25 7.25 0 0 0 0 14.5Z" />
              <path stroke="currentColor" stroke-width="1.5" d="M12 8v4l2 2" />
            </svg>
          </span>
          Super-fast setup
        </li>
        <li>
          <span class="final-cta-point-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
              <path d="M5.91993 10.1186C4.11523 9.8953 2.84374 8.56942 2.84374 6.85274C2.84374 6.15491 3.08984 5.40124 3.5 4.8988C3.32227 4.43823 3.34961 3.46127 3.55469 3.05652C4.10156 2.98674 4.83984 3.27982 5.27734 3.68457C5.79687 3.51709 6.34374 3.43335 7.01367 3.43335C7.6836 3.43335 8.23047 3.51709 8.72266 3.67061C9.14649 3.27982 9.89844 2.98674 10.4453 3.05652C10.6367 3.43335 10.6641 4.41032 10.4863 4.88485C10.9238 5.4152 11.1562 6.127 11.1562 6.85274C11.1562 8.56942 9.88477 9.86739 8.05273 10.1047C8.51757 10.4117 8.83203 11.0816 8.83203 11.8493V13.3007C8.83203 13.7194 9.17383 13.9567 9.58399 13.7892C12.0586 12.8262 14 10.3 14 7.17375C14 3.224 10.8555 0 6.98633 0C3.11719 0 0 3.224 0 7.17375C0 10.2721 1.92773 12.8402 4.52539 13.8032C4.89453 13.9427 5.25 13.6915 5.25 13.3147V12.1982C5.0586 12.2819 4.8125 12.3377 4.59374 12.3377C3.6914 12.3377 3.1582 11.8353 2.77539 10.9002C2.625 10.5234 2.46094 10.3 2.14649 10.2582C1.98243 10.2442 1.92773 10.1744 1.92773 10.0907C1.92773 9.92321 2.20117 9.79761 2.47461 9.79761C2.8711 9.79761 3.21289 10.0488 3.56836 10.5652C3.8418 10.97 4.1289 11.1514 4.4707 11.1514C4.8125 11.1514 5.03124 11.0258 5.3457 10.7048C5.57813 10.4675 5.75586 10.2582 5.91993 10.1186Z" />
            </svg>
          </span>
          Open source
        </li>
      </ul>

      <div class="final-cta-illustration-wrap" aria-hidden="true">
        <img class="final-cta-illustration" src="/images/home/footer-illustration.svg"
             alt="" width="1440" height="279" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>
</BaseLayout>
