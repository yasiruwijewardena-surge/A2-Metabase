---
/*
 * Self-service Business Intelligence.
 *
 * The copy, artwork and section order now live in Strapi as a `product-page`
 * dynamic zone; this file decides nothing but which page to fetch. The
 * measurements that drive the CSS are recorded against `.pp-*` in global.css,
 * where they belong -- they describe the shapes, not this page's content.
 *
 * Deliberate divergences from the original, unchanged by the move:
 *  - The original's section headings are h3 (36/40) above its h2s (30/35),
 *    which inverts the document outline. Sizes are kept; the tags are swapped
 *    so the heading order still reads correctly to a screen reader.
 *  - The feature list is an accordion on the original. It is rebuilt with
 *    radio inputs and `:has()`, so it behaves the same with no JavaScript.
 *  - Quotes are testimonials, placed by the zone rather than by this file.
 *    The original quotes three named real people; writing words for them is
 *    not something a replica should do.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sections from '../../components/page/Sections.astro';
import { preloadFor } from '../../lib/image';
import { getProductPage } from '../../lib/strapi';

const page = await getProductPage('business-intelligence');
if (!page) throw new Error('product-page "business-intelligence" is not in Strapi');

const hero = page.sections?.find((s) => s.__component === 'page.hero');
---
<BaseLayout
  title={page.seo?.metaTitle ?? `${page.title} | Metabase`}
  description={page.seo?.metaDescription ?? ''}
  preload={preloadFor(hero && 'media' in hero ? hero.media?.url : undefined)}
>
  <Sections sections={page.sections} />
</BaseLayout>
