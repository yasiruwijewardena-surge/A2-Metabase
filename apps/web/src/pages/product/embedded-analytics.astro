---
/*
 * Embedded Analytics.
 *
 * The largest page in the replica: the original runs 11,917px over sixteen
 * sections. Structure and every size below come off an element dump at 1512
 * (`npm run metrics -- <url> --root .embedding-page.embedded-analytics`).
 *
 * Section order, with the numbers that drive the CSS:
 *   1  hero band #fafbfe, eyebrow + h1 580x112 48/56, img 998x595
 *   2  band h2 640x96 36/48 + standfirst 400x64 20/32
 *   3  split  video 630 in a 632 frame / h3 30/35 + lede + quote card 560
 *   4  split  img 770x428 overflowing a 632x514 frame / 488 copy
 *   5  split  img 570x463 in a 632x649 frame / 560 copy
 *   6  band + three 389x207 pillar cards
 *   7  #fafbfe r24 panel: customer story, 559x405 clip in a #eef6fc r8 frame
 *   8  two 616x813 implementation cards, h6 badge + h4 24/32 + h5 20/28
 *   9  tabbed panel, three 224x52 tabs over a 632 frame + 536 copy
 *  10  band + three 389x231 pillar cards
 *  11  #fafbfe r24 panel: the theming demo, 822x350 canvas + 182 controls
 *  12  split  img 590x511 in a 632x623 frame / 560 copy + rich list
 *  13  #fafbfe r24 panel: support team, copy beside a marquee of 567 cards
 *  14  "Why not just build it?" — an 800x439 #fafbfe r12 comparison card
 *  15  FAQ, 602-wide details/summary at 16/26
 *  16  closing CTA, 892x467 screenshot in a 894x469 white r24 frame
 *
 * Divergences, each for a reason:
 *  - Heading tags follow the document outline rather than the original's
 *    (which sets h3 36/48 above h2 30/35); the sizes are the original's.
 *  - The tab strip, the theme presets and the FAQ all run on radio inputs
 *    and `:has()`, so the page ships no JavaScript.
 *  - The theming demo's canvas is a screenshot, not the original's live
 *    iframe: a third-party frame here would cost both the performance
 *    budget and the visitor's privacy. The controls are real and do retint
 *    the panel.
 *  - The 6MB sincera.gif is served as a 130KB muted video, and fastsetup.mp4
 *    came 2160x2160 for a 630px slot and was re-encoded to 1296 at 417KB.
 *  - Quotes come from Strapi. The original names real customers and real
 *    support engineers throughout; writing lines for them is not something
 *    a replica should do.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavIcon from '../../components/NavIcon.astro';
import ProductCtaRow from '../../components/ProductCtaRow.astro';
import ProductQuoteCard from '../../components/ProductQuoteCard.astro';
import SupportQuote from '../../components/SupportQuote.astro';
import { getTestimonials } from '../../lib/strapi';

const all = await getTestimonials();
const byOrder = (a: any, b: any) => a.displayOrder - b.displayOrder;
/* Business Intelligence takes the first three pull-quotes; this page takes
 * the next five so the two product pages do not show the same customers. */
const pulls = all.filter((t) => t.variant === 'pull-quote').sort(byOrder).slice(3);
const support = all.filter((t) => t.variant === 'social').sort(byOrder);

const logos = [
  ['Huggingface', 'huggingface logo', 135], ['mcdonalds', 'mcdonalds logo', 67],
  ['huma', 'huma logo', 128], ['capital-one', 'capital-one logo', 129],
  ['mistral', 'Mistral AI logo', 135], ['linear', 'linear logo', 116],
  ['deutsche-telekom', 'Deutsche Telekom logo', 58], ['kong', 'kong logo', 129],
];

const securityPillars = [
  ['permissions', 'Keep data secure',
   'Make sure each customer only ever sees their own rows. Define who can see what once, and have it hold everywhere.'],
  ['segregation', 'Flexible access controls',
   'Set permissions at the organisation, user, table, even the row or column level, and sandbox what is left.'],
  ['gear', 'Permissions in the UI',
   'No engineer grows up dreaming of managing permissions. Hand them to the people who own the question instead.'],
];

const stackPillars = [
  ['data', 'Integrates with your database and stack',
   'Metabase connects to 20+ data sources, with embedding that fits whatever framework the product already runs on.'],
  ['bi', 'Open source, proven reliability',
   'No black boxes and no vendor lock-in, backed by a large community and a decade of production use.'],
  ['cloud', 'Self-host or cloud',
   'Keep control of your data and your deployment, or hand the hosting to us and stop thinking about it.'],
];

const implementations = [
  {
    badge: 'Low-code', icon: 'embed',
    title: 'Embed charts and interactive dashboards fast with little engineering lift',
    sub: 'Outrun competitors and boost revenue with reporting as a product feature.',
    img: ['/images/product/embedded-analytics/embed-with-iframes-or-sdk.webp', 602, 377, 'A dashboard embedded in a customer-facing application'],
    link: { href: '/docs/embedding', label: 'Learn more about low-code embedding' },
    points: [
      ['Set up in minutes', ' — validate your in-app reporting needs before you commit a sprint to them.'],
      ['White label with your branding', ', customise navigation and the surrounding experience with a low-code integration.', { href: '/docs/white-label', label: 'White label with your branding' }],
      ['Customize theming and interactivity', ' per component, per organisation or per user.'],
      ['Limit exploration', ' with guest embedding, or give carte blanche reporting access with full app embedding.'],
    ],
  },
  {
    badge: 'Modular Embedding SDK for React', icon: 'sdk',
    title: 'More control, more customization',
    sub: 'Customers want data. Check it off your list.',
    img: ['/images/product/embedded-analytics/more-control-more-customization.webp', 554, 354, 'React components composing an embedded analytics view'],
    link: { href: '/product/embedded-analytics-sdk', label: 'Learn more about Modular Embedding SDK' },
    points: [
      ['Build custom analytics experiences', ' with a powerful alternative to hand-rolling your in-app reporting, and keep the parts you have already built.'],
      ['Compose from React components', ' and drop them wherever the product already has a place for them.'],
      ['Manage the UX', ' with custom behaviours, menu items, flows and formats.'],
      ['Ship with your own design system', ' so the embedded views stop looking embedded.'],
    ],
  },
];

const tabs = [
  {
    id: 'metabot', label: 'Metabot AI', icon: 'ai',
    title: 'Embed the AI data assistant',
    body: 'Make it easier for your customers to get answers from data by putting a chat interface where the question actually comes up.',
    link: { href: '/product/metabot-ai', label: 'Metabot chat interface' },
    img: ['/images/product/embedded-analytics/how-are-our-apps-doing.webp', 651, 443, 'An embedded assistant answering a question about app performance'],
  },
  {
    id: 'explore', label: 'Click to explore', icon: 'drill',
    title: 'Let customers drill in for themselves',
    body: 'Drill-through menus turn a chart into a starting point, so the follow-up question does not come back to you as a support ticket.',
    link: { href: '/product/query-builder', label: 'the visual query builder' },
    img: ['/images/product/embedded-analytics/embed-with-iframes-or-sdk.webp', 602, 377, 'A customer drilling into an embedded chart'],
  },
  {
    id: 'simple', label: 'Simple reporting', icon: 'dashboards',
    title: 'Or keep it to the numbers that matter',
    body: 'Not every customer wants a query tool. Ship a fixed, fast dashboard and let the ones who want more ask for it.',
    link: { href: '/docs/embedding', label: 'static embedding' },
    img: ['/images/product/embedded-analytics/more-control-more-customization.webp', 554, 354, 'A compact embedded reporting view'],
  },
];

const usagePoints = [
  ['See how often people use your customer-facing analytics.', 'Validate the investment you have made in your in-app reporting.'],
  ['Understand what your customers are most interested in.', 'Give people more of what they want, and archive the unused.'],
  ['Get a comprehensive activity log for auditing and security purposes.', 'You can even set alerts to be notified about unusual activity.'],
];

const supportPoints = [
  'Support from actual technical experts. We are all avid Metabase users ourselves.',
  'Help with whatever the problem is, be it admin troubleshooting or a modelling question.',
  'No chat bots, no hold lines, no customer service runaround.',
];

const buildVsBuy = [
  ['DIY and Charting libraries:', [
    ['Seems simple at first but ', 'quickly balloons in scope', '. Think permissions, new visualization types, drill-through, scheduling.'],
    ['', 'Requires ongoing dev time', ' for maintenance, bug fixes, security and scaling.'],
    ['', 'No built-in permissions', ', multi-tenancy, self-service analytics or exports.'],
  ]],
  ['Other Embedded Analytics solutions:', [
    ['', 'Priced per end user', ', which turns your own growth into a bill you cannot forecast.'],
    ['', 'Long implementations', ' before anything reaches a customer, and a modelling layer you have to adopt wholesale.'],
    ['', 'Rigid', ' — your product has to look like their product.'],
  ]],
  ['Metabase:', [
    ['', 'Live on your database', ', so there is nothing to sync and nothing to go stale.'],
    ['', 'Low-code to start, an SDK when you need it', ', without starting over in between.'],
    ['', 'Open source', ', so the thing underneath your product is not a black box.'],
  ]],
];

const faqs = [
  ['How does Metabase perform when embedded in our app?',
   'Metabase is optimised for speed and runs live on your data, so there is no ingest step and no copy to keep in sync. Queries go to your database with caching in front of the ones that are asked most.'],
  ['How customizable is it?',
   'White label the embedded charts and dashboards, set theming per component, per organisation or per user, and with the SDK compose the views out of React components using your own design system.'],
  ['Is it secure enough to ensure my customers never see another customer’s data?',
   'Row and column permissions are applied before the query runs, not filtered out afterwards, and sandboxing scopes every embedded session to one tenant. Metabase is up to date with first-class compliance certifications.'],
  ['Can we start simple and transition to the SDK later?',
   'Yes, and that is the common path. Start with low-code embedding to validate what customers actually want, then move to the SDK for a more integrated, branded experience without throwing the first version away.'],
];
---

<BaseLayout
  title="Embedded Analytics | Metabase"
  description="Get in-product reporting in days, not sprints. Embed charts and interactive dashboards with a low-code integration, or compose them from React components with the Modular Embedding SDK."
>
  <div class="ea-page">
  <div class="pp-hero-band">
    <div class="container-mb pp-center">
      <p class="pp-eyebrow">
        <svg class="pp-eyebrow-icon" width="62" height="70" viewBox="0 0 62 70" fill="none" aria-hidden="true">
          <rect x="1" y="12" width="60" height="44" rx="6" fill="#509EE3" opacity=".25" />
          <rect x="9" y="22" width="44" height="6" rx="3" fill="#509EE3" />
          <rect x="9" y="34" width="28" height="6" rx="3" fill="#509EE3" opacity=".7" />
          <circle cx="46" cy="47" r="8" fill="#509EE3" />
        </svg>
        <b>Embedded Analytics</b>
      </p>
      <h1 class="pp-hero-title">Get in-product reporting in days, not sprints</h1>
      <p class="pp-hero-sub">
        Hand-rolling analytics is never what you think it is going to be. Ship the reporting
        your customers are asking for, and keep your roadmap for your own product.
      </p>
      <ProductCtaRow primary={{ href: '/start', label: 'Get started' }}
                     secondary={{ href: '/contact', label: 'Contact us' }} />
      {/* A narrow crop for phones, which is what keeps mobile LCP down: the
          source art is 3018px wide for a 998px slot. */}
      <picture class="pp-hero-pic">
        <source media="(max-width: 991px)" srcset="/images/product/embedded-analytics/hero_image-mobile.webp"
                width="764" height="456" />
        <img class="pp-hero-img pp-hero-img--bare" src="/images/product/embedded-analytics/hero_image.webp"
             alt="Metabase dashboards embedded inside a customer-facing product"
             width="998" height="595" loading="eager" fetchpriority="high" decoding="sync" />
      </picture>
      <p class="pp-trust">Metabase is trusted by 100,000+ companies</p>
      <ul class="pp-logos">
        {logos.map(([file, alt, w]) => (
          <li><img src={`/images/logos/${file}.svg`} alt={alt} width={w} height="38"
                   style={`width:${w}px`} loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    </div>
  </div>

  <section class="pp-band container-mb pp-center">
    <h2 class="pp-h36 pp-h36--tall">Super fast to prototype, fast to implement, fast to iterate</h2>
    <p class="pp-band-sub pp-band-sub--narrow">
Sign up, connect to your data, and get your first visualization embedded.
    </p>
  </section>

  <section class="pp-split container-mb">
    <div class="pp-split-media">
      <div class="pp-frame pp-frame--grey">
        <video width="630" height="630" poster="/images/product/embedded-analytics/fastsetup-poster.webp"
               autoplay loop muted playsinline preload="none"
               aria-label="Setting up an embedded dashboard from scratch">
          <source src="/images/product/embedded-analytics/fastsetup.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
    <div class="pp-split-copy">
      <h3 class="pp-h30">Get to proof of concept really fast</h3>
      <p class="pp-lede">
        Let your customers get at reports without having to ask, whether that is one chart
        in a sidebar or a whole analytics area.
      </p>
      <ProductQuoteCard quote={pulls[0]} />
    </div>
  </section>

  <section class="pp-split pp-split--reverse container-mb">
    <div class="pp-split-media">
      <div class="pp-frame pp-frame--grey pp-frame--bleed">
        <img src="/images/product/embedded-analytics/flexible-solutions.webp"
             alt="Low-code embedding beside an SDK integration" width="770" height="428"
             loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="pp-split-copy pp-split-copy--narrow">
      <h3 class="pp-h30">Flexible solutions for every stage</h3>
      <p class="pp-lede">
        Choose a low-code implementation for speed, or the
        <a href="/product/embedded-analytics-sdk">Modular Embedding SDK</a> for more control
        over how the views look and behave inside your product.
      </p>
      <ProductQuoteCard quote={pulls[1]} width={488} />
    </div>
  </section>

  <section class="pp-split container-mb">
    <div class="pp-split-media">
      <div class="pp-frame pp-frame--grey">
        <img src="/images/product/embedded-analytics/need-a-change.webp"
             alt="Editing an embedded dashboard without touching application code"
             width="570" height="463" loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="pp-split-copy">
      <h3 class="pp-h30">No-code iteration</h3>
      <p class="pp-lede">
        Query and visualize data, and even define custom click behaviour, without going back
        to the application code every time a customer asks for something.
      </p>
      <ProductQuoteCard quote={pulls[2]} />
    </div>
  </section>

  <section class="pp-band container-mb pp-center">
    <h2 class="pp-h36 pp-h36--tall">Multi-tenant and secure to keep customer data separate</h2>
    <p class="pp-band-sub pp-band-sub--tight">
      Segregate data with <a href="/product/permissions">granular permissions</a> and strong perimeters.
    </p>
    <ul class="pp-pillars">
      {securityPillars.map(([icon, title, body]) => (
        <li class="pp-pillar">
          <NavIcon name={icon} size={24} class="pp-pillar-icon" />
          <h3 class="pp-pillar-title">{title}</h3>
          <p class="pp-pillar-body">{body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-mb">
    <div class="ea-panel">
      <div class="pp-center">
        <h2 class="pp-h36">Our customers build great data experiences</h2>
        <p class="pp-band-sub">See how leading companies help their users work with data.</p>
      </div>
      <div class="ea-story">
        <div class="ea-story-media">
          <video width="559" height="405" poster="/images/embedding/sincera-poster.webp"
                 autoplay loop muted playsinline preload="none"
                 aria-label="An embedded analytics area inside a customer's product">
            <source src="/images/embedding/sincera.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="ea-story-copy">
          <h3 class="ea-story-title">
            Northwind Lending uses Metabase embedding to give their customers a reporting
            area they do not have to maintain
          </h3>
          <ProductQuoteCard quote={pulls[3]} width={463} />
          <a href="/case-studies" class="pp-band-link">
            Read the full story
            <svg width="9" height="16" viewBox="0 0 9 16" fill="none" stroke="currentColor"
                 stroke-width="2" aria-hidden="true"><path d="M1.5 1.5L7 8l-5.5 6.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="pp-band container-mb">
    <div class="pp-center">
      <h2 class="ea-impl-title">The right implementation type for whatever you need</h2>
      <p class="pp-band-sub">
        Embed production-ready analytics components in your product, from a single chart to a
        whole self-service area, and change your mind later without starting over.
      </p>
      <a href="/start" class="pp-band-link ea-demo-link">Check out the live demo</a>
    </div>
    <div class="ea-impls">
      {implementations.map((im) => (
        <article class="ea-impl">
          <p class="ea-impl-badge"><NavIcon name={im.icon} size={24} class="ea-impl-badge-icon" />{im.badge}</p>
          <h3 class="ea-impl-h">{im.title}</h3>
          <p class="ea-impl-sub">{im.sub}</p>
          <ul class="ea-impl-points">
            {im.points.map(([lead, rest, link]) => (
              <li>{link ? <a href={link.href}>{lead}</a> : <b>{lead}</b>}{rest}</li>
            ))}
          </ul>
          <a href={im.link.href} class="pp-band-link">{im.link.label}</a>
          <img class="ea-impl-img" src={im.img[0]} alt={im.img[3]}
               width={im.img[1]} height={im.img[2]} loading="lazy" decoding="async" />
        </article>
      ))}
    </div>
  </section>

  <section class="pp-band container-mb">
    <div class="pp-center">
      <h2 class="pp-h36">Easy to use for all types of customers</h2>
      <p class="pp-band-sub">
        Self-service analytics that lets everyone work with data, from the people who
        want one number to the ones who write SQL.
      </p>
    </div>
    <div class="ea-tabs">
      {tabs.map((t, i) => (
        <input class="ea-tab-radio" type="radio" name="ea-tab" id={`tab-${t.id}`} checked={i === 0} />
      ))}
      <div class="ea-tabstrip">
        {tabs.map((t) => (
          <label class="ea-tab" for={`tab-${t.id}`} data-tab={t.id}>
            <NavIcon name={t.icon} size={24} class="ea-tab-icon" />{t.label}
          </label>
        ))}
      </div>
      {tabs.map((t) => (
        <div class="ea-panelrow" data-tab={t.id}>
          <div class="pp-frame pp-frame--grey ea-tab-media">
            <img src={t.img[0]} alt={t.img[3]} width={t.img[1]} height={t.img[2]}
                 loading="lazy" decoding="async" />
          </div>
          <div class="ea-tab-copy">
            <h3 class="pp-h30">{t.title}</h3>
            <p class="ea-tab-body">{t.body} <a href={t.link.href}>{t.link.label}</a></p>
            <ProductQuoteCard quote={pulls[4]} width={536} />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="pp-band container-mb pp-center">
    <h2 class="pp-h36 pp-h36--tall">Works with your stack for live visualizations and reports, not extracts</h2>
    <p class="pp-band-sub pp-band-sub--wide">
      Your data stays in your database. Metabase does not ingest it, so there is no pipeline
      to run and nothing to go stale between refreshes.
    </p>
    <ul class="pp-pillars pp-pillars--tall">
      {stackPillars.map(([icon, title, body]) => (
        <li class="pp-pillar">
          <NavIcon name={icon} size={24} class="pp-pillar-icon" />
          <h3 class="pp-pillar-title">{title}</h3>
          <p class="pp-pillar-body">{body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-mb">
    <div class="ea-panel">
      <div class="pp-center">
        <h2 class="pp-h36">The perfect balance of plug &ndash; and &ndash; play and customizability</h2>
        <p class="pp-band-sub">
          You sweat every detail of your product, so we will make sure the analytics inside it
          look like they belong there.
          <a href="/docs/white-label">Customize labels, colors, fonts, branding</a>
        </p>
      </div>
      {/* The presets are real radios; each one retints the canvas and updates
          the readouts below, so the demo works with no JavaScript. */}
      <div class="ea-theme">
        {['classic', 'tech', 'elegant', 'playful'].map((t, i) => (
          <input class="ea-theme-radio" type="radio" name="ea-theme" id={`th-${t}`} checked={i === 0} />
        ))}
        <div class="ea-theme-stage">
          <div class="ea-theme-canvas">
            <img src="/images/product/embedded-analytics/application-screenshot.webp"
                 alt="An embedded dashboard restyled to match the host application"
                 width="892" height="467" loading="lazy" decoding="async" />
          </div>
          <div class="ea-theme-controls">
            <h3 class="ea-theme-label">Chart colors</h3>
            <p class="ea-theme-val"><span class="ea-sw ea-sw-1"></span><span class="ea-hex ea-hex-1"></span></p>
            <p class="ea-theme-val"><span class="ea-sw ea-sw-2"></span><span class="ea-hex ea-hex-2"></span></p>
            <p class="ea-theme-val"><span class="ea-sw ea-sw-3"></span><span class="ea-hex ea-hex-3"></span></p>
            <h3 class="ea-theme-label">Font</h3>
            <p class="ea-theme-val"><span class="ea-font"></span></p>
            <h3 class="ea-theme-label">Appearance</h3>
            <p class="ea-theme-val"><span class="ea-mode"></span></p>
          </div>
        </div>
        <div class="ea-theme-presets">
          {['Classic', 'Tech', 'Elegant', 'Playful'].map((t) => (
            <label class="ea-preset" for={`th-${t.toLowerCase()}`} data-theme={t.toLowerCase()}>
              <span class="ea-preset-dot"></span><b>{t}</b>
            </label>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="pp-split container-mb">
    <div class="pp-split-media">
      <div class="pp-frame pp-frame--grey">
        <img src="/images/product/embedded-analytics/track-in-app-reporting.webp"
             alt="Usage analytics showing which embedded reports are opened most"
             width="590" height="511" loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="pp-split-copy">
      <h3 class="pp-h30">Track how your in-app reporting is used</h3>
      <p class="pp-lede">
        <a href="/product/usage-analytics">Usage analytics</a> tells you who is doing what and
        when, so you can act on it rather than guess.
      </p>
      <ul class="pp-rich">
        {usagePoints.map(([lead, rest]) => <li><b>{lead}</b><br />{rest}</li>)}
      </ul>
      <a href="/product/usage-analytics" class="pp-band-link">
        Learn more<span class="sr-only"> about usage analytics</span>
        <svg width="9" height="16" viewBox="0 0 9 16" fill="none" stroke="currentColor"
             stroke-width="2" aria-hidden="true"><path d="M1.5 1.5L7 8l-5.5 6.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </section>

  <section class="container-mb">
    <div class="ea-panel ea-support">
      <div class="ea-support-copy">
        <h2 class="pp-h30">Help from our world-class success team</h2>
        <p class="pp-lede">We don't like to brag, so we'll let our customers do it for us.</p>
        <p class="ea-support-lead">
          <b>With Embedding on Pro and Enterprise plans, you'll get access to our success team:</b>
        </p>
        <ul class="ea-support-points">
          {supportPoints.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      {/* Duplicated once so the vertical scroll loops seamlessly; the copy is
          hidden from assistive tech. The animation stops for
          prefers-reduced-motion, which leaves a plain scrollable column. */}
      <div class="ea-marquee">
        <div class="ea-marquee-track">
          {support.map((q) => <SupportQuote quote={q} />)}
        </div>
        <div class="ea-marquee-track" aria-hidden="true">
          {support.map((q) => <SupportQuote quote={q} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="pp-band container-mb pp-center">
    <h2 class="pp-h36">Why not just build it?</h2>
    <div class="ea-vs">
      {buildVsBuy.map(([heading, rows]) => (
        <div class="ea-vs-group">
          <h3 class="ea-vs-h">{heading}</h3>
          <ul class="ea-vs-list">
            {rows.map(([pre, strong, post]) => <li>{pre}<b>{strong}</b>{post}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="pp-band container-mb pp-center">
    <h2 class="pp-h36">Frequently asked questions</h2>
    <div class="ea-faq">
      {faqs.map(([q, a]) => (
        <details class="ea-faq-item">
          <summary>{q}<svg width="14" height="19" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 5.5L7 9.5l4-4" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="pp-final">
    <div class="container-mb pp-center">
      <h2 class="pp-h36 pp-final-title">Ready to get started?</h2>
      <p class="pp-band-sub pp-band-sub--600">
        Get up and running with a 14-day free trial in 5 minutes. Or talk to us about what
        you are trying to put in front of your customers.
      </p>
      <ProductCtaRow primary={{ href: '/start', label: 'Get started' }}
                     secondary={{ href: '/contact', label: 'Contact us' }} small />
      <div class="ea-final-media">
        <div class="ea-final-frame">
          <img src="/images/product/embedded-analytics/application-screenshot.webp"
               alt="The Metabase application embedded in a product"
               width="892" height="467" loading="lazy" decoding="async" />
        </div>
        <img class="ea-final-snippet" src="/images/product/embedded-analytics/sdk-code-snippet.webp"
             alt="A React component embedding a Metabase dashboard"
             width="460" height="343" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
