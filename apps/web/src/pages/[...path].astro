---
/*
 * Every URL that is not a collection detail route.
 *
 * Two kinds of path arrive here, and one route has to serve both because Astro
 * allows a single rest parameter at a level:
 *
 *   - a composed page, held as a row in Strapi. Its shape is the dynamic zone,
 *     so what sections it has and in what order is content, not code.
 *   - a path the replicated navigation points at with nothing behind it. The
 *     information architecture is part of what is being replicated, so the nav
 *     and footer carry the original's full link set. Serving a 404 would
 *     misrepresent the build as broken; inventing a page would misrepresent it
 *     as complete. This says plainly which it is.
 *
 * A page row wins over a stub of the same path, so building a page simply
 * removes its stub.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Sections from '../components/page/Sections.astro';
import { getPages, pagePreload } from '../lib/strapi';
import paths from '../data/ia-paths.json';
import type { Page } from '../lib/types';

export async function getStaticPaths() {
  /* Declared in here, not in the frontmatter: Astro hoists getStaticPaths into
     a scope of its own, so anything it names has to be inside it or imported.

     The row whose slug is "home" is the site root -- a rest parameter produces
     "/" when it is undefined, which is how one route covers both. */
  const pathOf = (slug: string) => {
    const clean = slug.replace(/^\/+/, '');
    return clean === 'home' ? undefined : clean;
  };

  const pages = await getPages();
  const taken = new Set(pages.map((p) => `/${pathOf(p.slug) ?? ''}`));

  return [
    ...pages.map((page) => ({
      params: { path: pathOf(page.slug) },
      props: { page },
    })),
    ...(paths as string[])
      .filter((p) => !taken.has(p))
      .map((p) => ({ params: { path: p.replace(/^\/+/, '') }, props: { page: null } })),
  ];
}

interface Props { page: Page | null }
const { page } = Astro.props;

const preload = await pagePreload(page);

const here = `/${Astro.params.path ?? ''}`;

/** The sections of the replica that are built, for somewhere to go next. */
const built: [string, string, string][] = [
  ['Home', '/', 'Matched against the original section by section'],
  ['Blog', '/blog', 'Posts and working category filters, drawn from Strapi'],
  ['Case studies', '/case-studies', 'Filterable by use case and by industry'],
  ['Customer love', '/love', 'The testimonial wall'],
  ['Glossary', '/glossary', 'Analytics terms'],
];

/** Reads "/features/sql-editor" as "Features — Sql editor". */
const label = here
  .split('/')
  .filter(Boolean)
  .map((seg) => seg.replace(/-/g, ' ').replace(/^./, (ch) => ch.toUpperCase()))
  .join(' — ');
---

{page ? (
  <BaseLayout title={page.seo?.title ?? page.title} description={page.seo?.description} preload={preload}>
    <Sections sections={page.sections} />
  </BaseLayout>
) : (
<BaseLayout
  title={`${label} | Metabase replica`}
  description={`${here} is part of the replicated navigation but is not one of the pages built for this assignment.`}
  noIndex
>
  {/* The auditor keys on this attribute: a stub is not a real page, and
      without the marker the link audit sees these in dist/ and concludes
      every link resolves. */}
  <div class="container-mb stub" data-replica-stub>
    <p class="stub-eyebrow">Not part of this build</p>
    <h1 class="stub-title">{label}</h1>
    <p class="stub-body">
      <code>{here}</code> is in the navigation because the original's information
      architecture is part of what this project replicates. The page behind it is
      not. This assignment builds the homepage, the blog, the case studies, the
      testimonial wall and the glossary, and models their content in Strapi.
    </p>
    <p class="stub-body">
      Nothing here stands in for the real page — inventing one would claim more
      than was built.
    </p>

    <h2 class="stub-sub">What is built</h2>
    <ul class="stub-list">
      {built.map(([name, href, note]) => (
        <li>
          <a href={href}>{name}</a>
          <span>{note}</span>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
)}
