---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudyListing from '../../../components/CaseStudyListing.astro';
import { getCaseStudies, getIndustries, getUseCases } from '../../../lib/strapi';
import { preloadFor } from '../../../lib/image';

export async function getStaticPaths() {
  const [cases, industries, useCases] = await Promise.all([
    getCaseStudies(), getIndustries(), getUseCases(),
  ]);
  return useCases.map((useCase) => ({
    params: { useCase: useCase.slug },
    props: { useCase, industries, useCases, cases },
  }));
}

const { useCase, industries, useCases, cases } = Astro.props;
---
<BaseLayout
  title={`${useCase.name} customer stories | Metabase`}
  description={useCase.description ?? `Teams using Metabase for ${useCase.name}.`}
  seo={useCase.seo}
  preload={preloadFor(cases[0]?.heroImage?.url, [300, 480, 760], '(max-width: 768px) 100vw, 360px')}
>
  <CaseStudyListing cases={cases} industries={industries} useCases={useCases} activeUseCase={useCase.slug} />
</BaseLayout>
