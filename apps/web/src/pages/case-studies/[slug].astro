---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CldImage from '../../components/CldImage.astro';
import RichText from '../../components/RichText.astro';
import { getCaseStudies, getCaseStudy } from '../../lib/strapi';
import { preloadFor } from '../../lib/image';

export async function getStaticPaths() {
  const cases = await getCaseStudies();
  return cases.map((c) => ({ params: { slug: c.slug } }));
}

const cs = await getCaseStudy(Astro.params.slug!);
if (!cs) return Astro.redirect('/404');

const facts = [
  ['Industry', cs.company?.industry?.name],
  ['Employees', cs.company?.employees],
  ['Headquarters', cs.company?.headquarters],
  ['Key use cases', cs.useCases.map((u) => u.name).join(', ')],
].filter(([, v]) => Boolean(v)) as [string, string][];
---
<BaseLayout
  title={`${cs.company?.name ?? cs.title} | Metabase customer story`}
  description={cs.headline}
  seo={cs.seo}
  ogImage={cs.heroImage?.url}
  preload={preloadFor(cs.heroImage?.url, [600, 1140, 1600], '(max-width: 1200px) 100vw, 1140px')}
>
  {/*
    Measured off the original: a 12-column grid at a 24px gutter inside the
    1320 container. The back link takes 3 columns beside an 8-column title,
    then a 3-column fact panel sits beside the 8-column article, whose hero
    runs 3:1.
  */}
  <main class="container-mb cs-main">
    <div class="cs-grid">
      <div class="cs-back-col">
        <a href="/case-studies" class="cs-back">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M8.5 3.5L5 7l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Back to all Case Studies
        </a>
      </div>

      <h1 class="cs-title">{cs.title}</h1>

      <aside class="cs-facts">
        {cs.company?.logo && (
          <CldImage
            image={cs.company.logo}
            widths={[142, 284]}
            sizes="142px"
            alt={cs.company.name}
            class="cs-facts-logo"
          />
        )}
        <dl class="m-0">
          {cs.company?.description && (
            <>
              <dt>Company</dt>
              <dd>{cs.company.description}</dd>
            </>
          )}
          {facts.map(([label, value]) => (
            <>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </>
          ))}
          {cs.metrics?.length > 0 && (
            <>
              <dt>Results</dt>
              {cs.metrics.map((m) => (
                <dd><b class="cs-metric">{m.value}</b> {m.label}</dd>
              ))}
            </>
          )}
        </dl>
      </aside>

      <article class="cs-article">
        <div class="cs-hero">
          <CldImage
            image={cs.heroImage}
            priority
            widths={[600, 1140, 1600]}
            sizes="(max-width: 991px) 100vw, 835px"
            ratio={3}
            class="cs-hero-img"
          />
        </div>

        <div class="prose-cs">
          {cs.challenge && (
            <p><strong>The Challenge:</strong> {cs.challenge}</p>
          )}
          {cs.solution && (
            <p><strong>The Solution:</strong> {cs.solution}</p>
          )}
          {cs.results && (
            <p><strong>The Results:</strong> {cs.results}</p>
          )}
        </div>

        <RichText blocks={cs.body} variant="sans" />
      </article>
    </div>
  </main>

  {cs.relatedCaseStudies && cs.relatedCaseStudies.length > 0 && (
    <section class="border-t border-(--color-line) bg-(--color-brand-faint) py-14">
      <div class="container-mb">
        <h2 class="mb-8 text-2xl">Explore more customer stories</h2>
        <div class="grid gap-6 md:grid-cols-3">
          {cs.relatedCaseStudies.slice(0, 3).map((r) => (
            <article class="rounded-xl border border-(--color-line) bg-white p-5">
              {r.company?.name && <p class="mb-1 text-xs font-bold uppercase tracking-wide text-(--color-ink-3)">{r.company.name}</p>}
              <h3 class="mb-3 text-base leading-snug">
                <a href={`/case-studies/${r.slug}`} class="hover:text-(--color-brand-hover)">{r.title}</a>
              </h3>
              <a href={`/case-studies/${r.slug}`} class="text-sm font-bold text-(--color-brand-hover)">Read the case study →</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
