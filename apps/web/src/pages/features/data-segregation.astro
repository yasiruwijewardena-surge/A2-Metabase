---
/*
 * /features/data-segregation
 *
 * Measured off the original at 1512 with `npm run metrics --root
 * div.data-segregation`:
 *   hero band  #fafbfe with a 1px bottom border, 1059 tall
 *     eyebrow  h2 18/26/700 muted, margin 64 top / 8 bottom
 *     h1       592 36/40/900 centred, mb 16
 *     lede     592 18/26 centred
 *     switcher 946x42, r8, 1px, padding 4, mt 24; four 32-tall tabs at
 *              16px/700 padded 4/16, r4, the open one on #eef6fc
 *     diagram  1264x562 per tab, then an 800-wide 18/26 line and a
 *              16/24/700 link, the link margined 12 top / 96 bottom
 *   compare    h3 1264 36/40/900 mb 8, then a 1264 grid, r12, 1px, mt 64:
 *              a label row then four rows of 330 + 4x233 cells, each cell
 *              bordered top and right and padded 16/24
 *   final CTA  #fafbfe, mt 80, padding 80/76, h3 36/48 mb 24, 600-wide
 *              18/32 mb 16, then a 14/21 button padded 16/24
 *
 * The original's tabs are href="#" and swap the panel with JavaScript.
 * Here they are radio inputs read with `:has()`, so the switcher works
 * before anything hydrates.
 *
 * Method names, their subtitles and the comparison column labels are the
 * original's, since they are what the page is for. The prose in the cells
 * is written here.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const tabs = [
  {
    id: 'rls', label: 'Row and column-level security',
    img: 'row-and-column-level-security',
    lede: 'Define rules in Metabase that limit which rows and columns each group can see, based on attributes you set.',
    link: 'Learn more about row-level security',
  },
  {
    id: 'impersonation', label: 'Connection impersonation',
    img: 'connection-impersonation',
    lede: 'Database-managed row-level permissions: Metabase impersonates database roles to enforce what is visible, and still allows SQL editor access.',
    link: 'Learn more about connection impersonation',
  },
  {
    id: 'routing', label: 'Database routing',
    img: 'database-routing',
    lede: 'In one-database-per-tenant setups, Metabase routes each customer’s queries to their own database while shared content stays in a primary one.',
    link: 'Learn more about database routing',
  },
  {
    id: 'locked', label: 'Locked parameters',
    img: 'locked-parameters',
    lede: 'Lightweight restriction for basic embedding, with locked parameters passed from your own app that the viewer cannot change.',
    link: 'Learn more about locked parameters',
  },
];

const columns = ['What does it mean', 'When to use it', 'Example use case', "Tradeoffs / when it's not a fit"];

const rows = [
  {
    name: 'Row-level security', sub: 'Set in the Metabase UI',
    mean: 'Define rules inside Metabase that restrict which rows and columns people can see, based on attributes like user ID, group or region. They apply to questions and dashboards, not to native SQL.',
    when: ['You need granular control over what each person can see and use',
           'You want control over access driven from the UI',
           'You need flexible control per group or organisation'],
    example: 'For internal BI: west coast fleet managers at a nationwide logistics firm see only the fleet and delivery data for their own region.',
    tradeoffs: ["Does not apply to native or SQL queries",
                'You are on a non-SQL database like Druid, though basic row-level security does work with MongoDB'],
  },
  {
    name: 'Connection impersonation', sub: 'DB-enforced RLS',
    mean: 'Metabase connects as the actual user or role in the database. You define the policies, roles and access controls there, and Metabase passes the identity through with SET ROLE.',
    when: ['You want the access logic centralised in the database',
           'Native queries have to respect access control too',
           'You are more worried about user attributes being misconfigured',
           'Your DBAs manage security centrally'],
    example: 'Set role-based permissions for users of your HR SaaS app, so a manager only ever sees data for their own direct reports.',
    tradeoffs: ['Not every database supports it',
                'Adds complexity in user management and setup',
                'Does not cache well in Metabase',
                'Less friendly for smaller teams, or anyone who is not a DBA'],
  },
  {
    name: 'Database routing', sub: 'For one-DB-per-tenant setups',
    mean: 'When tenant data lives in separate databases, routing makes sure each tenant only ever sees results from theirs. Admins build the questions and dashboards once against a primary database.',
    when: ['You want the strongest isolation there is, which suits compliance and noisy-neighbour problems in multi-tenant embedding',
           'You are more worried about user attributes being misconfigured',
           'You want to avoid one tenant’s queries slowing another’s'],
    example: "Acme's queries go to Acme's database when they open an embedded dashboard in your SaaS app, because the data is separated at the database level.",
    tradeoffs: ['Unnecessary if you do not need separation at the database level',
                'Higher operational complexity, if you would rather manage permissions in the Metabase UI'],
  },
  {
    name: 'Locked parameters', sub: null,
    mean: 'Embed dashboards whose results are already filtered before they are shown, say to org_id = 123. The filter is invisible and cannot be tampered with, and is controlled by attributes from your host app.',
    when: ['Lightweight tenant isolation for embedded analytics',
           'Simple access control that is still safe',
           'Keeping a sensitive filter away from the people reading the dashboard'],
    example: 'On an embedded dashboard in your ecommerce app, show each seller their own sales using a hidden seller ID passed in by the host app.',
    tradeoffs: ['No user login, SSO or awareness of roles',
                'Not something to rely on for high-risk data'],
  },
];
---

<BaseLayout
  title="Data segregation | Metabase"
  description="Set strong boundaries around your multi-tenant data: row and column-level security, connection impersonation, database routing and locked parameters, compared."
>
  <div class="ds">
    <div class="ds-hero">
      <div class="container-mb ds-hero-inner">
        <h2 class="ds-eyebrow">Data segregation</h2>
        <h1 class="ds-h1">Set strong boundaries around your multi-tenant data</h1>
        <p class="ds-lede">
          Methods to fit your configuration preferences and your security requirements.
        </p>

        <div class="ds-switch">
          {tabs.map((t, i) => (
            <input class="ds-radio" type="radio" name="ds-tab" id={`ds-${t.id}`} checked={i === 0} />
          ))}
          <div class="ds-tabs" aria-label="Segregation method">
            {tabs.map((t) => (
              <label class="ds-tab" for={`ds-${t.id}`} data-tab={t.id}>{t.label}</label>
            ))}
          </div>
          {tabs.map((t) => (
            <div class="ds-panel" data-tab={t.id}>
              <picture>
                <source media="(max-width: 767px)" srcset={`/images/data-segregation/${t.img}-mobile.webp`} />
                <img src={`/images/data-segregation/${t.img}.svg`} alt={`How ${t.label.toLowerCase()} works`}
                     width="1264" height="562" loading="lazy" decoding="async" />
              </picture>
              <p class="ds-panel-lede">{t.lede}</p>
              <a class="ds-panel-link" href={`#${t.id}`}>{t.link}</a>
            </div>
          ))}
        </div>
      </div>
    </div>

    <section class="container-mb ds-compare">
      <h2 class="ds-compare-h">Compare</h2>
      <div class="ds-grid" role="table" aria-label="Comparison of data segregation methods">
        <div class="ds-row ds-row--head" role="row">
          <div class="ds-cell ds-cell--name" role="columnheader"><span class="sr-only">Method</span></div>
          {columns.map((c) => <div class="ds-cell" role="columnheader"><b>{c}</b></div>)}
        </div>
        {rows.map((r) => (
          <div class="ds-row" role="row">
            <div class="ds-cell ds-cell--name" role="rowheader">
              <b>{r.name}</b>
              {r.sub && <p class="ds-sub">{r.sub}</p>}
            </div>
            <div class="ds-cell" role="cell"><p>{r.mean}</p></div>
            <div class="ds-cell" role="cell"><ul>{r.when.map((x) => <li>{x}</li>)}</ul></div>
            <div class="ds-cell" role="cell"><p>{r.example}</p></div>
            <div class="ds-cell" role="cell"><ul>{r.tradeoffs.map((x) => <li>{x}</li>)}</ul></div>
          </div>
        ))}
      </div>
    </section>

    <section class="ds-final">
      <div class="container-mb">
        <h2 class="ds-final-h">Try Metabase free for 14 days</h2>
        <p class="ds-final-p">
          Keep sensitive, or simply irrelevant, data under wraps. Sandboxing and the rest of
          these methods are available on Pro and Enterprise plans, and you can try either
          without talking to anyone first.
        </p>
        <a href="/start" class="ds-final-btn">Get started</a>
      </div>
    </section>
  </div>
</BaseLayout>
