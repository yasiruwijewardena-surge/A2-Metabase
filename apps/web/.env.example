# Strapi REST API base URL (no trailing slash)
STRAPI_URL=http://localhost:1337

# Public URL of this site, used for canonical links and the sitemap
SITE_URL=http://localhost:4321

# On Railway these are set as service variables. Note that Astro reads
# STRAPI_URL at BUILD time, and Railway's private network is not available
# during builds, so this must be the public Strapi URL rather than
# *.railway.internal.
